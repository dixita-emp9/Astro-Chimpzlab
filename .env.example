# ===========================================================================
# ChimpzLab / Astro site — environment variables
#
# Copy this file to `.env` and adjust values. All values below are optional:
# the site ships with production defaults, so it builds and runs without a
# `.env` file. Only set a variable when you need to override the default.
#
# Variables prefixed with PUBLIC_ are inlined at build time and ARE visible in
# the browser (they only hold non-secret, client-safe values).
# ---------------------------------------------------------------------------
# SECRETS (server-side only) must NOT use the PUBLIC_ prefix and must never be
# added to Astro config — they belong in `public/crm/.env` (gitignored),
# where the PHP endpoints read them.
# ===========================================================================

# --- Site identity ----------------------------------------------------------
PUBLIC_SITE_NAME=ChimpzLab
PUBLIC_SITE_URL=https://chimpzlab.com
PUBLIC_SITE_TAGLINE=Digital Marketing Agency in Thane

# --- Contact details --------------------------------------------------------
PUBLIC_SITE_EMAIL=hello@chimpzlab.com
PUBLIC_SITE_PHONE=+91 74157 41562
PUBLIC_SITE_PHONE_HREF=+917415741562
PUBLIC_SITE_ADDRESS=408, Fenkin 9 Phase 1, Wagle Estate, Behind Satkar Grande Hotel, Thane West 400604

# --- Social profiles --------------------------------------------------------
PUBLIC_SITE_YOUTUBE=https://youtube.com/@chimpzlab
PUBLIC_SITE_LINKEDIN=https://linkedin.com/company/chimpzlab
PUBLIC_SITE_INSTAGRAM=https://instagram.com/chimpzlab

# --- Analytics --------------------------------------------------------------
PUBLIC_GTM_ID=GTM-MVP2NQBM

# --- Brand assets -----------------------------------------------------------
PUBLIC_SITE_LOGO_HEADER=/asset/chimpzlab-white.png
PUBLIC_SITE_LOGO_FOOTER=/asset/chimpzlab-footer.png
PUBLIC_SITE_LOGO_ANIMATED=/asset/chimpzlab-white-logo.gif
PUBLIC_SITE_OG_IMAGE=/asset/favicon-512.png

# --- Maps embed (Footer location modal) -------------------------------------
PUBLIC_SITE_MAPS_EMBED=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3768.175249159286!2d72.95386549999999!3d19.187546499999996!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x3be7b9266a88bf85%3A0x71ba663ff0265751!2sChimpzLab%20-%20A%20Digital%20Experiences%20Company!5e0!3m2!1sen!2sin!4v1785755973300!5m2!1sen!2sin

# --- Lead-capture CRM (public site key + form endpoints) ---------------------
PUBLIC_CRM_API_KEY=3afc0840e1193e58397159d4af15cf4a15b5b35c
PUBLIC_FORM_ENDPOINT=/lead-capture.php
PUBLIC_REAL_ESTATE_ENDPOINT=/real-estate-lead.php
PUBLIC_FORM_REDIRECT=/thanks

# --- Google reCAPTCHA (public site keys only) --------------------------------
# The matching SECRET keys are read by the PHP handlers from public/crm/.env:
#   RECAPTCHA_SECRET_KEY=your-v3-or-v2-secret
#   RECAPTCHA_SECRET_KEY_TEST=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe
PUBLIC_RECAPTCHA_SITE_KEY=6Ld5s24tAAAAABcGfuai8DbOmn6JAS9kARQonH1h
PUBLIC_RECAPTCHA_TEST_SITE_KEY=6LeIxAcTAAAAAJcZVRqyHh71UMIEGNQ_MXjiZKhI
