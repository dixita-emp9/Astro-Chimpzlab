---
// Contact / booking form section. `otp` renders the phone-verification variant,
// `hidden` keeps the section hidden on the page (currently only used by the OTP
// variant, matching the reference site).

interface Props {
    otp?: boolean;
    hidden?: boolean;
}

const { otp = false, hidden = false } = Astro.props;

const sectionId = otp ? 'booking-form-otp' : 'booking-form';
const formId = otp ? 'contactFormOtp' : 'contactForm';
const hiddenClass = hidden ? ' d-none' : '';
---
<section class={"py-16 md:py-24 px-6 md:px-12 bg-white text-brand-dark" + hiddenClass} id={sectionId}>
    <div class="max-w-[1400px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start">

            <!-- Left Side: Copy -->
            <div class="gsap-reveal">
                <h2 class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-6">Ready to get started?</h2>
                <p class="text-xl text-gray-600 mb-12 max-w-lg">Submit your inquiry and our team will get back to
                    you within 24 hours.</p>

                <div class="space-y-8 max-w-md">
                    <!-- Item -->
                    <div class="flex gap-4 items-start">
                        <div
                            class="shrink-0 w-6 h-6 rounded-full border-2 border-brand-dark flex items-center justify-center mt-1">
                            <svg class="w-3.5 h-3.5 text-brand-dark" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-brand-dark mb-1">Reputation Strategy</h4>
                            <p class="text-gray-600 text-sm">Expert guidance on your brand's market narrative.</p>
                        </div>
                    </div>
                    <!-- Item -->
                    <div class="flex gap-4 items-start">
                        <div
                            class="shrink-0 w-6 h-6 rounded-full border-2 border-brand-dark flex items-center justify-center mt-1">
                            <svg class="w-3.5 h-3.5 text-brand-dark" fill="none" stroke="currentColor"
                                viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                    d="M5 13l4 4L19 7"></path>
                            </svg>
                        </div>
                        <div>
                            <h4 class="text-lg font-bold text-brand-dark mb-1">Stakeholder Mapping</h4>
                            <p class="text-gray-600 text-sm">Deep analysis of who matters to your business.</p>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Right Side: Light Form Container -->
            <div class="bg-gray-50 border border-gray-200 rounded-2xl p-8 md:p-12 shadow-xl gsap-reveal">
                <form id={formId} class="space-y-6" method="POST" action="/lead-capture.php">
                    <!-- Top Row Fields -->
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div>
                            <input type="text" name="name" placeholder="Your Name *" minlength="2" maxlength="100"
                                pattern="[A-Za-zÀ-ÿ\s\.\-']+"
                                title="Please enter a valid name (letters, spaces, hyphens only)"
                                class="w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors"
                                required>
                            <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter your full name.</p>
                        </div>
                        <div>
                            <input type="email" name="email" placeholder="Email *" maxlength="254"
                                pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                                title="Please enter a valid email address"
                                class="w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors"
                                required>
                            <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid email
                                address.</p>
                        </div>
                    </div>

                    {
                        otp ? (
                            <div id="phoneField">
                                <div class="flex gap-3">
                                    <input type="tel" name="phone" id="phone" placeholder="Phone *" minlength="10"
                                        maxlength="15" pattern="[0-9]{10,15}" inputmode="numeric"
                                        title="Please enter a valid phone number (10-15 digits)"
                                        class="flex-1 w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors"
                                        required>
                                    <button type="button" id="sendOtpBtn"
                                        class="shrink-0 bg-brand-dark hover:bg-black text-white px-5 py-4 rounded-xl text-sm font-bold transition-all duration-300 whitespace-nowrap">
                                        Send OTP
                                    </button>
                                </div>
                                <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid phone number
                                    (min 10 digits).</p>

                                <div id="otpSection" class="hidden mt-4">
                                    <div class="flex gap-3">
                                        <input type="text" id="otpInput" placeholder="Enter 6-digit OTP" maxlength="6"
                                            inputmode="numeric" pattern="[0-9]{6}"
                                            class="flex-1 w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors">
                                        <button type="button" id="verifyOtpBtn"
                                            class="shrink-0 bg-green-600 hover:bg-green-700 text-white px-5 py-4 rounded-xl text-sm font-bold transition-all duration-300 whitespace-nowrap">
                                            Verify OTP
                                        </button>
                                    </div>
                                    <p id="otpError" class="text-red-500 text-xs mt-1 hidden"></p>
                                </div>

                                <div id="phoneVerified"
                                    class="hidden mt-3 flex items-center gap-2 text-green-600 font-semibold text-sm">
                                    <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                            d="M5 13l4 4L19 7"></path>
                                    </svg>
                                    Phone Verified
                                </div>

                                <div id="recaptchaContainer"></div>
                            </div>
                        ) : (
                            <div>
                                <input type="tel" name="phone" placeholder="Phone *" minlength="10" maxlength="15"
                                    pattern="[0-9]{10,15}" inputmode="numeric"
                                    title="Please enter a valid phone number (10-15 digits)"
                                    class="w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors"
                                    required>
                                <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid phone number
                                    (min 10 digits).</p>
                            </div>
                        )
                    }

                    <!-- Textarea -->
                    <div>
                        <textarea name="message" placeholder="Tell us about your project *" rows="4" minlength="10"
                            maxlength="2000"
                            class="w-full bg-white border border-gray-300 rounded-xl px-5 py-4 text-brand-dark placeholder-gray-500 focus:outline-none focus:border-brand-dark transition-colors resize-none"
                            required></textarea>
                        <p class="error-msg text-red-500 text-xs mt-1 hidden">Message must be at least 10
                            characters.</p>
                    </div>

                    <!-- Honeypot: invisible to humans, bots love it -->
                    <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
                        <label>Leave this blank</label>
                        <input type="text" name="_hp" tabindex="-1" autocomplete="off">
                    </div>

                    {
                        !otp && (
                            <div class="pt-2">
                                <div class="g-recaptcha"
                                    data-sitekey="6Ld5s24tAAAAABcGfuai8DbOmn6JAS9kARQonH1h"></div>
                                <p id="recaptchaError" class="error-msg text-red-500 text-xs mt-1 hidden">Please complete
                                    the CAPTCHA.</p>
                            </div>
                        )
                    }

                    <!-- Hidden fields -->
                    <input type="hidden" name="api_key" value="3afc0840e1193e58397159d4af15cf4a15b5b35c">
                    <input type="hidden" name="_redirect" value="thanks.html">

                    <!-- Submit Button -->
                    <div class="pt-6">
                        <button type="submit" id="submitBtn" disabled={otp ? true : undefined}
                            class={"interactive w-fit bg-brand-dark hover:bg-black text-white px-8 py-4 rounded-full text-sm font-bold tracking-wider transition-all duration-300 flex items-center gap-2" + (otp ? ' disabled:opacity-40 disabled:cursor-not-allowed' : '')}>
                            Send Message
                            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</section>
