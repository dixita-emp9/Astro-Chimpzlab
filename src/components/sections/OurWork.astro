---
// Our Work - case study slider (Swiper, initialised by GlobalScripts).

interface WorkItem {
    href: string;
    cover: string;
    tags: string;
    title: string;
}

const workItems: WorkItem[] = [
    { href: '/case-studies/ajmera-realty', cover: '/casestudy/ajmera-realty/cover.webp', tags: 'Brand Strategy, Brand Identity', title: 'Ajmera Realty & Infra India Ltd.' },
    { href: '/case-studies/blue-star', cover: '/casestudy/blue-star/cover.webp', tags: 'Brand Strategy', title: 'Blue Star India' },
    { href: '/case-studies/carnelian-capital', cover: '/casestudy/carnelian-capital/cover.webp', tags: 'Brand Strategy, Visual Content', title: 'Carnelian Capital' },
    { href: '/case-studies/cisco-thingqbator', cover: '/casestudy/cisco-thingqbator/cover.webp', tags: 'Brand Strategy, UX / UI Design, Web Development', title: 'Cisco thingQbator' },
    { href: '/case-studies/evershine-builders', cover: '/casestudy/evershine-builders/cover.webp', tags: 'Brand Strategy', title: 'Evershine Builders' },
    { href: '/case-studies/forest-hills', cover: '/casestudy/forest-hills/cover.webp', tags: 'Brand Strategy, Brand Identity', title: 'Forest Hills at Tala' },
    { href: '/case-studies/ghci-2024', cover: '/casestudy/ghci-2024/cover.webp', tags: 'Brand Strategy, Visual Content', title: 'Grace Hopper Celebration India 2024' },
    { href: '/case-studies/imbesharam', cover: '/casestudy/imbesharam/cover.webp', tags: 'Brand Strategy, Visual Content, Web Development', title: 'IMBesharam' },
    { href: '/case-studies/mos-world', cover: '/casestudy/mos-world/cover.webp', tags: 'Brand Strategy', title: 'MOS World' },
    { href: '/case-studies/munns-mars', cover: '/casestudy/munns-mars/cover.webp', tags: 'Brand Strategy, Visual Content', title: 'Munns & Mars' },
    { href: '/case-studies/nasscom-konnect', cover: '/casestudy/nasscom-konnect/cover.webp', tags: 'Brand Strategy, Visual Content', title: 'Nasscom Konnect' },
    { href: '/case-studies/nasscom-member-connect', cover: '/casestudy/nasscom-member-connect/cover.webp', tags: 'Brand Strategy', title: 'Nasscom Member Connect' },
    { href: '/case-studies/psiog', cover: '/casestudy/psiog/cover.webp', tags: 'Brand Identity, Visual Content', title: 'Psiog' },
    { href: '/case-studies/robust-petcare', cover: '/casestudy/robust-petcare/cover.webp', tags: 'Brand Identity, Brand Strategy', title: 'Robust Petcare' },
    { href: '/case-studies/stl-digital', cover: '/casestudy/stl-digital/cover.webp', tags: 'Brand Strategy, Visual Content, Web Development', title: 'STL Digital' },
    { href: '/case-studies/tiger-analytics', cover: '/casestudy/tiger-analytics/cover.webp', tags: 'Brand Strategy, AI Intelligence', title: 'Tiger Analytics' },
];
---
<section class="py-32 bg-white text-brand-dark overflow-hidden" id="work">
    <div class="max-w-[1400px] mx-auto px-6 md:px-12 mb-12">
        <div class="flex flex-col md:flex-row justify-between items-start md:items-end gap-8">
            <h2 class="text-5xl md:text-7xl font-extrabold tracking-tighter text-brand-dark">Our Work</h2>
            <a href="/case-studies"
                class="interactive border-2 border-brand-dark text-brand-dark hover:bg-brand-dark hover:text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 whitespace-nowrap">Explore
                more</a>
        </div>
    </div>

    <div class="max-w-[1400px] mx-auto px-6 md:px-12">
        <div class="swiper work-swiper">
            <div class="swiper-wrapper">
                {workItems.map((item) => (
                    <div class="swiper-slide">
                        <a href={item.href}
                            class="relative block w-full aspect-[4/3] md:aspect-[16/10] bg-black overflow-hidden group interactive rounded-2xl">
                            <img src={item.cover} loading="lazy" width="1200" alt={item.title}
                                class="absolute inset-0 w-full h-full object-cover opacity-80 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700">
                            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/30 to-black/10"></div>
                            <div
                                class="absolute top-5 left-5 md:top-8 md:left-8 z-10 text-[10px] md:text-xs font-semibold uppercase tracking-widest text-white/80">
                                {item.tags}</div>
                            <div class="absolute bottom-5 left-5 md:bottom-8 md:left-8 z-10 pr-6">
                                <h3 class="text-xl md:text-2xl font-bold text-white leading-tight">{item.title}</h3>
                            </div>
                        </a>
                    </div>
                ))}
            </div>

            <!-- Pagination -->
            <div class="swiper-pagination"></div>
        </div>
    </div>
</section>
