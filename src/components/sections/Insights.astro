---
// Insights - blog slider (Swiper, initialised by GlobalScripts).
// Renders SSR from the single source-of-truth article index (regenerated by
// scripts/build-insights.mjs), so there is no inline/mock data duplication.
import insightsData from "../../../public/insights/articles/index.json";

interface Article {
    slug: string;
    category: string;
    readTime?: string;
    titleParts?: string[];
    titleFull: string;
    intro?: string;
    image: string;
}

const articles = ((insightsData as { articles?: Article[] }).articles ||
    []) as Article[];

const featured: (Article & { cover: string; meta: string; excerpt: string })[] =
    articles.slice(0, 4).map((a) => {
        const cat = (a.category || "")
            .split("-")
            .map((w) => w.charAt(0).toUpperCase() + w.slice(1))
            .join(" ");
        return {
            ...a,
            cover: "/" + a.image,
            meta: `${cat}${a.readTime ? " • " + a.readTime : ""}`,
            excerpt: a.intro || "",
        };
    });
---

<section
    class="py-32 px-6 md:px-12 bg-[#0a0a0a] text-white border-t border-white/10 overflow-hidden"
    id="insights"
>
    <div class="max-w-[1400px] mx-auto">
        <!-- Header -->
        <div
            class="flex flex-col md:flex-row justify-between items-start md:items-end mb-16 gap-8 gsap-reveal"
        >
            <div class="max-w-2xl">
                <h2
                    class="text-5xl md:text-6xl font-extrabold tracking-tighter mb-4"
                >
                    Insights
                </h2>
                <p
                    class="text-gray-400 text-lg md:text-xl font-medium leading-relaxed"
                >
                    Thinking for a changing communications landscape. From
                    reputation and media visibility to AI search, stakeholder
                    engagement and brand trust.
                </p>
            </div>
            <a
                href="/insights"
                class="interactive border-2 border-white text-white hover:bg-white hover:text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 whitespace-nowrap"
                >Explore more</a
            >
        </div>

        <!-- Blog Swiper Slider -->
        <div class="swiper insights-swiper gsap-reveal">
            <div class="swiper-wrapper">
                {
                    featured.map((post) => (
                        <div class="swiper-slide h-auto">
                            <a
                                href={"/blog-insite?slug=" + post.slug}
                                class="group interactive block h-full"
                            >
                                <div class="w-full aspect-[4/3] overflow-hidden rounded-xl bg-[#111] mb-6 relative">
                                    <img
                                        src={post.cover}
                                        alt={post.titleFull}
                                        width="1920"
                                        height="1080"
                                        loading="lazy"
                                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 opacity-70 group-hover:opacity-100 group-hover:scale-105 transition-all duration-700"
                                    />
                                </div>
                                <div class="text-xs font-bold uppercase tracking-widest text-gray-500 mb-3">
                                    {post.meta}
                                </div>
                                <h3 class="text-2xl font-bold tracking-tight mb-3 group-hover:text-gray-300 transition-colors">
                                    {post.titleFull}
                                </h3>
                                <p class="text-gray-400 font-medium">
                                    {post.excerpt}
                                </p>
                            </a>
                        </div>
                    ))
                }
            </div>

            <!-- Swiper Pagination -->
            <div class="swiper-pagination mt-12 relative"></div>
        </div>
    </div>
</section>
