---
// What We Help You Do - pillars section. Kept hidden (d-none) to match the
// reference site, which shows this content in a different place.
---

<section
    class="py-32 px-6 md:px-12 border-t border-white/10 d-none"
    id="services"
>
    <div class="max-w-[1400px] mx-auto">
        <div class="mb-20">
            <span
                class="text-sm font-bold uppercase tracking-widest border-b border-white pb-2"
                >What We Help You Do</span
            >
        </div>

        <div
            class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-x-12 gap-y-20"
        >
            <!-- Pillar 1 -->
            <div class="fade-up">
                <div class="text-6xl font-black text-gray-800 mb-6">01</div>
                <h3 class="text-3xl font-bold mb-4">Build Reputation</h3>
                <p class="text-gray-400 leading-relaxed">
                    Strengthen credibility, leadership, and trust. We use PR,
                    corporate messaging, and investor relations to secure your
                    market position.
                </p>
            </div>
            <!-- Pillar 2 -->
            <div class="fade-up">
                <div class="text-6xl font-black text-gray-800 mb-6">02</div>
                <h3 class="text-3xl font-bold mb-4">Grow Visibility</h3>
                <p class="text-gray-400 leading-relaxed">
                    Command attention where it matters. We optimize your
                    presence across search, social, media, and AI-led answer
                    engines.
                </p>
            </div>
            <!-- Pillar 3 -->
            <div class="fade-up">
                <div class="text-6xl font-black text-gray-800 mb-6">03</div>
                <h3 class="text-3xl font-bold mb-4">
                    Build Digital Experiences
                </h3>
                <p class="text-gray-400 leading-relaxed">
                    Design intuitive websites, multilingual journeys, and AI
                    tools. We make your brand effortless to access and navigate.
                </p>
            </div>
            <!-- Pillar 4 -->
            <div class="fade-up">
                <div class="text-6xl font-black text-gray-800 mb-6">04</div>
                <h3 class="text-3xl font-bold mb-4">Create Engagement</h3>
                <p class="text-gray-400 leading-relaxed">
                    Turn passive audiences into active participants. We craft
                    resonant brand stories that forge genuine connections.
                </p>
            </div>
            <!-- Pillar 5 -->
            <div class="fade-up">
                <div class="text-6xl font-black text-gray-800 mb-6">05</div>
                <h3 class="text-3xl font-bold mb-4">Convert Attention</h3>
                <p class="text-gray-400 leading-relaxed">
                    Scale your pipeline. We deploy performance marketing and
                    automation to turn engagement into measurable demand.
                </p>
            </div>
        </div>
    </div>
</section>
