---
// Stats strip with animated number counters.
---

<section class="py-20 px-6 md:px-12 bg-[#111111] border-t border-white/5">
    <div class="max-w-[1400px] mx-auto">
        <div
            class="grid grid-cols-1 md:grid-cols-3 gap-12 divide-y md:divide-y-0 md:divide-x divide-white/10"
        >
            <div class="gsap-reveal md:px-8 first:px-0 pt-8 md:pt-0">
                <div
                    class="text-5xl md:text-4xl lg:text-6xl font-extrabold mb-4 text-white tracking-tighter"
                >
                    <span class="counter-value" data-target="10">0</span>+ years
                </div>
                <p
                    class="text-gray-400 font-medium text-lg leading-relaxed uppercase tracking-wide text-sm"
                >
                    - building brand reputation since 2016
                </p>
            </div>
            <div class="gsap-reveal md:px-8 pt-8 md:pt-0">
                <div
                    class="text-5xl md:text-4xl lg:text-6xl font-extrabold mb-4 text-white tracking-tighter"
                >
                    <span class="counter-value" data-target="60">0</span>+
                    brands
                </div>
                <p
                    class="text-gray-400 font-medium text-lg leading-relaxed uppercase tracking-wide text-sm"
                >
                    - across technology, BFSI, healthcare and more
                </p>
            </div>
            <div class="gsap-reveal md:px-8 pt-8 md:pt-0">
                <div
                    class="text-5xl md:text-4xl lg:text-6xl font-extrabold mb-4 text-white tracking-tighter"
                >
                    <span class="counter-value" data-target="12">0</span> industries
                </div>
                <p
                    class="text-gray-400 font-medium text-lg leading-relaxed uppercase tracking-wide text-sm"
                >
                    - served with sector-specific communication strategy
                </p>
            </div>
        </div>
    </div>
</section>
