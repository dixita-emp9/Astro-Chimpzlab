---
// Contact / booking form section. `otp` renders the phone-verification variant,
// `hidden` keeps the section hidden on the page (currently only used by the OTP
// variant, matching the reference site). `theme` controls the light/dark styling
// of the section and the right-side form.
//
// Left-side copy is supplied per page via the `left` slot. Home is the default
// (light) copy, so Home.astro can render <HomePageForm /> without a slot.
import ContactForm from './ContactForm.astro';

interface Props {
    otp?: boolean;
    hidden?: boolean;
    theme?: 'light' | 'dark';
}

const { otp = false, hidden = false, theme = 'light' } = Astro.props;

const sectionId = otp ? 'booking-form-otp' : 'booking-form';
const hiddenClass = hidden ? ' d-none' : '';
const dark = theme === 'dark';

const sectionCls = dark
    ? 'py-16 md:py-24 px-6 md:px-12 bg-brand-dark text-white' + hiddenClass
    : 'py-16 md:py-24 px-6 md:px-12 bg-white text-brand-dark' + hiddenClass;
---

<section class={sectionCls} id={sectionId}>
    <div class="max-w-[1400px] mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-center">

            <!-- Left Side: Copy (page-specific) -->
            <div class="gsap-reveal">
                <slot name="left">
                    <!-- Default Home page copy (light) -->
                    <h2 class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-6">Ready to get started?</h2>
                    <p class="text-xl text-gray-600 mb-12 max-w-lg">Submit your inquiry and our team will get back to
                        you within 24 hours.</p>

                    <div class="space-y-8 max-w-md">
                        <!-- Item -->
                        <div class="flex gap-4 items-start">
                            <div
                                class="shrink-0 w-6 h-6 rounded-full border-2 border-brand-dark flex items-center justify-center mt-1">
                                <svg class="w-3.5 h-3.5 text-brand-dark" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-brand-dark mb-1">Reputation Strategy</h4>
                                <p class="text-gray-600 text-sm">Expert guidance on your brand's market narrative.</p>
                            </div>
                        </div>
                        <!-- Item -->
                        <div class="flex gap-4 items-start">
                            <div
                                class="shrink-0 w-6 h-6 rounded-full border-2 border-brand-dark flex items-center justify-center mt-1">
                                <svg class="w-3.5 h-3.5 text-brand-dark" fill="none" stroke="currentColor"
                                    viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-brand-dark mb-1">Stakeholder Mapping</h4>
                                <p class="text-gray-600 text-sm">Deep analysis of who matters to your business.</p>
                            </div>
                        </div>
                    </div>
                </slot>
            </div>

            <!-- Right Side: Shared Form (light/dark) -->
            <ContactForm theme={theme} />
        </div>
    </div>
</section>
