---
const { activeNav = "" } = Astro.props;
const linkClass = (nav: string) =>
    `interactive text-sm transition-colors ${nav === activeNav ? "text-white font-bold" : "text-gray-300 hover:text-white font-medium"}`;
---

<nav
    class="fixed w-full top-0 z-50 px-6 md:px-12 py-6 flex justify-between items-center pointer-events-none backdrop-blur-md"
    style="background: linear-gradient(180deg, #000000cf, transparent);"
>
    <!-- Logo -->
    <a
        href="/"
        class="pointer-events-auto interactive z-10 flex items-center gap-2"
        aria-label="Home"
    >
        <img
            src="/asset/chimpzlab-white.png"
            alt="ChimpzLab"
            class="h-7 md:h-9 object-contain"
            onerror="this.style.display='none'; document.getElementById('text-logo').style.display='block';"
        />
        <span
            id="text-logo"
            class="hidden text-white font-extrabold text-2xl md:text-3xl tracking-tighter"
            >CHIMPZLAB</span
        >
    </a>

    <!-- Desktop Centered Menu -->
    <div
        class="pointer-events-auto hidden min-[992px]:flex absolute left-1/2 -translate-x-1/2 z-10"
    >
        <div class="nav-pill px-6 py-3 rounded-full flex items-center gap-8">
            <div class="has-dropdown">
                <a
                    href="/services"
                    class="interactive text-gray-300 hover:text-white font-medium text-sm transition-colors flex items-center gap-1"
                >
                    Services
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2"
                            d="M19 9l-7 7-7-7"
                        >
                        </path>
                    </svg>
                </a>
                <div class="mega-menu">
                    <div class="mega-menu-grid">
                        <a
                            href="/services/reputation-communications"
                            class="service-card-mini"
                        >
                            <div class="icon">
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                                    ></path>
                                </svg>
                            </div>
                            <span class="card-title"
                                >Reputation &<br />Communications</span
                            >
                        </a>
                        <a
                            href="/services/visibility-search"
                            class="service-card-mini"
                        >
                            <div class="icon">
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"
                                    ></path>
                                </svg>
                            </div>
                            <span class="card-title"
                                >Visibility &<br />Search</span
                            >
                        </a>
                        <a href="/services/creative" class="service-card-mini">
                            <div class="icon">
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z"
                                    ></path>
                                </svg>
                            </div>
                            <span class="card-title">Creative</span>
                        </a>
                        <a
                            href="/services/demand-generation"
                            class="service-card-mini"
                        >
                            <div class="icon">
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                                </svg>
                            </div>
                            <span class="card-title"
                                >Demand <br />Generation</span
                            >
                        </a>
                        <a
                            href="/services/digital-experiences"
                            class="service-card-mini"
                        >
                            <div class="icon">
                                <svg
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="2"
                                        d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                                    ></path>
                                </svg>
                            </div>
                            <span class="card-title"
                                >Digital<br />Experiences</span
                            >
                        </a>
                    </div>
                </div>
            </div>
            <a
                href="/case-studies"
                class={`interactive text-sm transition-colors ${activeNav === "work" ? "text-white font-bold" : "text-gray-300 hover:text-white font-medium"}`}
                >Work</a
            >
            <a href="/about" class={linkClass("about")}>About</a>
            <a
                href="/insights"
                class={`interactive text-sm transition-colors ${activeNav === "insights" ? "text-white font-bold" : "text-gray-300 hover:text-white font-medium"}`}
                >Insights</a
            >
        </div>
    </div>

    <!-- Right: CTA + Mobile -->
    <div class="flex items-center gap-4 z-10">
        <div class="pointer-events-auto hidden min-[992px]:flex">
            <a
                href="/booking-form"
                class="interactive bg-white hover:bg-gray-200 text-black px-7 py-3 rounded-full text-sm font-bold tracking-wide transition-all duration-300 transform hover:scale-105 shadow-[0_0_20px_rgba(255,255,255,0.15)]"
            >
                Let's Connect
            </a>
        </div>
        <!-- Mobile Menu Button -->
        <button
            aria-label="Open menu"
            class="pointer-events-auto min-[992px]:hidden text-white interactive p-2 z-10"
        >
            <svg
                class="w-8 h-8"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M4 6h16M4 12h16M4 18h16"
                >
                </path>
            </svg>
        </button>
    </div>
</nav>
