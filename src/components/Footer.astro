---
import CurrentYear from "./CurrentYear.tsx";
import { site } from "../config/site";

const { socials } = site;
---

<footer class="footer-v2">
    <div class="footer-inner">
        <div class="footer-grid">
            <div class="footer-col-brand">
                <img
                    src={site.logo.animated}
                    alt={site.name}
                    width="1000"
                    height="785"
                    class="footer-logo-mark interactive"
                    onerror="this.style.display='none'"
                />

                <div class="footer-block">
                    <h5 class="footer-label">Location</h5>
                    <a
                        href="#"
                        id="location-link"
                        class="interactive footer-address text-gray-400 hover:text-white transition-colors"
                        >{site.addressLines}</a
                    >
                </div>

                <!-- Map Popup Modal -->
                <div
                    id="map-modal"
                    class="fixed inset-0 z-50 flex items-center justify-center bg-black/80 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300"
                >
                    <div
                        class="relative w-full max-w-3xl mx-4 bg-[#111] border border-white/10 rounded-2xl overflow-hidden shadow-2xl transform scale-95 transition-transform duration-300"
                        id="map-modal-content"
                    >
                        <!-- Close Button -->
                        <button
                            id="close-map-modal"
                            aria-label="Close map"
                            class="absolute top-4 right-4 z-10 w-10 h-10 bg-black/60 hover:bg-black text-white rounded-full flex items-center justify-center transition-colors"
                        >
                            <svg
                                class="w-5 h-5"
                                fill="none"
                                stroke="currentColor"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    stroke-width="2"
                                    d="M6 18L18 6M6 6l12 12"></path>
                            </svg>
                        </button>
                        <!-- Modal Header -->
                        <div class="p-6 border-b border-white/10">
                            <h3 class="text-xl font-bold text-white">
                                Our Location
                            </h3>
                        </div>
                        <!-- Google Map Iframe -->
                        <div class="w-full h-[400px] bg-[#222]">
                            <iframe
                                title={`${site.name} location on Google Maps`}
                                src={site.mapsEmbedUrl}
                                width="100%"
                                height="100%"
                                style="border:0;"
                                allowfullscreen=""
                                loading="lazy"
                                referrerpolicy="strict-origin-when-cross-origin"
                            ></iframe>
                        </div>
                    </div>
                </div>

                <div
                    class="flex flex-col justify-center md:justify-start sm:flex-row flex-wrap gap-5 gap-y-1"
                >
                    <div class="footer-block">
                        <h5 class="footer-label">Email</h5>
                        <a
                            href={"mailto:" + site.email}
                            class="interactive footer-address"
                        >
                            {site.email}
                        </a>
                    </div>

                    <div class="footer-block">
                        <h5 class="footer-label">Contact</h5>
                        <a
                            href={"tel:" + site.phoneHref}
                            class="interactive footer-address"
                        >
                            {site.phoneDisplay}
                        </a>
                    </div>
                </div>

                <div class="footer-block">
                    <h5 class="footer-label">Social</h5>
                    <div class="footer-social-btns">
                        <a
                            href={socials.youtube}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="interactive">YouTube</a
                        >
                        <a
                            href={socials.linkedin}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="interactive">LinkedIn</a
                        >
                        <a
                            href={socials.instagram}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="interactive">Instagram</a
                        >
                    </div>
                </div>
            </div>

            <div class="footer-group">
                <span class="footer-group-title">Company</span>
                <ul>
                    <li><a href="/" class="interactive">Home</a></li>
                    <li><a href="/about" class="interactive">About</a></li>
                    <li>
                        <a href="/case-studies" class="interactive">Work</a>
                    </li>
                    <li>
                        <a href="/insights" class="interactive">Insights</a>
                    </li>
                </ul>
            </div>

            <div class="footer-group">
                <a
                    href="/services/reputation-communications"
                    class="footer-group-title"
                    >Reputation &amp; Communications</a
                >
                <ul>
                    <li>
                        <a
                            href="/services/reputation-communications/corporate-communications-agency-in-thane"
                            class="interactive">Corporate Communications</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/reputation-communications/public-relations-agency-in-thane"
                            class="interactive">Public Relations</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/reputation-communications/thought-leadership-agency-in-thane"
                            class="interactive">Thought Leadership</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/reputation-communications/employer-branding-agency-in-thane"
                            class="interactive">Employer Branding</a
                        >
                    </li>
                </ul>
            </div>

            <div class="footer-group">
                <a href="/services/visibility-search" class="footer-group-title"
                    >Visibility &amp; Search</a
                >
                <ul>
                    <li>
                        <a
                            href="/services/visibility-search/social-media-marketing-agency-in-thane"
                            class="interactive">Social Media Marketing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/visibility-search/seo-aeo-agency-in-thane"
                            class="interactive">SEO / AEO</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/visibility-search/content-writing-services-in-thane"
                            class="interactive">Content Writing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/visibility-search/influencer-marketing-agency-in-thane"
                            class="interactive">Influencer Marketing</a
                        >
                    </li>
                </ul>
            </div>

            <div class="footer-group">
                <a href="/services/creative" class="footer-group-title"
                    >Creative</a
                >
                <ul>
                    <li>
                        <a
                            href="/services/creative/branding-agency-in-thane"
                            class="interactive">Branding</a
                        >
                    </li>
                    <li>
                        <a href="/services/creative/design" class="interactive"
                            >Design</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/creative/video-production-services-in-thane"
                            class="interactive">Video Production</a
                        >
                    </li>
                </ul>
            </div>

            <div class="footer-group">
                <a href="/services/demand-generation" class="footer-group-title"
                    >Demand Generation</a
                >
                <ul>
                    <li>
                        <a
                            href="/services/demand-generation/performance-marketing-agency-in-thane"
                            class="interactive">Performance Marketing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/demand-generation/email-marketing-services-in-thane"
                            class="interactive">Email Marketing</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/demand-generation/vetted-lead-generation-services-in-thane"
                            class="interactive">Vetted Lead Generation</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/demand-generation/marketing-automation-services-in-thane"
                            class="interactive">Marketing Automation</a
                        >
                    </li>
                </ul>
            </div>

            <div class="footer-group">
                <a
                    href="/services/digital-experiences"
                    class="footer-group-title">Digital Experiences</a
                >
                <ul>
                    <li>
                        <a
                            href="/services/digital-experiences/website-design-development-services-in-thane"
                            class="interactive">Web Design &amp; Development</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/digital-experiences/landing-page-services-in-thane"
                            class="interactive">Landing Pages</a
                        >
                    </li>
                    <li>
                        <a
                            href="/services/digital-experiences/chatbot-development-services-in-thane"
                            class="interactive"
                            >Chatbot &amp; Virtual Assistant</a
                        >
                    </li>
                </ul>
            </div>
        </div>

        <div class="footer-logo-end">
            <img
                src={site.logo.footer}
                alt={site.name}
                width="1312"
                height="197"
                class="footer-end-logo interactive"
            />

            <div
                class="footer-bottom flex md:flex-row items-center justify-between gap-4"
            >
                <p>&copy; <CurrentYear /> {site.name}. All rights reserved.</p>
                <a
                    href="/privacy-policy"
                    class="text-gray-400 hover:text-white transition-colors text-sm interactive"
                    >Privacy Policy</a
                >
            </div>
        </div>
    </div>
</footer>
