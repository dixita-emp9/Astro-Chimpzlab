---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Blog Upload | ChimpzLab"
    description="Internal tool: upload a .docx file to create WordPress blog drafts."
    canonical="/blog-upload"
    hideHeader={true}
    hideFooter={true}
    loadAnimations={false}
    bodyClass="bg-[#0a0a0a] min-h-screen text-white"
>
    <Fragment slot="head">
        <meta name="robots" content="noindex, nofollow" />
        <script is:inline src="/js/mammoth.browser.min.js"></script>
        <style is:inline>
            .page-glow {
                background:
                    radial-gradient(900px 340px at 50% -120px, rgba(255,255,255,.08), transparent 70%),
                    radial-gradient(700px 500px at 90% 110%, rgba(255,255,255,.04), transparent 70%);
            }
            .bg-grid {
                background-image:
                    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
                    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
                background-size: 44px 44px;
                mask-image: radial-gradient(ellipse 90% 60% at 50% 0%, black 30%, transparent 75%);
            }
            .preview-scroll::-webkit-scrollbar { width: 6px; }
            .preview-scroll::-webkit-scrollbar-thumb { background: rgba(255,255,255,.15); border-radius: 3px; }
            .drop-active {
                border-color: #fff !important;
                background: rgba(255,255,255,.07) !important;
                transform: scale(1.01);
            }
            select.cat-select option { background: #111; color: #fff; }
            .preview-render a { color: #7dd3fc; text-decoration: underline; }
            .preview-render h2 { font-weight: 800; margin: 12px 0 6px; font-size: 14px; text-transform: uppercase; letter-spacing: .02em; }
            .preview-render h3 { font-weight: 700; margin: 10px 0 4px; font-size: 13px; }
            .preview-render p { margin-bottom: 8px; }
            .step-dot { width: 26px; height: 26px; border-radius: 9999px; display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 800; flex-shrink: 0; transition: all .3s ease; }
            .step-todo { background: rgba(255,255,255,.06); color: rgba(255,255,255,.35); border: 1px solid rgba(255,255,255,.12); }
            .step-now { background: #fff; color: #000; box-shadow: 0 0 24px rgba(255,255,255,.35); }
            .step-done { background: #10b981; color: #04120c; border: 1px solid #10b981; }
            @keyframes rise {
                from { opacity: 0; transform: translateY(14px); }
                to { opacity: 1; transform: translateY(0); }
            }
            .rise { animation: rise .45s cubic-bezier(.22,.8,.32,1) both; }
            @keyframes pulse-soft {
                0%, 100% { opacity: 1; }
                50% { opacity: .45; }
            }
            .sending { animation: pulse-soft 1.2s ease-in-out infinite; }
            .card-hover { transition: transform .2s ease, border-color .2s ease, box-shadow .2s ease; }
            .card-hover:hover { border-color: rgba(255,255,255,.22); box-shadow: 0 14px 34px -18px rgba(0,0,0,.8); }
            .btn-press:active { transform: scale(.97); }
            .chev { transition: transform .25s ease; }
            .open .chev { transform: rotate(180deg); }
            .clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
        </style>
    </Fragment>

    <div class="page-glow min-h-screen relative">
        <div class="bg-grid absolute inset-0 pointer-events-none"></div>
        <div class="relative w-full max-w-6xl mx-auto px-4 md:px-8 py-6 md:py-10">

            <!-- Header -->
            <header class="flex items-center justify-between gap-4 mb-6 rise">
                <div>
                    <div class="inline-flex items-center gap-2 text-[11px] font-bold uppercase tracking-[0.3em] text-white/40 mb-1.5">
                        <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 inline-block"></span>
                        ChimpzLab Internal
                    </div>
                    <h1 class="text-2xl md:text-4xl font-extrabold tracking-tighter">Blog Upload</h1>
                    <p class="text-white/50 text-sm mt-1">From .docx to WordPress drafts — same structure, zero manual formatting.</p>
                </div>
                <button
                    id="btn-logout"
                    class="hidden shrink-0 text-xs font-bold text-white/50 hover:text-white border border-white/15 hover:border-white/40 px-4 py-2 rounded-full transition-colors btn-press"
                    >Log out</button
                >
            </header>

            <!-- Steps -->
            <ol id="steps" class="flex flex-wrap items-center gap-x-2 gap-y-2 mb-6 text-xs font-bold rise" style="animation-delay:.06s">
                <li class="flex items-center gap-2" data-step="1"><span class="step-dot step-todo">1</span><span class="text-white/60">Login</span></li>
                <li class="text-white/20">→</li>
                <li class="flex items-center gap-2" data-step="2"><span class="step-dot step-todo">2</span><span class="text-white/60">Upload .docx</span></li>
                <li class="text-white/20">→</li>
                <li class="flex items-center gap-2" data-step="3"><span class="step-dot step-todo">3</span><span class="text-white/60">Review</span></li>
                <li class="text-white/20">→</li>
                <li class="flex items-center gap-2" data-step="4"><span class="step-dot step-todo">4</span><span class="text-white/60">Send to WordPress</span></li>
            </ol>

            <!-- Global message -->
            <div id="notice" class="hidden mb-5 px-5 py-3 rounded-xl border text-sm rise"></div>

            <!-- Undo bar -->
            <div id="undo-bar" class="hidden mb-5 px-5 py-3 rounded-xl border border-white/15 bg-white/[0.05] text-sm flex items-center justify-between gap-3 rise">
                <span id="undo-text" class="text-white/70"></span>
                <button id="btn-undo" class="shrink-0 text-xs font-extrabold bg-white text-black px-4 py-2 rounded-full hover:bg-white/85 transition-colors btn-press">Undo</button>
            </div>

            <!-- STEP 1: Login -->
            <section id="view-login" class="hidden max-w-md mx-auto">
                <div class="rounded-3xl border border-white/10 bg-white/[0.03] backdrop-blur p-6 md:p-7 shadow-2xl rise" style="animation-delay:.1s">
                    <div class="w-11 h-11 rounded-2xl bg-white text-black flex items-center justify-center mb-4">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 10-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 002.25-2.25v-6.75a2.25 2.25 0 00-2.25-2.25H6.75a2.25 2.25 0 00-2.25 2.25v6.75a2.25 2.25 0 002.25 2.25z"></path>
                        </svg>
                    </div>
                    <h2 class="text-xl font-extrabold tracking-tight mb-1">Welcome back</h2>
                    <p class="text-white/50 text-sm mb-5">Please log in with your password to continue.</p>
                    <form id="login-form" class="flex flex-col gap-3">
                        <input
                            id="login-username"
                            type="text"
                            placeholder="Username"
                            autocomplete="username"
                            spellcheck="false"
                            class="w-full bg-white/5 border border-white/15 rounded-xl px-4 py-3 text-sm placeholder:text-white/30 focus:outline-none focus:border-white/60 focus:bg-white/[0.07] transition-colors"
                        />
                        <div class="relative">
                            <input
                                id="login-password"
                                type="password"
                                placeholder="Enter password…"
                                autocomplete="current-password"
                                class="w-full bg-white/5 border border-white/15 rounded-xl pl-4 pr-16 py-3 text-sm placeholder:text-white/30 focus:outline-none focus:border-white/60 focus:bg-white/[0.07] transition-colors"
                            />
                            <button
                                type="button"
                                id="toggle-pw"
                                class="absolute right-2 top-1/2 -translate-y-1/2 text-xs font-bold text-white/50 hover:text-white px-3 py-1.5 rounded-full transition-colors"
                                >Show</button
                            >
                        </div>
                        <button
                            type="submit"
                            class="bg-white text-black font-bold text-sm px-6 py-3 rounded-xl hover:bg-white/85 transition-colors btn-press"
                            >Login →</button
                        >
                    </form>
                    <p class="text-white/30 text-xs mt-4 text-center">Session stays active for 7 days on this device.</p>
                </div>
            </section>

            <!-- STEP 2: Upload -->
            <section id="view-upload" class="hidden max-w-2xl mx-auto">
                <div
                    id="dropzone"
                    class="rise border-2 border-dashed border-white/20 rounded-3xl p-8 md:p-12 text-center cursor-pointer transition-all duration-300 hover:border-white/50 hover:bg-white/[0.03] bg-white/[0.01]"
                    style="animation-delay:.1s"
                >
                    <div class="w-14 h-14 mx-auto mb-4 rounded-2xl bg-white/[0.07] border border-white/10 flex items-center justify-center">
                        <svg class="w-7 h-7 text-white/70" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5m-13.5-9L12 3m0 0l4.5 4.5M12 3v13.5"></path>
                        </svg>
                    </div>
                    <p class="text-lg font-extrabold tracking-tight mb-1">Drop your .docx file here</p>
                    <p class="text-white/40 text-sm mb-4">or <span class="text-white font-bold underline underline-offset-4">click to browse</span> · Only .docx, max 10 MB</p>
                    <div class="flex flex-wrap justify-center gap-2 text-[11px] font-bold text-white/45">
                        <span class="px-3 py-1 rounded-full bg-white/[0.05] border border-white/10">BLOG 1… / BLOG 1 OF 10 formats</span>
                        <span class="px-3 py-1 rounded-full bg-white/[0.05] border border-white/10">Keywords → tags</span>
                        <span class="px-3 py-1 rounded-full bg-white/[0.05] border border-white/10">Q&amp;A → FAQ</span>
                        <span class="px-3 py-1 rounded-full bg-white/[0.05] border border-white/10">Links stay bold</span>
                    </div>
                    <input id="file-input" type="file" accept=".docx" class="hidden" />
                </div>
                <div id="upload-status" class="text-center text-sm text-white/60 mt-4"></div>
            </section>

            <!-- STEP 3: Review -->
            <section id="view-review" class="hidden">
                <div class="flex flex-wrap items-center justify-between gap-2.5 mb-4">
                    <p id="review-count" class="text-sm text-white/60"></p>
                    <div class="flex items-center gap-2">
                        <button
                            id="btn-expand"
                            class="text-xs font-bold text-white/50 hover:text-white border border-white/15 hover:border-white/40 px-4 py-2 rounded-full transition-colors btn-press"
                            >Expand all</button
                        >
                        <button
                            id="btn-reset"
                            class="text-xs font-bold text-white/50 hover:text-white border border-white/15 hover:border-white/40 px-4 py-2 rounded-full transition-colors btn-press"
                            >New file</button
                        >
                    </div>
                </div>
                <div id="cards" class="grid grid-cols-1 lg:grid-cols-2 gap-3.5"></div>
                <div class="sticky bottom-4 mt-5 z-10">
                    <div class="rounded-2xl border border-white/15 bg-[#111]/95 backdrop-blur px-5 py-3.5 flex flex-col sm:flex-row items-center gap-3 shadow-2xl">
                        <p id="send-summary" class="flex-1 text-sm text-white/70 text-center sm:text-left"></p>
                        <button
                            id="btn-send"
                            class="w-full sm:w-auto bg-white text-black font-bold text-sm px-8 py-2.5 rounded-xl hover:bg-white/85 transition-colors disabled:opacity-40 btn-press"
                            >Send to WordPress (Draft) →</button
                        >
                    </div>
                </div>
            </section>

            <!-- STEP 4: Results -->
            <section id="view-results" class="hidden max-w-3xl mx-auto">
                <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 md:p-7 shadow-2xl rise">
                    <div id="results-icon" class="w-11 h-11 rounded-2xl bg-emerald-400 text-black flex items-center justify-center mb-3.5 text-lg font-extrabold">✓</div>
                    <h2 id="results-title" class="text-xl font-extrabold tracking-tight mb-1"></h2>
                    <p class="text-white/50 text-sm mb-5">Further editing and publishing happen in WordPress.</p>
                    <div id="results-list" class="space-y-2.5"></div>
                    <button
                        id="btn-again"
                        class="mt-5 w-full border border-white/20 font-bold text-sm px-6 py-3 rounded-xl hover:bg-white/10 transition-colors btn-press"
                        >Upload another file</button
                    >
                </div>
            </section>

            <p class="text-center text-white/30 text-xs mt-8">This page is not indexed. Editing and publishing happen in WordPress.</p>
        </div>
    </div>

    <script is:inline>
        (function () {
            "use strict";
            var ENDPOINT = "/blog-upload.php";
            var SITE_URL = "https://chimpzlab.com";
            var CATS = [
                ["seo-aeo", "SEO / AEO"],
                ["performance-marketing", "Performance Marketing"],
                ["video-production", "Video Production"],
                ["social-media-marketing", "Social Media Marketing"],
                ["content-writing", "Content Writing"],
                ["influencer-marketing", "Influencer Marketing"],
                ["public-relations", "Public Relations"],
                ["email-marketing", "Email Marketing"],
                ["chatbot-virtual-assistant", "Chatbot & Virtual Assistant"],
                ["branding", "Branding"],
                ["corporate-communications", "Corporate Communications"],
                ["employer-branding", "Employer Branding"],
                ["website-design-development", "Web Design & Development"],
                ["landing-pages", "Landing Pages"],
                ["vetted-lead-generation", "Vetted Lead Generation"],
                ["design", "Design"],
                ["strategy", "Strategy"],
            ];
            var GUESS = [
                [/googlebot|crawl|search console|\bseo\b|answer engine|ai overview|\baeo\b/i, "seo-aeo"],
                [/instagram|reels|linkedin|youtube|social media/i, "social-media-marketing"],
                [/influencer|creator|ugc/i, "influencer-marketing"],
                [/\bvideo\b|film|shoot/i, "video-production"],
                [/logo|handcraft|kinetic|design trend|\bdesign\b/i, "design"],
                [/photograph|brand campaign|creative team|branding/i, "branding"],
                [/nielsen|doubleverify|verification|programmatic|clicks|conversion|ctr|performance|paid media/i, "performance-marketing"],
                [/dpdp|data protection|privacy|consent|compliance/i, "corporate-communications"],
                [/b2b|buyer|attribution|lead generation|demand gen/i, "vetted-lead-generation"],
                [/email|newsletter|deliverability/i, "email-marketing"],
                [/chatbot|whatsapp|assistant/i, "chatbot-virtual-assistant"],
                [/employer|hiring|talent|gcc/i, "employer-branding"],
                [/website|landing page|web design|page speed/i, "website-design-development"],
                [/content team|content strategy|copywrit|blog/i, "content-writing"],
                [/public relations|\bpr\b|crisis|reputation/i, "public-relations"],
            ];

            var notice = document.getElementById("notice");
            var undoBar = document.getElementById("undo-bar");
            var undoText = document.getElementById("undo-text");
            var undoTimer = null;
            var lastRemoved = null;
            var views = {
                login: document.getElementById("view-login"),
                upload: document.getElementById("view-upload"),
                review: document.getElementById("view-review"),
                results: document.getElementById("view-results"),
            };
            var btnLogout = document.getElementById("btn-logout");
            var cards = document.getElementById("cards");
            var parsed = [];
            var expanded = {};

            function esc(s) {
                return String(s).replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
            }
            function showNotice(msg, ok) {
                notice.classList.remove("hidden");
                notice.className = "mb-5 px-5 py-3 rounded-xl border text-sm rise " + (ok
                    ? "border-emerald-400/30 bg-emerald-400/10 text-emerald-200"
                    : "border-red-400/30 bg-red-400/10 text-red-200");
                notice.innerHTML = msg;
            }
            function hideNotice() { notice.classList.add("hidden"); }
            function hideUndo() { undoBar.classList.add("hidden"); lastRemoved = null; if (undoTimer) { clearTimeout(undoTimer); undoTimer = null; } }
            function show(view) {
                Object.keys(views).forEach(function (k) { views[k].classList.add("hidden"); });
                views[view].classList.remove("hidden");
                window.scrollTo({ top: 0, behavior: "smooth" });
            }
            function setStep(n) {
                Array.prototype.forEach.call(document.querySelectorAll("#steps li[data-step]"), function (li) {
                    var dot = li.querySelector(".step-dot");
                    var s = +li.getAttribute("data-step");
                    dot.className = "step-dot " + (s < n ? "step-done" : s === n ? "step-now" : "step-todo");
                    dot.textContent = s < n ? "✓" : s;
                });
            }
            function enterUploader() {
                btnLogout.classList.remove("hidden");
                setStep(2);
                show("upload");
            }

            function guessCategory(title, keywords) {
                var hay = title + " " + keywords;
                for (var i = 0; i < GUESS.length; i++) if (GUESS[i][0].test(hay)) return GUESS[i][1];
                return "content-writing";
            }
            // Week-4 style category line, e.g. "3. CREATIVE — 3.3 VIDEO PRODUCTION
            // / 2. VISIBILITY & SEARCH — 2.1 SOCIAL MEDIA MARKETING". The first
            // segment is the primary service.
            var SERVICE_MAP = [
                [/thought leadership/i, "thought-leadership"],
                [/corporate communications/i, "corporate-communications"],
                [/public relations/i, "public-relations"],
                [/employer branding/i, "employer-branding"],
                [/seo\/aeo|\bseo\b/i, "seo-aeo"],
                [/social media marketing/i, "social-media-marketing"],
                [/content/i, "content-writing"],
                [/influencer/i, "influencer-marketing"],
                [/video production/i, "video-production"],
                [/marketing automation/i, "marketing-automation"],
                [/performance marketing/i, "performance-marketing"],
                [/lead generation|vetted/i, "vetted-lead-generation"],
                [/email/i, "email-marketing"],
                [/chatbot|virtual assistant/i, "chatbot-virtual-assistant"],
                [/web design|development|website/i, "website-design-development"],
                [/landing/i, "landing-pages"],
                [/branding/i, "branding"],
                [/design/i, "design"],
            ];
            function isServiceLine(t) {
                return /\d+\.\d+/.test(t) && t.length < 220 &&
                    /creative|visibility|demand|reputation|digital|branding|seo|video|social|content|influencer|public|email|chatbot|corporate|employer|website|landing|lead|design|performance|automation|thought/i.test(t);
            }
            function mapServiceLine(line) {
                var seg = String(line).split("/")[0];
                for (var i = 0; i < SERVICE_MAP.length; i++) if (SERVICE_MAP[i][0].test(seg)) return SERVICE_MAP[i][1];
                return "";
            }
            function stripTags(s) {
                var d = document.createElement("div");
                d.innerHTML = s || "";
                return (d.textContent || "").replace(/\s+/g, " ").trim();
            }
            function splitTitle(t) {
                t = String(t || "").trim();
                if (!t) return [""];
                if (t.indexOf("?") !== -1) {
                    var parts = t.split("?");
                    if (parts.length > 1) {
                        parts[0] = parts[0] + "?";
                        return parts.map(function (p) { return p.trim(); }).filter(Boolean);
                    }
                }
                var sp = t.split(/\s*[?.:]\s+|\s+[-–—]\s+/).map(function (s) { return s.trim(); }).filter(Boolean);
                if (sp.length > 3) sp = sp.slice(0, 3);
                if (sp.length === 1 && t.length > 70) {
                    var words = t.split(/\s+/), mid = Math.ceil(words.length / 2);
                    sp = [words.slice(0, mid).join(" "), words.slice(mid).join(" ")];
                }
                return sp.length ? sp : [t];
            }
            function stripPrefix(html, pre) {
                return html.replace(new RegExp("^((?:<[^>]+>)*)" + pre + ":\\s*"), "$1");
            }
            function slugify(s, maxLen) {
                var slug = String(s || "").toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "");
                if (maxLen && slug.length > maxLen) slug = slug.slice(0, maxLen).replace(/-+$/g, "");
                return slug;
            }
            function linkify(html) {
                var parts = String(html).split(/(<a\b[^>]*>[\s\S]*?<\/a>)/gi);
                for (var i = 0; i < parts.length; i += 2) {
                    parts[i] = parts[i].replace(/(https?:\/\/[^\s<)"'\]]+)/gi, function (url) {
                        var trail = "";
                        var m = url.match(/[.,;:!?)\]]+$/);
                        if (m) { trail = m[0]; url = url.slice(0, -trail.length); }
                        if (!url) return trail;
                        return '<a href="' + url + '"><strong>' + url + "</strong></a>" + trail;
                    });
                }
                return parts.join("");
            }
            function boldLinks(html) {
                return html.replace(/<a(\s[^>]*)?>([\s\S]*?)<\/a>/gi, function (m, attrs, inner) {
                    if (/<(strong|b|mark)\b/i.test(inner)) return m;
                    return "<a" + (attrs || "") + "><strong>" + inner + "</strong></a>";
                });
            }

            function parseDocx(html) {
                var doc = new DOMParser().parseFromString("<div>" + html + "</div>", "text/html");
                // Headings too: some files style titles with Heading styles
                // (mammoth emits <h1..h6>) and bullets become <li>.
                var nodes = Array.prototype.slice.call(doc.querySelectorAll("p, h1, h2, h3, h4, h5, h6, li"));
                var paras = nodes.map(function (p) { return p.innerHTML; });
                var texts = nodes.map(function (p) { return (p.textContent || "").replace(/\s+/g, " ").trim(); });
                var starts = [];
                texts.forEach(function (t, i) { if (/^blog\s+\d+/i.test(t)) starts.push(i); });
                var blogs = [];
                function isKw(t, pre) { return new RegExp("^" + pre + "\\s*:", "i").test(t); }
                starts.forEach(function (s, bi) {
                    var end = bi + 1 < starts.length ? starts[bi + 1] : paras.length;
                    var P = paras.slice(s + 1, end), T = texts.slice(s + 1, end);
                    var j = 0;
                    // Header zone: keywords, service line and title can appear in any
                    // order (Week-6: title first; Week-4: keywords, service line, title).
                    var title = "", titleHtml = "", primary = "", secondary = "", lineCat = "";
                    while (j < T.length) {
                        var ht = T[j];
                        if (ht === "" || /━/.test(ht)) { j++; continue; }
                        if (isKw(ht, "primary keyword")) { primary = ht.replace(/^primary keyword\s*:\s*/i, ""); j++; continue; }
                        if (isKw(ht, "secondary keywords?")) { secondary = ht.replace(/^secondary keywords?\s*:\s*/i, ""); j++; continue; }
                        if (isServiceLine(ht)) { if (!lineCat) lineCat = mapServiceLine(ht); j++; continue; }
                        title = ht; titleHtml = P[j]; j++;
                        break;
                    }
                    // Week-6 style: keyword lines come after the title.
                    while (j < T.length) {
                        var ht2 = T[j];
                        if (ht2 === "" || /━/.test(ht2)) { j++; continue; }
                        if (isKw(ht2, "primary keyword")) { if (!primary) primary = ht2.replace(/^primary keyword\s*:\s*/i, ""); j++; continue; }
                        if (isKw(ht2, "secondary keywords?")) { if (!secondary) secondary = ht2.replace(/^secondary keywords?\s*:\s*/i, ""); j++; continue; }
                        if (isServiceLine(ht2)) { if (!lineCat) lineCat = mapServiceLine(ht2); j++; continue; }
                        break;
                    }
                    while (j < T.length && (T[j] === "" || /━/.test(T[j]))) j++;
                    var introHtml = P[j] || "", intro = T[j] || ""; j++;
                    var blocks = [];
                    var inFaq = false, faqN = 0, pendingQ = null;
                    for (; j < T.length; j++) {
                        var tt = T[j], hh = P[j];
                        if (tt === "" || /━/.test(tt)) continue;
                        if (/^frequently asked questions$/i.test(tt) || /^faq$/i.test(tt)) {
                            inFaq = true;
                            blocks.push({ tag: "h2", html: "Frequently Asked Questions" });
                        } else if (/^q:/i.test(stripTags(hh))) {
                            var qHtml = stripPrefix(hh, "Q");
                            if (inFaq) pendingQ = qHtml;
                            else blocks.push({ tag: "h3", html: qHtml });
                        } else if (/^a:/i.test(stripTags(hh))) {
                            var aHtml = stripPrefix(hh, "A");
                            if (inFaq && pendingQ !== null) {
                                faqN++;
                                blocks.push({ tag: "p", html: "<strong>" + faqN + ". " + pendingQ + "</strong><br>" + aHtml });
                                pendingQ = null;
                            } else blocks.push({ tag: "p", html: aHtml });
                        } else if (inFaq && pendingQ !== null && tt !== "") {
                            // Week-4 style: answer paragraph without an "A:" prefix.
                            faqN++;
                            blocks.push({ tag: "p", html: "<strong>" + faqN + ". " + pendingQ + "</strong><br>" + hh });
                            pendingQ = null;
                        }
                        else if (inFaq && /\?$/.test(tt) && tt.length < 200) pendingQ = hh;
                        else if (/\?$/.test(tt) && tt.length < 160) blocks.push({ tag: "h2", html: hh });
                        else blocks.push({ tag: "p", html: hh });
                    }
                    if (!title) return;
                    var allText = [title, intro].concat(blocks.map(function (b) { return stripTags(b.html); })).join(" ");
                    var words = (allText.match(/\S+/g) || []).length;
                    var readTime = Math.max(1, Math.ceil(words / 200)) + " Min Read";
                    var content = "<!-- readtime:" + readTime + " -->\n<!-- titleparts:" + JSON.stringify(splitTitle(title)) + " -->\n";
                    content += "<p>" + introHtml + "</p>\n";
                    blocks.forEach(function (b) { content += "<" + b.tag + ">" + b.html + "</" + b.tag + ">\n"; });
                    var tags = secondary.split(",").map(function (x) { return x.trim(); }).filter(Boolean).slice(0, 12);
                    var category = lineCat || guessCategory(title, primary + " " + secondary);
                    blogs.push({ title: title, excerpt: intro, content: boldLinks(linkify(content)), slug: slugify(primary, 60), words: words, readTime: readTime, tags: tags, category: category });
                });
                return blogs;
            }

            function catOptions(selected) {
                return CATS.map(function (c) {
                    return '<option value="' + c[0] + '"' + (c[0] === selected ? " selected" : "") + ">" + c[1] + "</option>";
                }).join("");
            }
            function catName(slug) {
                for (var i = 0; i < CATS.length; i++) if (CATS[i][0] === slug) return CATS[i][1];
                return slug;
            }
            function tagChips(tags) {
                if (!tags.length) return '<span class="text-white/30 text-xs">No tags</span>';
                var shown = tags.slice(0, 6).map(function (t) {
                    return '<span class="inline-block text-[11px] font-semibold bg-white/[0.07] border border-white/10 rounded-full px-2.5 py-0.5 mr-1 mb-1">' + esc(t) + "</span>";
                }).join("");
                if (tags.length > 6) shown += '<span class="text-[11px] text-white/40 font-bold">+' + (tags.length - 6) + " more</span>";
                return shown;
            }

            function cardHtml(b, i) {
                var isOpen = !!expanded[i];
                return '<article class="card-hover rounded-2xl border border-white/10 bg-white/[0.03] backdrop-blur flex flex-col' + (isOpen ? " open" : "") + '" data-card="' + i + '">'
                    // Header row — always visible, click toggles
                    + '<div class="flex items-center gap-3 p-3.5 md:p-4 cursor-pointer card-head" data-head="' + i + '">'
                    + '<span class="w-7 h-7 shrink-0 rounded-full bg-white text-black text-xs font-extrabold flex items-center justify-center">' + (i + 1) + "</span>"
                    + '<div class="flex-1 min-w-0">'
                    + '<h3 class="font-extrabold text-sm leading-snug tracking-tight clamp-2">' + esc(b.title) + "</h3>"
                    + '<p class="text-[11px] text-white/40 mt-1">' + esc(catName(b.category)) + " • " + b.words + " words • " + esc(b.readTime) + "</p>"
                    + "</div>"
                    + '<svg class="chev w-4 h-4 shrink-0 text-white/40" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 8.25l-7.5 7.5-7.5-7.5"></path></svg>'
                    + '<button data-del="' + i + '" title="Delete this blog" class="shrink-0 h-8 px-3 rounded-lg bg-red-500/10 border border-red-400/25 text-red-300 hover:bg-red-500/20 hover:border-red-400/60 hover:text-red-200 transition-colors btn-press flex items-center gap-1.5 text-[11px] font-extrabold">'
                    + '<svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M14.74 9l-.346 9m-4.788 0L9.26 9m9.968-3.21c.342.052.682.107 1.022.166m-1.022-.165L18.16 19.673a2.25 2.25 0 01-2.244 2.077H8.084a2.25 2.25 0 01-2.244-2.077L4.772 5.79m14.456 0a48.108 48.108 0 00-3.478-.397m-12 .562c.34-.059.68-.114 1.022-.165m0 0a48.11 48.11 0 013.478-.397m7.5 0v-.916c0-1.18-.91-2.164-2.09-2.201a51.964 51.964 0 00-3.32 0c-1.18.037-2.09 1.022-2.09 2.201v.916m7.5 0a48.667 48.667 0 00-7.5 0"></path></svg>'
                    + "Delete</button>"
                    + "</div>"
                    // Body — details, hidden until expanded
                    + '<div class="card-body' + (isOpen ? "" : " hidden") + ' px-3.5 md:px-4 pb-3.5 md:pb-4">'
                    + '<div class="pt-1 mt-1 border-t border-white/[0.07]"></div>'
                    + '<label class="text-[10px] font-bold uppercase tracking-widest text-white/40">URL slug</label>'
                    + '<div class="flex items-center gap-1.5 mt-1 mb-3 text-sm"><span class="text-white/30 shrink-0 text-[11px]">/blog-insights/</span>'
                    + '<input data-slug="' + i + '" value="' + esc(b.slug) + '" placeholder="auto from title" spellcheck="false" class="flex-1 min-w-0 bg-white/[0.06] border border-white/15 rounded-lg px-2.5 py-1.5 font-mono text-[11px] focus:outline-none focus:border-white/50 transition-colors placeholder:text-white/25" />'
                    + '<button data-copy="' + i + '" title="Copy full URL" class="shrink-0 h-8 px-2.5 rounded-lg border border-white/15 text-[11px] font-bold text-white/60 hover:text-white hover:border-white/40 transition-colors btn-press">Copy</button></div>'
                    + '<div class="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-3">'
                    + '<div><label class="text-[10px] font-bold uppercase tracking-widest text-white/40">Category</label>'
                    + '<select data-cat="' + i + '" class="cat-select w-full mt-1 bg-white/[0.06] border border-white/15 rounded-lg px-2.5 py-2 text-[13px] focus:outline-none focus:border-white/50 transition-colors">'
                    + catOptions(b.category) + "</select></div>"
                    + '<div><div class="text-[10px] font-bold uppercase tracking-widest text-white/40 mb-1">Tags</div>'
                    + '<div class="max-h-[74px] overflow-y-auto preview-scroll">' + tagChips(b.tags) + "</div></div>"
                    + "</div>"
                    + '<button data-pv="' + i + '" class="text-xs font-bold text-white/60 hover:text-white underline underline-offset-4 transition-colors">Preview content</button>'
                    + '<div data-pvbody="' + i + '" class="hidden mt-2.5 max-h-60 overflow-y-auto preview-scroll p-3.5 rounded-xl bg-black/40 border border-white/10 text-[13px] leading-relaxed preview-render"></div>'
                    + "</div>"
                    + "</article>";
            }

            function renderCards() {
                document.getElementById("review-count").innerHTML =
                    "<b class=\"text-white\">" + parsed.length + " blog" + (parsed.length === 1 ? "" : "s") + " ready.</b> <span class=\"text-xs\">Click a card to expand and review, then send.</span>";
                document.getElementById("send-summary").innerHTML =
                    "<b class=\"text-white\">" + parsed.length + " draft" + (parsed.length === 1 ? "" : "s") + "</b> will be created in WordPress.";
                document.getElementById("btn-send").disabled = !parsed.length;
                document.getElementById("btn-expand").textContent =
                    Object.keys(expanded).length === parsed.length && parsed.length ? "Collapse all" : "Expand all";
                cards.innerHTML = parsed.map(cardHtml).join("");
                bindCards();
            }

            function copyText(text, btn) {
                function done() {
                    var old = btn.textContent;
                    btn.textContent = "Copied";
                    setTimeout(function () { btn.textContent = old; }, 1200);
                }
                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(done, function () { fallback(); });
                } else fallback();
                function fallback() {
                    var ta = document.createElement("textarea");
                    ta.value = text;
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand("copy"); } catch (e) {}
                    document.body.removeChild(ta);
                    done();
                }
            }

            function bindCards() {
                Array.prototype.forEach.call(cards.querySelectorAll("[data-head]"), function (head) {
                    head.addEventListener("click", function () {
                        var idx = +head.getAttribute("data-head");
                        var card = cards.querySelector('[data-card="' + idx + '"]');
                        if (!card) return;
                        var body = card.querySelector(".card-body");
                        if (expanded[idx]) { delete expanded[idx]; body.classList.add("hidden"); card.classList.remove("open"); }
                        else { expanded[idx] = true; body.classList.remove("hidden"); card.classList.add("open"); }
                        document.getElementById("btn-expand").textContent =
                            Object.keys(expanded).length === parsed.length && parsed.length ? "Collapse all" : "Expand all";
                    });
                });
                Array.prototype.forEach.call(cards.querySelectorAll("[data-cat]"), function (sel) {
                    sel.addEventListener("change", function () {
                        var idx = +sel.getAttribute("data-cat");
                        parsed[idx].category = sel.value;
                        var head = cards.querySelector('[data-card="' + idx + '"] .card-head p');
                        if (head) head.innerHTML = esc(catName(sel.value)) + " • " + parsed[idx].words + " words • " + esc(parsed[idx].readTime);
                    });
                });
                Array.prototype.forEach.call(cards.querySelectorAll("[data-slug]"), function (inp) {
                    inp.addEventListener("change", function () {
                        var clean = slugify(inp.value, 60);
                        inp.value = clean;
                        parsed[+inp.getAttribute("data-slug")].slug = clean;
                    });
                });
                Array.prototype.forEach.call(cards.querySelectorAll("[data-copy]"), function (btn) {
                    btn.addEventListener("click", function (e) {
                        e.stopPropagation();
                        var b = parsed[+btn.getAttribute("data-copy")];
                        copyText(SITE_URL + "/blog-insights/" + (b.slug || ""), btn);
                    });
                });
                Array.prototype.forEach.call(cards.querySelectorAll("[data-pv]"), function (tgl) {
                    tgl.addEventListener("click", function (e) {
                        e.stopPropagation();
                        var idx = +tgl.getAttribute("data-pv");
                        var box = cards.querySelector('[data-pvbody="' + idx + '"]');
                        if (!box) return;
                        if (box.classList.contains("hidden")) {
                            box.innerHTML = parsed[idx].content;
                            box.classList.remove("hidden");
                            tgl.textContent = "Hide preview";
                        } else {
                            box.classList.add("hidden");
                            tgl.textContent = "Preview content";
                        }
                    });
                });
                Array.prototype.forEach.call(cards.querySelectorAll("[data-del]"), function (btn) {
                    btn.addEventListener("click", function (e) {
                        e.stopPropagation();
                        var idx = +btn.getAttribute("data-del");
                        lastRemoved = { blog: parsed[idx], index: idx };
                        parsed.splice(idx, 1);
                        expanded = {};
                        if (undoTimer) { clearTimeout(undoTimer); undoTimer = null; }
                        if (!parsed.length) {
                            hideUndo();
                            show("upload");
                            setStep(2);
                            showNotice('Removed "<b>' + esc(lastRemoved.blog.title) + '</b>". No blogs left — please send a new file.', false);
                            lastRemoved = null;
                            return;
                        }
                        undoText.innerHTML = 'Removed "<b class="text-white">' + esc(lastRemoved.blog.title.length > 60 ? lastRemoved.blog.title.slice(0, 60) + "…" : lastRemoved.blog.title) + '</b>"';
                        undoBar.classList.remove("hidden");
                        undoTimer = setTimeout(hideUndo, 9000);
                        renderCards();
                    });
                });
            }

            document.getElementById("btn-expand").addEventListener("click", function () {
                if (Object.keys(expanded).length === parsed.length && parsed.length) expanded = {};
                else parsed.forEach(function (_, i) { expanded[i] = true; });
                renderCards();
            });

            document.getElementById("btn-undo").addEventListener("click", function () {
                if (!lastRemoved) return;
                parsed.splice(Math.min(lastRemoved.index, parsed.length), 0, lastRemoved.blog);
                expanded = {};
                hideUndo();
                renderCards();
            });

            function handleFile(file) {
                if (!file) return;
                hideNotice();
                hideUndo();
                if (!/\.docx$/i.test(file.name)) { showNotice("Only <b>.docx</b> files are supported. Save the file as .docx in Word and try again.", false); return; }
                if (file.size > 10 * 1024 * 1024) { showNotice("The file is larger than 10 MB. Please upload a smaller file.", false); return; }
                if (typeof window.mammoth === "undefined") { showNotice("The parser failed to load — check your connection and reload the page.", false); return; }
                var status = document.getElementById("upload-status");
                status.innerHTML = 'Reading <b class="text-white">' + esc(file.name) + '</b> <span class="sending">…</span>';
                var reader = new FileReader();
                reader.onload = function () {
                    window.mammoth.convertToHtml({ arrayBuffer: reader.result }).then(function (r) {
                        parsed = parseDocx(r.value);
                        status.innerHTML = "";
                        if (!parsed.length) {
                            showNotice("No <b>BLOG 1, BLOG 2…</b> format found in this file. Please upload a file in the Week-6 format.", false);
                            return;
                        }
                        hideUndo();
                        expanded = {};
                        setStep(3);
                        show("review");
                        renderCards();
                    }).catch(function () {
                        status.innerHTML = "";
                        showNotice("Could not read the file. Please upload a valid .docx file.", false);
                    });
                };
                reader.onerror = function () {
                    status.innerHTML = "";
                    showNotice("Could not read the file.", false);
                };
                reader.readAsArrayBuffer(file);
            }

            // Resume an existing session so a reload does not ask for the password again.
            setStep(1);
            show("login");
            fetch(ENDPOINT + "?action=status", { credentials: "same-origin" })
                .then(function (r) { return r.json(); })
                .then(function (j) {
                    if (j && j.authed) enterUploader();
                })
                .catch(function () {});

            // Login
            document.getElementById("login-form").addEventListener("submit", function (e) {
                e.preventDefault();
                var un = document.getElementById("login-username").value.trim();
                var pw = document.getElementById("login-password").value;
                if (!un || !pw) return;
                hideNotice();
                var fd = new FormData();
                fd.append("username", un);
                fd.append("password", pw);
                fetch(ENDPOINT + "?action=login", { method: "POST", body: fd, credentials: "same-origin" })
                    .then(function (r) { return r.json().then(function (j) { return { s: r.status, j: j }; }); })
                    .then(function (res) {
                        document.getElementById("login-password").value = "";
                        if (res.j && res.j.ok) { showNotice("Logged in successfully. Send the <b>.docx file</b> to begin.", true); enterUploader(); }
                        else showNotice("<b>" + esc((res.j && res.j.error) || "Login failed") + "</b>", false);
                    })
                    .catch(function () { showNotice("Could not reach the server.", false); });
            });

            // Show / hide password
            document.getElementById("toggle-pw").addEventListener("click", function () {
                var input = document.getElementById("login-password");
                var showPw = input.type === "password";
                input.type = showPw ? "text" : "password";
                this.textContent = showPw ? "Hide" : "Show";
                input.focus();
            });

            // Logout
            btnLogout.addEventListener("click", function () {
                fetch(ENDPOINT + "?action=logout", { credentials: "same-origin" })
                    .finally(function () { window.location.reload(); });
            });

            // Upload wiring
            var dz = document.getElementById("dropzone");
            var fi = document.getElementById("file-input");
            dz.addEventListener("click", function () { fi.click(); });
            fi.addEventListener("change", function () { handleFile(fi.files[0]); fi.value = ""; });
            ["dragover", "dragenter"].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.add("drop-active"); }); });
            ["dragleave", "drop"].forEach(function (ev) { dz.addEventListener(ev, function (e) { e.preventDefault(); dz.classList.remove("drop-active"); }); });
            dz.addEventListener("drop", function (e) { if (e.dataTransfer.files.length) handleFile(e.dataTransfer.files[0]); });

            document.getElementById("btn-reset").addEventListener("click", function () {
                parsed = [];
                expanded = {};
                hideNotice();
                hideUndo();
                setStep(2);
                show("upload");
            });

            document.getElementById("btn-again").addEventListener("click", function () {
                parsed = [];
                expanded = {};
                hideNotice();
                hideUndo();
                setStep(2);
                show("upload");
            });

            document.getElementById("btn-send").addEventListener("click", function () {
                if (!parsed.length) return;
                var btn = this;
                btn.disabled = true;
                btn.classList.add("sending");
                btn.textContent = "Sending to WordPress…";
                hideNotice();
                hideUndo();
                var payload = { blogs: parsed.map(function (b) { return { title: b.title, excerpt: b.excerpt, content: b.content, category: b.category, tags: b.tags, slug: b.slug }; }) };
                fetch(ENDPOINT + "?action=upload", {
                    method: "POST", credentials: "same-origin",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify(payload),
                })
                    .then(function (r) { return r.json().then(function (j) { return { s: r.status, j: j }; }); })
                    .then(function (res) {
                        btn.disabled = false;
                        btn.classList.remove("sending");
                        btn.textContent = "Send to WordPress (Draft) →";
                        if (!res.j || !res.j.ok) { showNotice("<b>" + esc((res.j && res.j.error) || ("Error " + res.s)) + "</b>", false); return; }
                        var okN = 0;
                        var rows = res.j.results.map(function (r, i) {
                            if (r.ok) {
                                okN++;
                                return '<div class="rise p-3.5 rounded-xl bg-black/30 border border-emerald-400/20 hover:border-emerald-400/40 transition-colors" style="animation-delay:' + Math.min(i * 50, 400) + 'ms">'
                                    + '<div class="flex items-start gap-2.5"><span class="text-emerald-400 font-extrabold">✓</span>'
                                    + '<div class="min-w-0"><div class="font-bold text-sm">' + esc(r.title) + "</div>"
                                    + (r.slug ? '<div class="text-white/45 text-xs font-mono mt-0.5">/blog-insights/' + esc(r.slug) + "</div>" : "")
                                    + '<a href="' + r.edit + '" target="_blank" rel="noopener" class="text-xs font-bold text-white/70 hover:text-white underline underline-offset-4">Open in WordPress →</a>'
                                    + "</div></div></div>";
                            }
                            return '<div class="p-3.5 rounded-xl bg-black/30 border border-red-400/20">'
                                + '<div class="flex items-start gap-2.5"><span class="text-red-400 font-extrabold">✗</span>'
                                + '<div class="min-w-0"><div class="font-bold text-sm">' + esc(r.title || ("Blog " + (i + 1))) + "</div>"
                                + '<div class="text-red-300/80 text-xs mt-0.5">' + esc(r.error || "failed") + "</div>"
                                + "</div></div></div>";
                        }).join("");
                        var icon = document.getElementById("results-icon");
                        if (okN === res.j.results.length) {
                            icon.className = "w-11 h-11 rounded-2xl bg-emerald-400 text-black flex items-center justify-center mb-3.5 text-lg font-extrabold";
                            icon.textContent = "✓";
                        } else if (okN === 0) {
                            icon.className = "w-11 h-11 rounded-2xl bg-red-400 text-black flex items-center justify-center mb-3.5 text-lg font-extrabold";
                            icon.textContent = "!";
                        } else {
                            icon.className = "w-11 h-11 rounded-2xl bg-amber-300 text-black flex items-center justify-center mb-3.5 text-lg font-extrabold";
                            icon.textContent = "•";
                        }
                        document.getElementById("results-title").textContent = okN + " of " + res.j.results.length + " drafts created";
                        document.getElementById("results-list").innerHTML = rows;
                        setStep(4);
                        show("results");
                    })
                    .catch(function () {
                        btn.disabled = false;
                        btn.classList.remove("sending");
                        btn.textContent = "Send to WordPress (Draft) →";
                        showNotice("Could not reach the server.", false);
                    });
            });
        })();
    </script>
</BaseLayout>
