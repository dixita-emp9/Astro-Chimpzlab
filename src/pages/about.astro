    hideHeader={false}
    hideFooter={false}
>
<Fragment slot="head">
<!-- Fonts: Manrope -->
    
    
    
    <noscript>
        
    </noscript>

    <!-- Tailwind CSS -->
    

    <!-- GSAP for Animations -->
    
    

    <!-- Lenis for Smooth Scrolling -->
    

    

    

    <style is:inline>
        .text-huge {
            font-size: clamp(3rem, 7vw, 7.5rem);
            line-height: 0.95;
            letter-spacing: -0.04em;
        }

        .text-massive {
            font-size: clamp(4rem, 10vw, 12rem);
            line-height: 0.85;
            letter-spacing: -0.05em;
        }

        .text-outline {
            color: transparent;
            -webkit-text-stroke: 1px rgba(255, 255, 255, 0.4);
        }

        .text-outline-dark {
            color: transparent;
            -webkit-text-stroke: 1px rgba(0, 0, 0, 0.2);
        }

        .img-bw {
            filter: grayscale(100%) contrast(1.1);
        }

        /* Value Row Hover Line */
        .value-row::before {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 0%;
            height: 2px;
            background-color: #000;
            transition: width 0.5s ease;
            z-index: 10;
        }

        .value-row:hover::before {
            width: 100%;
        }
    </style>
</Fragment>


    <!-- Hero Section -->
    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-40 pb-20 relative bg-brand-dark overflow-hidden border-b border-white/10">
        <div class="w-full max-w-[1400px] mx-auto z-10">

            <!-- Eyebrow -->
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">About ChimpzLab</span>
            </div>

            <!-- Massive Typography -->
            <h1
                class="text-2xl xs:text-4xl sm:text-5xl md:text-7xl lg:text-8xl xl:text-9xl font-extrabold uppercase text-white mb-16">
