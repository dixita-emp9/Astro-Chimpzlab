                    <div class="lg:col-span-5">
                        <h3
                            class="text-5xl md:text-7xl lg:text-[5rem] xl:text-[7rem] font-extrabold tracking-tighter uppercase leading-none group-hover:text-black text-gray-300 transition-colors duration-500">
                            [Value]
