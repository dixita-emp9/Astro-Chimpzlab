---
import ContactForm from "../components/sections/ContactForm.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
    title="Marketing Insights, Trends & Research | ChimpzLab"
    description="Stay ahead with ChimpzLab's marketing insights - SEO, AI search, social media trends, digital strategy, and industry research for modern marketers."
    canonical="/insights"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero -->
    <header
        class="pt-36 md:pt-48 pb-16 px-6 md:px-12 relative bg-brand-dark overflow-hidden"
    >
        <div class="w-full max-w-[1400px] mx-auto">
            <div class="mb-10 gsap-reveal">
                <span
                    class="text-sm font-bold uppercase tracking-widest border-b-2 border-white pb-2"
                    >ChimpzLab Insights</span
                >
            </div>
            <h1
                class="text-4xl sm:text-7xl md:text-8xl lg:text-9xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-8"
            >
                <div class="overflow-hidden">
                    <span class="block gsap-reveal-text">Perspectives</span>
                </div>
                <div class="overflow-hidden">
                    <span class="block text-white/40 gsap-reveal-text"
                        >That Move</span
                    >
                </div>
                <div class="overflow-hidden">
                    <span class="block gsap-reveal-text">Markets</span>
                </div>
            </h1>
            <p
                class="max-w-2xl text-lg md:text-2xl font-light text-gray-300 gsap-reveal"
            >
                Ideas, frameworks and field notes on reputation, visibility and
                the communications strategies behind brands that earn lasting
                trust.
            </p>
        </div>
    </header>

    <!-- Latest Insights Grid -->
    <section
        class="px-6 md:px-12 py-16 md:py-24 bg-brand-dark border-t border-white/5"
    >
        <div class="max-w-[1400px] mx-auto">
            <style is:inline>
                .insight-header-row {
                    display: flex;
                    align-items: center;
                    gap: 1.25rem;
                }

                .insight-search-wrap {
                    position: relative;
                }

                .insight-search-wrap svg {
                    position: absolute;
                    left: 0.75rem;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 1rem;
                    height: 1rem;
                    color: rgba(255, 255, 255, 0.45);
                    pointer-events: none;
                }

                .insight-search {
                    width: 100%;
                    max-width: 100%;
                    padding: 0.6rem 0.85rem 0.6rem 2.5rem;
                    border-radius: 9999px;
                    border: 1px solid rgba(255, 255, 255, 0.15);
                    background: rgba(255, 255, 255, 0.04);
                    color: #fff;
                    font-size: 0.95rem;
                    transition: all 0.3s ease;
                }

                .insight-search::placeholder {
                    color: rgba(255, 255, 255, 0.45);
                }

                .insight-search:focus {
                    outline: none;
                    border-color: rgba(255, 255, 255, 0.4);
                    background: rgba(255, 255, 255, 0.08);
                }

                @media (max-width: 767px) {
                    .insight-search {
                        width: 100%;
                        max-width: 100%;
                    }
                    .insight-search:focus {
                        width: 100%;
                    }
                    .insight-header-row {
                        flex-wrap: wrap;
                    }
                    .insight-search-wrap {
                        width: 100%;
                        order: -1;
                        margin-bottom: 0.5rem;
                    }
                }

                .insight-search {
                    padding-right: 2.75rem;
                }

                .insight-search:hover {
                    border-color: rgba(255, 255, 255, 0.3);
                    background: rgba(255, 255, 255, 0.06);
                }

                .insight-search:focus {
                    outline: none;
                    border-color: rgba(255, 255, 255, 0.55);
                    background: rgba(255, 255, 255, 0.09);
                    box-shadow: 0 0 0 3px rgba(255, 255, 255, 0.1);
                }

                .insight-search-spinner {
                    position: absolute;
                    right: 1rem;
                    top: 50%;
                    transform: translateY(-50%);
                    width: 1rem;
                    height: 1rem;
                    border: 2px solid rgba(255, 255, 255, 0.15);
                    border-top-color: rgba(255, 255, 255, 0.8);
                    border-radius: 50%;
                    animation: insight-spin 0.7s linear infinite;
                }

                .insight-search-spinner.hidden {
                    display: none;
                }

                @keyframes insight-spin {
                    to {
                        transform: translateY(-50%) rotate(360deg);
                    }
                }

                .search-highlight {
                    background: rgba(234, 179, 8, 0.35);
                    color: #fef08a;
                    border-radius: 3px;
                    padding: 0 2px;
                    font-weight: 700;
                }

                #insight-grid {
                    scroll-margin-top: 160px;
                }

                .insight-loading-spinner {
                    width: 2.5rem;
                    height: 2.5rem;
                    border: 3px solid rgba(255, 255, 255, 0.15);
                    border-top-color: rgba(255, 255, 255, 0.9);
                    border-radius: 50%;
                    animation: insight-loading-spin 0.7s linear infinite;
                }

                @keyframes insight-loading-spin {
                    to {
                        transform: rotate(360deg);
                    }
                }

                .insight-search-btn {
                    position: absolute;
                    left: 0.75rem;
                    top: 50%;
                    transform: translateY(-50%);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    width: 1.5rem;
                    height: 1.5rem;
                    border: none;
                    background: transparent;
                    color: rgba(255, 255, 255, 0.55);
                    cursor: pointer;
                    z-index: 2;
                }

                .insight-search-btn:hover {
                    color: #fff;
                }

                .insight-search {
                    padding-left: 2.75rem;
                }

                #insight-filters-wrapper {
                    flex: 1;
                    min-width: 0;
                    position: relative;
                    padding-left: 10px;
                }

                #insight-filters-wrapper::after {
                    content: "";
                    position: absolute;
                    right: 0;
                    top: 0;
                    bottom: 0;
                    width: 48px;
                    background: linear-gradient(
                        90deg,
                        transparent,
                        rgba(13, 13, 13, 0.9)
                    );
                    pointer-events: none;
                    z-index: 1;
                }

                #insight-filters {
                    overflow-x: auto;
                    scrollbar-width: none;
                    -webkit-overflow-scrolling: touch;
                    scroll-behavior: smooth;
                    cursor: grab;
                    user-select: none;
                }

                #insight-filters::-webkit-scrollbar {
                    display: none;
                }

                #insight-filters.dragging {
                    cursor: grabbing;
                    scroll-behavior: auto;
                }

                .insight-filter {
                    white-space: nowrap;
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    background: rgba(255, 255, 255, 0.04);
                    backdrop-filter: blur(4px);
                }

                .insight-filter:last-child {
                    margin-right: 50px;
                }

                .insight-filter:hover {
                    background: rgba(255, 255, 255, 0.12);
                    border-color: rgba(255, 255, 255, 0.2);
                }

                .insight-filter.active {
                    background: #fff;
                    color: #0d0d0d;
                    border-color: #fff;
                }

                @media (max-width: 575px) {
                    .insight-header-row {
                        flex-wrap: wrap;
                        justify-content: center;
                    }

                    .insight-header-row .insight-count {
                        width: 100%;
                        text-align: center;
                        margin-top: 2px;
                    }
                }
            </style>
            <div
                class="sticky top-24 z-40 mb-12 py-3 backdrop-blur-xl bg-brand-dark/85 -mx-2 px-2 rounded-xl border border-white/5"
            >
                <div class="insight-search-row mb-3">
                    <div class="insight-search-wrap relative w-full max-w-3xl mx-auto">
                        <button
                            type="button"
                            id="insight-search-btn"
                            class="insight-search-btn"
                            aria-label="Search insights"
                        >
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                                <circle cx="11" cy="11" r="7"></circle>
                                <path d="m21 21-4.3-4.3"></path>
                            </svg>
                        </button>
                        <input
                            id="insight-search"
                            class="insight-search w-full"
                            type="search"
                            placeholder="Search insights..."
                            aria-label="Search insights"
                        />
                        <span id="insight-search-spinner" class="insight-search-spinner hidden" aria-hidden="true"></span>
                    </div>
                </div>
                <div class="insight-header-row">
                    <div id="insight-filters-wrapper">
                        <div
                            class="flex flex-nowrap items-center gap-1.5 md:gap-2"
                            id="insight-filters"
                            role="tablist"
                            aria-label="Filter insights by topic"
                        >
                            <button
                                class="insight-filter active interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="all"
                                role="tab"
                                aria-selected="true">All</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="seo-aeo"
                                role="tab"
                                aria-selected="false">SEO / AEO</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="performance-marketing"
                                role="tab"
                                aria-selected="false"
                                >Performance Marketing</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="video-production"
                                role="tab"
                                aria-selected="false">Video Production</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="social-media-marketing"
                                role="tab"
                                aria-selected="false"
                                >Social Media Marketing</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="content-writing"
                                role="tab"
                                aria-selected="false">Content Writing</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="influencer-marketing"
                                role="tab"
                                aria-selected="false"
                                >Influencer Marketing</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="public-relations"
                                role="tab"
                                aria-selected="false">Public Relations</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="email-marketing"
                                role="tab"
                                aria-selected="false">Email Marketing</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="chatbot-virtual-assistant"
                                role="tab"
                                aria-selected="false"
                                >Chatbot & Virtual Assistant</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="branding"
                                role="tab"
                                aria-selected="false">Branding</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="corporate-communications"
                                role="tab"
                                aria-selected="false"
                                >Corporate Communications</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="employer-branding"
                                role="tab"
                                aria-selected="false">Employer Branding</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="website-design-development"
                                role="tab"
                                aria-selected="false"
                                >Web Design & Development</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="landing-pages"
                                role="tab"
                                aria-selected="false">Landing Pages</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="vetted-lead-generation"
                                role="tab"
                                aria-selected="false"
                                >Vetted Lead Generation</button
                            >
                            <button
                                class="insight-filter interactive shrink-0 px-3 py-1.5 md:px-4 md:py-2 rounded-full text-xs md:text-sm font-semibold tracking-wide transition-all duration-300"
                                data-filter="design"
                                role="tab"
                                aria-selected="false">Design</button
                            >
                        </div>
                    </div>
                    <span
                        class="insight-count shrink-0 text-xs md:text-sm text-white/40 font-medium tracking-wide whitespace-nowrap"
                    ></span>
                </div>
            </div>

            <div class="relative min-h-[200px]">
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8"
                id="insight-grid"
            >
                <!-- Cards rendered dynamically by JS -->
                <p
                    id="insight-empty"
                    class="hidden text-center text-gray-500 py-20 text-lg md:col-span-2 lg:col-span-3"
                >
                    No insights in this category yet - check back soon.
                </p>
            </div>
            <div
                id="insight-loading"
                class="hidden absolute inset-0 z-20 flex flex-col items-center justify-center gap-3 bg-brand-dark/70 backdrop-blur-sm rounded-2xl"
            >
                <span class="insight-loading-spinner" aria-hidden="true"></span>
                <span class="text-sm font-semibold uppercase tracking-widest text-white/80">
                    Searching insights...
                </span>
            </div>
            </div>
        </div>
    </section>

    <!-- CTA Band -->
    <section class="px-6 md:px-12 py-24 bg-[#0d0d0d] border-t border-white/10">
        <div class="max-w-[1400px] mx-auto text-center">
            <h3
                class="text-4xl md:text-6xl font-extrabold tracking-tighter uppercase text-white mb-8"
            >
                Have a perspective to share?
            </h3>
            <a
                href="/booking-form"
                class="interactive bg-white hover:bg-gray-200 text-black px-10 py-5 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 inline-flex items-center gap-2"
                >Let's start a conversation
                <svg
                    class="w-5 h-5"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                </svg>
            </a>
        </div>
    </section>

    <!-- Contact Form Section -->
    <section
        class="py-32 px-6 md:px-12 bg-white text-brand-dark"
        id="booking-form"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24 items-start"
            >
                <!-- Left Side: Copy -->
                <div>
                    <h2
                        class="text-5xl md:text-7xl font-extrabold tracking-tighter mb-6 text-black uppercase leading-[0.9]"
                    >
                        Ready to get started?
                    </h2>
                    <p class="text-xl text-gray-600 mb-12 max-w-lg font-medium">
                        Submit your inquiry and our team will get back to you
                        within 24 hours.
                    </p>

                    <div class="space-y-8 max-w-md">
                        <!-- Item -->
                        <div class="flex gap-4 items-start">
                            <div
                                class="shrink-0 w-6 h-6 rounded-full border-2 border-black flex items-center justify-center mt-1"
                            >
                                <svg
                                    class="w-3.5 h-3.5 text-black"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-black mb-1">
                                    Reputation Strategy
                                </h4>
                                <p class="text-gray-600 text-sm font-medium">
                                    Expert guidance on your brand's market
                                    narrative.
                                </p>
                            </div>
                        </div>
                        <!-- Item -->
                        <div class="flex gap-4 items-start">
                            <div
                                class="shrink-0 w-6 h-6 rounded-full border-2 border-black flex items-center justify-center mt-1"
                            >
                                <svg
                                    class="w-3.5 h-3.5 text-black"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-black mb-1">
                                    Stakeholder Mapping
                                </h4>
                                <p class="text-gray-600 text-sm font-medium">
                                    Identify and engage the audiences that move
                                    your business.
                                </p>
                            </div>
                        </div>
                        <!-- Item -->
                        <div class="flex gap-4 items-start">
                            <div
                                class="shrink-0 w-6 h-6 rounded-full border-2 border-black flex items-center justify-center mt-1"
                            >
                                <svg
                                    class="w-3.5 h-3.5 text-black"
                                    fill="none"
                                    stroke="currentColor"
                                    viewBox="0 0 24 24"
                                >
                                    <path
                                        stroke-linecap="round"
                                        stroke-linejoin="round"
                                        stroke-width="3"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <div>
                                <h4 class="text-lg font-bold text-black mb-1">
                                    Integrated Execution
                                </h4>
                                <p class="text-gray-600 text-sm font-medium">
                                    One team across comms, content, search and
                                    digital.
                                </p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Right Side: Dark Form Container -->
                <ContactForm theme="light" />
            </div>
        </div>
    </section>

    <!-- Footer -->

    <Fragment slot="scripts">
        <script is:inline src="/js/wp-insights.v2.js"></script>
        <script is:inline>
            // Fetch insights from WordPress REST API and render insight cards dynamically
            (async function () {
                const grid = document.getElementById("insight-grid");
                const emptyMsg = document.getElementById("insight-empty");
                if (!grid) return;

                let allArticles = [];
                let searchArticles = null;
                let currentFilter = "all";
                let searchTerm = "";
                let searchRequest = 0;
                let isSearching = false;
                const initialLoader = document.getElementById("insight-loading");
                if (initialLoader) initialLoader.classList.remove("hidden");
                try {
                    allArticles = await window.WPInsights.fetchIndex();
                } catch (e) {
                    console.error("Failed to load insights data:", e);
                    if (initialLoader) initialLoader.classList.add("hidden");
                    return;
                }
                if (initialLoader) initialLoader.classList.add("hidden");

                if (!allArticles.length) {
                    if (emptyMsg) emptyMsg.classList.remove("hidden");
                    return;
                }

                function capitalize(str) {
                    return String(str || "")
                        .split("-")
                        .map(function (w) {
                            return w.charAt(0).toUpperCase() + w.slice(1);
                        })
                        .join(" ");
                }

                function clientMatch(article, q) {
                    if (!q) return true;
                    const hay = (
                        (article.titleFull || "") +
                        " " +
                        ((article.titleParts || []).join(" "))
                    ).toLowerCase();
                    return hay.includes(q.toLowerCase());
                }

                function escHtml(s) {
                    return String(s || "")
                        .replace(/&/g, "&amp;")
                        .replace(/</g, "&lt;")
                        .replace(/>/g, "&gt;");
                }

                function highlightText(text, q) {
                    const safe = escHtml(text);
                    if (!q) return safe;
                    const escaped = String(q).replace(
                        /[.*+?^${}()|[\]\\]/g,
                        "\\$&",
                    );
                    return safe.replace(
                        new RegExp("(" + escaped + ")", "gi"),
                        '<mark class="search-highlight">$1</mark>',
                    );
                }

                function baseArticles() {
                    if (searchTerm && searchArticles) return searchArticles;
                    return allArticles;
                }

                function renderCards() {
                    const filtered = baseArticles().filter((a) => {
                        const catOk =
                            currentFilter === "all" ||
                            a.category === currentFilter;
                        const searchOk = clientMatch(a, searchTerm);
                        return catOk && searchOk;
                    });
                    grid.querySelectorAll(".insight-card").forEach((c) =>
                        c.remove(),
                    );
                    filtered.forEach((article, i) => {
                        const card = document.createElement("a");
                        card.href = "/blog-insights/" + article.slug;
                        card.setAttribute("data-category", article.category);
                        card.className =
                            "insight-card group interactive block rounded-2xl border border-white/[0.07] bg-white/[0.03] hover:bg-white/[0.07] hover:-translate-y-1.5 hover:border-white/25 transition-all duration-500 overflow-hidden relative";
                        card.style.transitionDelay = (i % 3) * 0.07 + "s";
                        card.innerHTML = `
                        <div class="w-full aspect-[16/10] overflow-hidden relative">
                            <img src="${article.image}" alt="${article.alt}"
                                class="w-full h-full object-cover grayscale contrast-110 group-hover:grayscale-0 group-hover:contrast-100 group-hover:scale-110 transition-all duration-700 ease-out">
                        </div>
                        <div class="p-6 pt-5">
                            <span class="text-[11px] font-bold uppercase tracking-widest text-gray-500 block mb-2.5">${capitalize(article.category)} • ${article.readTime.replace(/\s+/g, " ").trim()}</span>
                            <h4 class="text-sm sm:text-base md:text-base lg:text-base xl:text-lg font-bold tracking-tight text-white group-hover:text-white/80 transition-colors leading-snug mb-2.5">${highlightText(article.titleParts ? article.titleParts.join(" ") : article.titleFull, searchTerm)}</h4>
                            <span class="text-xs font-bold uppercase tracking-widest text-white/60 group-hover:text-white transition-colors">Read Article →</span>
                        </div>
                    `;
                        grid.appendChild(card);
                    });
                    const countEl = document.querySelector(".insight-count");
                    if (countEl) {
                        if (isSearching) {
                            countEl.textContent = "Searching...";
                        } else {
                            countEl.textContent =
                                filtered.length +
                                (filtered.length === 1
                                    ? " Insight"
                                    : " Insights");
                        }
                    }
                    if (emptyMsg) {
                        if (filtered.length === 0) {
                            emptyMsg.textContent = searchTerm
                                ? "No insights match your search."
                                : "No insights in this category yet - check back soon.";
                            emptyMsg.classList.remove("hidden");
                            grid.appendChild(emptyMsg);
                        } else {
                            emptyMsg.classList.add("hidden");
                        }
                    }
                    const newCards = Array.prototype.slice.call(
                        grid.querySelectorAll(".insight-card"),
                    );
                    if ("IntersectionObserver" in window) {
                        const io = new IntersectionObserver(
                            (entries) => {
                                entries.forEach((e) => {
                                    if (e.isIntersecting) {
                                        e.target.classList.add("in");
                                        io.unobserve(e.target);
                                    }
                                });
                            },
                            { threshold: 0.12, rootMargin: "0px 0px -8% 0px" },
                        );
                        newCards.forEach((c) => io.observe(c));
                    } else {
                        newCards.forEach((c) => c.classList.add("in"));
                    }
                }

                renderCards();

                const filterBar = document.getElementById("insight-filters");
                if (filterBar) {
                    const buttons = Array.prototype.slice.call(
                        filterBar.querySelectorAll(".insight-filter"),
                    );
                    buttons.forEach((btn) => {
                        btn.addEventListener("click", () => {
                            buttons.forEach((b) => {
                                b.classList.remove("active");
                                b.setAttribute("aria-selected", "false");
                            });
                            btn.classList.add("active");
                            btn.setAttribute("aria-selected", "true");
                            currentFilter = btn.getAttribute("data-filter");
                            renderCards();
                        });
                    });

                    // Search functionality (queries the WordPress backend)
                    const searchInput = document.getElementById("insight-search");
                    const searchSpinner = document.getElementById(
                        "insight-search-spinner",
                    );
                    const loadingOverlay = document.getElementById(
                        "insight-loading",
                    );
                    let searchTimer = null;
                    function setSearchLoading(loading) {
                        isSearching = loading;
                        if (searchSpinner)
                            searchSpinner.classList.toggle("hidden", !loading);
                        if (loadingOverlay)
                            loadingOverlay.classList.toggle("hidden", !loading);
                        const c = document.querySelector(".insight-count");
                        if (c) {
                            c.textContent = loading
                                ? "Searching..."
                                : c.textContent;
                        }
                    }
                    if (searchInput) {
                        async function executeSearch(value) {
                            searchTerm = value;
                            if (!value) {
                                searchArticles = null;
                                setSearchLoading(false);
                                renderCards();
                                return;
                            }
                            setSearchLoading(true);
                            const reqId = ++searchRequest;
                            try {
                                const results =
                                    await window.WPInsights.fetchIndex({
                                        search: value,
                                    });
                                if (reqId !== searchRequest) return;
                                searchArticles = Array.isArray(results)
                                    ? results
                                    : [];
                                setSearchLoading(false);
                                renderCards();
                                if (grid)
                                    grid.scrollIntoView({
                                        behavior: "smooth",
                                        block: "start",
                                    });
                            } catch (err) {
                                console.warn("Insight search failed:", err);
                                searchArticles = null;
                                setSearchLoading(false);
                                renderCards();
                            }
                        }

                        searchInput.addEventListener("input", () => {
                            clearTimeout(searchTimer);
                            const value = searchInput.value.trim();
                            searchTimer = setTimeout(() => {
                                executeSearch(value);
                            }, 300);
                        });

                        const searchBtn = document.getElementById("insight-search-btn");
                        if (searchBtn) {
                            searchBtn.addEventListener("click", () => {
                                executeSearch(searchInput.value.trim());
                            });
                        }

                        searchInput.addEventListener("keydown", (e) => {
                            if (e.key === "Enter") {
                                e.preventDefault();
                                clearTimeout(searchTimer);
                                executeSearch(searchInput.value.trim());
                            }
                        });

                        searchInput.addEventListener("focus", () => {
                            if (grid)
                                grid.scrollIntoView({
                                    behavior: "smooth",
                                    block: "start",
                                });
                        });
                    }

                    // Drag-to-scroll for filter bar with momentum
                    let isDown = false,
                        startX,
                        scrollLeft,
                        vel = 0;
                    let frame = null,
                        lastX = 0,
                        lastTime = 0;

                    function momentum() {
                        vel *= 0.95;
                        filterBar.scrollLeft -= vel;
                        if (Math.abs(vel) > 0.5) {
                            frame = requestAnimationFrame(momentum);
                        } else {
                            cancelAnimationFrame(frame);
                            frame = null;
                        }
                    }

                    function startDrag(pageX) {
                        isDown = true;
                        filterBar.classList.add("dragging");
                        cancelAnimationFrame(frame);
                        frame = null;
                        vel = 0;
                        startX = pageX;
                        lastX = pageX;
                        scrollLeft = filterBar.scrollLeft;
                        lastTime = performance.now();
                    }

                    function moveDrag(pageX) {
                        if (!isDown) return;
                        const now = performance.now();
                        const dt = Math.min(now - lastTime, 50);
                        const dx = pageX - lastX;
                        if (dt > 0) {
                            vel = vel * 0.6 + (dx / dt) * 16 * 0.4;
                        }
                        filterBar.scrollLeft -= dx * 2.5;
                        lastX = pageX;
                        lastTime = now;
                    }

                    function endDrag() {
                        isDown = false;
                        filterBar.classList.remove("dragging");
                        if (Math.abs(vel) > 0.5) {
                            frame = requestAnimationFrame(momentum);
                        }
                    }

                    filterBar.addEventListener("mousedown", (e) => {
                        startDrag(e.pageX);
                        e.preventDefault();
                    });
                    filterBar.addEventListener("mousemove", (e) => {
                        moveDrag(e.pageX);
                    });
                    filterBar.addEventListener("mouseup", endDrag);
                    filterBar.addEventListener("mouseleave", endDrag);
                    filterBar.addEventListener(
                        "touchstart",
                        (e) => {
                            startDrag(e.touches[0].pageX);
                        },
                        { passive: true },
                    );
                    filterBar.addEventListener(
                        "touchmove",
                        (e) => {
                            moveDrag(e.touches[0].pageX);
                        },
                        { passive: true },
                    );
                    filterBar.addEventListener("touchend", endDrag);
                }
            })();
        </script>
    </Fragment>
</BaseLayout>
