---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
    title="ChimpzLab | Real Estate Marketing Specialists"
    description="India's Integrated Real Estate Marketing Partner"
    canonical="/real-estate"
    hideHeader={false}
    hideFooter={true}
>
<Fragment slot="head">
<!-- Google Fonts: Manrope for a sleek, modern agency look -->
    
    
    

    <!-- Phosphor Icons -->
    

    <!-- Lenis for Smooth Scrolling -->
    

    <!-- Tailwind CSS via CDN -->
    
    
    <style is:inline>
        /* Custom Styles & Utilities */
        body {
            background-color: #0a0a0a;
            color: #F3F4F6;
        }

        .glass-nav {
            background: rgba(10, 10, 10, 0.8);
            backdrop-filter: blur(12px);
            border-bottom: 1px solid rgba(255, 255, 255, 0.05);
        }

        .nav-pill {
            background-color: rgba(26, 26, 26, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.05);
        }

        .gradient-text {
            background: linear-gradient(to right, #ffffff, #9ca3af);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .gradient-accent {
            background: #ffffff;
            color: #000000;
        }

        /* Lenis Smooth Scroll */
        html.lenis {
            height: auto;
        }

        .lenis.lenis-smooth {
            scroll-behavior: auto !important;
        }

        .lenis.lenis-stopped {
            overflow: hidden;
        }

        .lenis.lenis-scrolling iframe {
            pointer-events: none;
        }

        /* FAQ Accordion Transitions */
        .faq-answer {
            display: grid;
            grid-template-rows: 0fr;
            transition: grid-template-rows 0.3s ease;
        }

        .faq-answer.open {
            grid-template-rows: 1fr;
        }

        .faq-answer>div {
            overflow: hidden;
        }

        .faq-item {
            transition: border-color 0.3s ease, box-shadow 0.3s ease;
        }

        .faq-item:hover {
            border-color: #d1d5db;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
        }

        .faq-item.is-open {
            border-color: #9ca3af;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        }

        .faq-toggle .faq-icon {
            width: 1.5rem;
            height: 1.5rem;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9999px;
            font-size: 1rem;
            transition: transform 0.3s ease, color 0.3s ease, background-color 0.3s ease;
        }

        .faq-toggle:hover .faq-icon {
            color: #000000;
        }

        .faq-toggle:focus-visible {
            outline: 2px solid #000000;
            outline-offset: -2px;
            border-radius: 0.75rem;
        }

        .faq-question {
            transition: color 0.3s ease;
        }

        .faq-item.is-open .faq-question {
            color: #000000;
        }

        /* Progress Bar Animation */
        .progress-bar-fill {
            width: 0%;
            transition: width 2s cubic-bezier(0.22, 1, 0.36, 1);
        }

        .bg-white ::selection,
        .bg-gray-50 ::selection {
            background-color: #374151 !important;
            color: #ffffff !important;
        }
    </style>

    <style is:inline>
        ::selection {
            background-color: white;
            color: black;
        }

        @media (pointer: fine) {
            body {
                cursor: none;
            }

            .custom-cursor {
                position: fixed;
                top: 0;
                left: 0;
                width: 16px;
                height: 16px;
                background-color: white;
                border-radius: 50%;
                pointer-events: none;
                z-index: 99999;
                transform: translate(-50%, -50%);
                mix-blend-mode: difference;
                transition: width 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), height 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275), background-color 0.2s;
            }

            .custom-cursor.hovering {
                width: 80px;
                height: 80px;
                background-color: #ffffff;
                filter: grayscale(100%);
            }
        }

        .bg-white ::selection,
        .bg-gray-50 ::selection {
            background-color: #374151 !important;
            color: #ffffff !important;
        }

        /* Mobile menu overlay (matches the rest of the site) */
        body.menu-open {
            overflow: hidden;
        }

        .mobile-menu-overlay {
            position: fixed;
            inset: 0;
            z-index: 9990;
            background: rgba(0, 0, 0, 0.6);
            backdrop-filter: blur(4px);
            -webkit-backdrop-filter: blur(4px);
            opacity: 0;
            visibility: hidden;
            transition: opacity 0.35s ease, visibility 0.35s ease;
        }

        .mobile-menu-overlay.open {
            opacity: 1;
            visibility: visible;
        }

        .mobile-menu-panel {
            position: absolute;
            top: 0;
            right: 0;
            height: 100%;
            width: min(82vw, 360px);
            background: #0c0f0f;
            border-left: 1px solid rgba(255, 255, 255, 0.08);
            padding: 24px 24px 40px;
            display: flex;
            flex-direction: column;
            transform: translateX(100%);
            transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            overflow-y: auto;
            z-index: 9991;
        }

        .mobile-menu-overlay.open .mobile-menu-panel {
            transform: translateX(0);
        }

        .mobile-menu-head {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 32px;
        }

        .mobile-menu-logo {
            color: #fff;
            font-weight: 800;
            font-size: 1.25rem;
            letter-spacing: -0.02em;
        }

        .mobile-menu-close {
            background: transparent;
            border: none;
            color: #fff;
            font-size: 2rem;
            line-height: 1;
            cursor: pointer;
            padding: 4px 8px;
        }

        .mobile-menu-nav {
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .mobile-menu-link,
        .mobile-menu-toggle {
            display: flex;
            align-items: center;
            justify-content: space-between;
            color: #e2e2e2;
            font-size: 1.05rem;
            font-weight: 600;
            padding: 14px 4px;
            border-bottom: 1px solid rgba(255, 255, 255, 0.06);
            background: transparent;
            border-left: none;
            border-right: none;
            border-top: none;
            width: 100%;
            text-align: left;
            cursor: pointer;
        }

        .mobile-menu-link:hover,
        .mobile-menu-toggle:hover {
            color: #fff;
        }

        .mobile-menu-cta {
            margin-top: 24px;
            text-align: center;
            background: #fff;
            color: #000;
            font-weight: 700;
            font-size: 0.95rem;
            letter-spacing: 0.02em;
            padding: 14px;
            border-radius: 9999px;
        }

        .mobile-menu-cta:hover {
            background: #e5e5e5;
        }
    </style>

    <script is:inline src="https://www.google.com/recaptcha/api.js" async defer></script>
</Fragment>


    <!-- SECTION 2: HERO -->
    <section
        class="relative pt-24 lg:pt-32 pb-12 overflow-hidden bg-[#0a0a0a] min-h-[100vh] flex flex-col justify-center">
        <!-- Desktop Background Hero Image -->
        <div
            class="hidden lg:flex absolute bottom-0 right-0 w-full lg:w-[50%] h-[85vh] z-0 pointer-events-none items-end justify-end">
            <img src="/asset/real-estate-potrait-2.png" alt="Real Estate Marketing"
                class="w-full h-full object-contain object-bottom">
            <!-- Fade/Blend Gradients -->
            <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#0a0a0a] via-[#0a0a0a]/50 to-transparent"></div>
        </div>

        <div class="w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10 text-left">
            <div class="lg:w-3/5">
                <!-- Top Badge -->
                <div
                    class="inline-flex items-center gap-2 px-4 py-2 rounded-full border border-gray-800 bg-gray-900/50 backdrop-blur-sm mb-6 justify-start">
                    <span class="relative flex h-2.5 w-2.5">
                        <span
                            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"></span>
                        <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
                    </span>
                    <span class="text-xs font-medium text-gray-300 tracking-wide uppercase">Real Estate Marketing
                        Specialists &middot; SEO &middot; Ads &middot; Lead Qualification</span>
                </div>

                <!-- Micro-tag & Headline -->
                <p class="text-brand-accent font-semibold tracking-wider text-sm mb-4 uppercase">India's Integrated Real
                    Estate Marketing Partner</p>

                <h1 class="text-5xl md:text-7xl lg:text-7xl font-extrabold tracking-tighter mb-6 leading-[1.1]">
                    <span class="block text-gray-500">YOUR BUYERS ARE SEARCHING.</span>
                    <span class="block text-white">YOUR COMPETITION IS RANKING.</span>
                </h1>

                <!-- Sub-line -->
                <p class="mt-6 max-w-3xl text-base md:text-lg text-gray-400 leading-relaxed mb-8">
                    ChimpzLab helps real estate developers across Mumbai MMR, Delhi NCR, Chennai, and Bengaluru dominate
                    search rankings, run zero-waste ad campaigns, and fill sales pipelines with buyers who <em
                        class="text-gray-200 not-italic font-medium">actually show up</em> for site visits.
                </p>

                <!-- CTA Pair -->
                <div class="flex flex-col sm:flex-row items-center justify-start gap-4">
                    <a href="#contact"
                        class="w-full sm:w-auto px-6 py-3 rounded-full text-sm font-semibold text-black bg-white shadow-lg transition-all transform hover:-translate-y-0.5">
                        Get Free Audit
                    </a>
                    <a href="#how-we-work"
                        class="w-full sm:w-auto px-6 py-3 rounded-full text-sm font-semibold text-white border border-gray-700 bg-transparent hover:bg-gray-800 transition-colors flex items-center justify-center gap-2">
                        See How It Works <i class="ph ph-arrow-down"></i>
                    </a>
                </div>
            </div>

            <!-- Mobile Hero Image -->
            <div class="block lg:hidden mt-12 w-full relative">
                <img src="/asset/real-estate-potrait-2.png" alt="Real Estate Marketing"
                    class="w-full max-w-md mx-auto object-contain object-bottom border-b-0">
                <!-- Fade/Blend Gradient -->
                <div
                    class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-[#0a0a0a]/20 to-transparent pointer-events-none">
                </div>
            </div>
        </div>
    </section>

    <!-- SECTION 3: THE PROBLEM STRIP -->
    <section id="the-problem" class="border-y border-gray-200 bg-white selection:bg-black selection:text-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20">
            <div
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 divide-y md:divide-y-0 md:divide-x divide-gray-200">

                <div class="px-4 text-center md:text-left flex flex-col justify-center">
                    <p class="text-4xl lg:text-5xl font-bold text-black mb-2 tracking-tight">₹3-8L<span
                            class="text-2xl text-gray-500 font-medium">/mo</span></p>
                    <p class="text-sm text-gray-600 font-medium">Typical portal spend producing mostly junk leads</p>
                </div>

                <div class="px-4 text-center md:text-left flex flex-col justify-center pt-8 md:pt-0">
                    <p class="text-4xl lg:text-5xl font-bold text-black mb-2 tracking-tight">Page 3+</p>
                    <p class="text-sm text-gray-600 font-medium">Where most developer websites sit on Google for their
                        own project keywords</p>
                </div>

                <div class="px-4 text-center md:text-left flex flex-col justify-center pt-8 md:pt-0">
                    <p class="text-4xl lg:text-5xl font-bold text-gray-700 mb-2 tracking-tight">80%+</p>
                    <p class="text-sm text-gray-600 font-medium">Of portal enquiries that never convert to a site visit
                    </p>
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 4: HOW WE ACTUALLY WORK -->
    <section id="how-we-work" class="py-24 relative">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <!-- Section Header -->
            <div class="max-w-3xl mb-20">
                <span class="text-brand-accent font-semibold tracking-wider text-sm uppercase mb-3 block">Our
                    Framework</span>
                <h2 class="text-4xl md:text-5xl font-bold text-white mb-6 tracking-tight">WE DON'T RUN CAMPAIGNS.<br>WE
                    BUILD SYSTEMS.</h2>
                <p class="text-lg text-gray-400">
                    Any agency can run Google Ads and hand over a spreadsheet. We built an integrated system where
                    search visibility, paid acquisition, and lead verification work as one connected engine, not three
                    separate vendor relationships.
                </p>
            </div>

            <div class="space-y-32">
                <!-- Phase 1 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <div>
                        <div
                            class="inline-block px-3 py-1 rounded bg-gray-800 text-gray-300 text-sm font-semibold mb-6">
                            Phase 1 &mdash; SEO / AEO</div>
                        <h3 class="text-3xl font-bold text-white mb-6">Own the search results your buyers actually use.
                        </h3>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            We map every micro-market keyword in your target geography: "2BHK Thane West under 1 crore,"
                            "luxury penthouse Bandra sea-facing," "plots near Dwarka Expressway." Then we build a
                            content and technical architecture that gets your project ranking for those exact searches
                            before your competition does. Not vanity keywords. The searches that produce walk-ins.
                        </p>
                        <div class="border-l-4 border-brand-accent pl-4">
                            <p class="text-white font-medium">Over <span
                                    class="text-brand-accent font-bold">12,500+</span> micro-market keywords ranked on
                                Page 1 across real estate clients.</p>
                        </div>
                    </div>
                    <div class="relative bg-brand-card rounded-2xl border border-gray-800 p-8 shadow-2xl">
                        <!-- Mockup of Search Results -->
                        <div class="space-y-4">
                            <div
                                class="flex items-center gap-3 bg-gray-900 rounded-full px-4 py-3 border border-gray-700">
                                <i class="ph ph-magnifying-glass text-gray-400 text-xl"></i>
                                <span class="text-gray-300 text-sm font-medium">2BHK Thane West under 1 crore</span>
                            </div>
                            <div class="bg-gray-800/50 rounded-xl p-5 border border-gray-700 mt-6">
                                <p class="text-xs text-gray-400 mb-1">Sponsored</p>
                                <p class="text-gray-300 font-medium text-lg hover:underline cursor-pointer">Premium
                                    2BHKs in Thane | Portal Name</p>
                                <p class="text-sm text-gray-500 mt-1">Portal generic listing. Broad targeting. Low
                                    intent.</p>
                            </div>
                            <div
                                class="bg-gray-900 rounded-xl p-5 border border-brand-accent/50 shadow-[0_0_15px_rgba(59,130,246,0.15)] relative overflow-hidden">
                                <div class="absolute top-0 left-0 w-1 h-full bg-brand-accent"></div>
                                <p class="text-xs text-brand-accent mb-1 flex items-center gap-1"><i
                                        class="ph-fill ph-check-circle"></i> Organic Result #1</p>
                                <p class="text-gray-300 font-medium text-lg hover:underline cursor-pointer">Project Name
                                    | 2BHK under ₹1Cr in Thane West</p>
                                <p class="text-sm text-gray-300 mt-1">Direct developer link. High intent. Zero cost per
                                    click.</p>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Phase 2 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <div class="order-2 lg:order-1">
                        <!-- Custom Visual: Junk vs Verified -->
                        <div class="grid grid-cols-2 gap-4 mb-8">
                            <!-- Left: Junk -->
                            <div
                                class="bg-[#1a0f0f] border border-red-900/50 rounded-2xl p-6 relative overflow-hidden group">
                                <div
                                    class="absolute top-0 right-0 p-3 opacity-20 group-hover:opacity-100 transition-opacity">
                                    <i class="ph-fill ph-x-circle text-red-900/40 text-2xl"></i>
                                </div>
                                <h4 class="text-red-400 font-semibold mb-4 flex items-center gap-2"><i
                                        class="ph ph-trash"></i> Junk Leads</h4>
                                <ul class="space-y-3 text-sm text-gray-400">
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-phone-x mt-0.5 text-red-500/70 text-lg"></i> Wrong number</li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-eye mt-0.5 text-red-500/70 text-lg"></i> Just browsing</li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-briefcase mt-0.5 text-red-500/70 text-lg"></i> Brokers</li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-wallet mt-0.5 text-red-500/70 text-lg"></i> Budget mismatch
                                    </li>
                                </ul>
                            </div>
                            <!-- Right: Verified -->
                            <div
                                class="bg-[#0a1510] border border-emerald-900/50 rounded-2xl p-6 relative overflow-hidden group">
                                <div
                                    class="absolute top-0 right-0 p-3 opacity-20 group-hover:opacity-100 transition-opacity">
                                    <i class="ph-fill ph-check-circle text-emerald-900/40 text-2xl"></i>
                                </div>
                                <h4 class="text-emerald-400 font-semibold mb-4 flex items-center gap-2"><i
                                        class="ph ph-shield-check"></i> Verified Leads</h4>
                                <ul class="space-y-3 text-sm text-gray-300">
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-phone-call mt-0.5 text-emerald-500/70 text-lg"></i>
                                        Call-confirmed</li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-coins mt-0.5 text-emerald-500/70 text-lg"></i> Budget matched
                                    </li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-calendar-check mt-0.5 text-emerald-500/70 text-lg"></i>
                                        Timeline confirmed</li>
                                    <li class="flex items-start gap-3"><i
                                            class="ph ph-map-pin mt-0.5 text-emerald-500/70 text-lg"></i> Site-visit
                                        ready</li>
                                </ul>
                            </div>
                        </div>

                        <!-- Lead Quality Bar -->
                        <div class="bg-[#111111] border border-gray-800 rounded-2xl p-8">
                            <div class="flex justify-between items-end mb-4">
                                <span class="text-sm font-bold text-white">Lead quality score across ChimpzLab
                                    clients</span>
                                <span class="text-3xl font-bold text-emerald-400" id="quality-score-value">0%</span>
                            </div>
                            <div class="w-full bg-gray-800 rounded-full h-3 mb-4 overflow-hidden relative">
                                <div class="absolute left-[25%] top-0 bottom-0 w-[1px] bg-gray-500 z-10"></div>
                                <div class="absolute left-[25%] -top-5 text-[10px] text-gray-500 z-10 hidden sm:block">
                                    Portal Avg ~25%</div>
                                <div class="bg-emerald-400 h-3 rounded-full progress-bar-fill" id="quality-progress"
                                    data-target="88"></div>
                            </div>
                            <p class="text-xs text-gray-400">Industry average from portals: ~20-25% &middot; Our
                                clients: 88%+</p>
                        </div>
                    </div>

                    <div class="order-1 lg:order-2">
                        <div
                            class="inline-block px-3 py-1 rounded bg-gray-800 text-gray-300 text-sm font-semibold mb-6">
                            Phase 2 &mdash; Google Ads + Lead Verification
                        </div>
                        <h3 class="text-3xl font-bold text-white mb-6">Every lead is called before it reaches your sales
                            team.</h3>
                        <p class="text-gray-400 text-lg mb-6 leading-relaxed">
                            We run hyper-targeted Google Ads using income signals, neighbourhood intent, and search
                            behaviour, not generic interest categories.
                        </p>
                        <p class="text-gray-400 text-lg leading-relaxed">
                            Then the layer that makes us different: <strong class="text-white font-medium">every ad
                                enquiry is called within 30 minutes.</strong> We confirm budget, location preference,
                            and purchase timeline before the lead enters your CRM. Your sales team talks only to buyers,
                            never to brokers, wrong numbers, or "just browsing" clicks.
                        </p>
                    </div>
                </div>

                <!-- Phase 3 -->
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
                    <div>
                        <div
                            class="inline-block px-3 py-1 rounded bg-gray-800 text-gray-300 text-sm font-semibold mb-6">
                            Phase 3 &mdash; PR &middot; Social &middot; Thought Leadership</div>
                        <h3 class="text-3xl font-bold text-white mb-6">Your brand should be trusted before buyers even
                            call.</h3>
                        <p class="text-gray-400 text-lg mb-8 leading-relaxed">
                            We build the developer's credibility layer: corporate social media that positions the brand,
                            LinkedIn thought leadership for the directors and founders, PR coverage that establishes
                            market authority, and presentation design for investor and channel partner communication.
                            When a buyer searches your company name, what they find should close the trust gap before
                            your sales team picks up the phone.
                        </p>
                        <div class="border-l-4 border-brand-accent pl-4">
                            <p class="text-white font-medium"><span class="text-brand-accent font-bold">40M+</span>
                                impressions & <span class="text-brand-accent font-bold">120%</span> follower growth
                                across managed real estate social accounts.</p>
                        </div>
                    </div>

                    <div class="grid grid-cols-2 gap-4">
                        <div
                            class="bg-brand-card border border-gray-800 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:border-gray-600/50 transition-colors">
                            <i class="ph ph-linkedin-logo text-4xl text-gray-300 mb-4"></i>
                            <h5 class="text-white font-semibold mb-1">Director Branding</h5>
                            <p class="text-xs text-gray-400">Thought leadership</p>
                        </div>
                        <div
                            class="bg-brand-card border border-gray-800 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:border-gray-600/50 transition-colors">
                            <i class="ph ph-article text-4xl text-gray-300 mb-4"></i>
                            <h5 class="text-white font-semibold mb-1">PR & Media</h5>
                            <p class="text-xs text-gray-400">Market authority</p>
                        </div>
                        <div
                            class="bg-brand-card border border-gray-800 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:border-gray-600/50 transition-colors">
                            <i class="ph ph-instagram-logo text-4xl text-gray-300 mb-4"></i>
                            <h5 class="text-white font-semibold mb-1">Social Media</h5>
                            <p class="text-xs text-gray-400">Community building</p>
                        </div>
                        <div
                            class="bg-brand-card border border-gray-800 rounded-xl p-6 flex flex-col justify-center items-center text-center hover:border-gray-600/50 transition-colors">
                            <i class="ph ph-presentation-chart text-4xl text-gray-300 mb-4"></i>
                            <h5 class="text-white font-semibold mb-1">Corp Comms</h5>
                            <p class="text-xs text-gray-400">Investor decks</p>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </section>

    <!-- SECTION 5: WHAT CHANGES -->
    <section class="py-24 bg-white selection:bg-black selection:text-white border-y border-gray-200">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
            <div class="text-center mb-16">
