---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Corporate Communications and PR Agency in Thane | ChimpzLab"
    description="ChimpzLab manages brand reputation through PR, corporate communications, thought leadership, and employer branding that builds trust and authority."
    canonical="/services/reputation-communications"
    hideHeader={false}
    hideFooter={false}
>
<Fragment slot="head">
<!-- Fonts: Manrope -->
    
    
    

    <!-- Tailwind CSS -->
    

    <!-- GSAP for Animations -->
    
    

    <!-- Lenis for Smooth Scrolling -->
</Fragment>


    <!-- Hero Section -->
    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Reputation &
                    Communications</span>
            </div>

            <h1
                class="text-4xl sm:text-6xl md:text-[6rem] lg:text-8xl md:max-w-[800px] font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Credibility is built in layers.</span>
                </div>
                <div class="overflow-hidden"><span class="block gsap-reveal-text text-white/40">Trust is protected in
                        real time.</span></div>
            </h1>

            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
                                Agenda</span>
                            <span class="text-sm font-medium text-gray-400 whitespace-nowrap leading-tight">30 minutes.
                                No pitch deck. Just finding your reputation gaps.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Intro Section (Image + Content) -->
    <section class="px-0 md:px-12 bg-white text-brand-dark border-t border-gray-200">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
                <!-- Left: Image (full height, touching bottom) -->
                <div class="lg:col-span-6 order-2 lg:order-none gsap-reveal">
                    <div class="relative h-full overflow-hidden md:mr-12">
                        <img src="/services/image/reputation-and-communication.png" alt="Corporate Communications"
                            class="w-full h-full object-contain object-bottom min-h-[300px] lg:min-h-full">

                    </div>
                </div>

                <!-- Right: Content -->
                <div class="lg:col-span-6 order-1 lg:order-none py-16 md:py-24 px-6 md:px-0 gsap-reveal">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-[1px] bg-gray-300"></div>
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our
                            Approach</span>
                    </div>

                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8">
                        ChimpzLab is a corporate communications agency in Thane that runs public relations, thought
                        leadership, employer branding and reputation management as one connected practice, not four
                        vendors you have to keep in sync yourself.
                    </p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8">
                        Most companies end up with a press team saying one thing, a hiring page saying another, and
                        leadership posting something else entirely. We fix that at the root. One narrative, agreed once,
                        then carried consistently across media, employees, partners and the wider market.
                    </p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-10">
                        The result is an organisation that reads the same no matter who is looking, whether that is a
                        journalist, a candidate, or a customer deciding if you are worth the risk.
                    </p>

                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-brand-dark hover:bg-gray-800 text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section (Sticky Scroll Layout) -->
    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white relative border-t border-white/10">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 relative items-start">

                <!-- Left: Pinned Header -->
