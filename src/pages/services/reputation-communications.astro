                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50 mb-6 block">Our
                        Services</span>
                    <h2
                        class="text-4xl sm:text-5xl md:text-7xl lg:text-5xl xl:text-6xl font-extrabold leading-[0.95] tracking-tighter uppercase">
                        Reputation and<br>Communications<br>Services
                    </h2>
                </div>

                <!-- Right: Scrolling Items -->
                <div class="lg:col-span-7 space-y-6 md:space-y-8 min-w-0 services-list">
                    <!-- Card 1 -->
                    <a href="/services/reputation-communications/corporate-communications-agency-in-thane"
                        class="block bg-white/5 border border-white/10 p-8 md:p-10 rounded-2xl opacity-0 translate-y-8 group hover:border-white/30 transition-[border-color] duration-300">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="text-4xl text-white/30 font-extrabold">01</div>
                            <div class="w-8 h-[1px] bg-white/30"></div>
                        </div>
                        <h3 class="text-xl md:text-3xl font-extrabold text-white mb-3 leading-tight tracking-tight">
                            Corporate Communications</h3>
                        <p class="text-base md:text-xl font-light leading-relaxed text-gray-400 max-w-2xl">One version
                            of your story, held together across media, employees, partners and regulators, instead of a
                            different answer depending on who is asking. Includes: messaging frameworks, leadership
                            positioning, internal communications, crisis-readiness, executive communication support.</p>
                    </a>
                    <!-- Card 2 -->
                    <a href="/services/reputation-communications/public-relations-agency-in-thane"
                        class="block bg-white/5 border border-white/10 p-8 md:p-10 rounded-2xl opacity-0 translate-y-8 group hover:border-white/30 transition-[border-color] duration-300">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="text-4xl text-white/30 font-extrabold">02</div>
                            <div class="w-8 h-[1px] bg-white/30"></div>
                        </div>
                        <h3 class="text-xl md:text-3xl font-extrabold text-white mb-3 leading-tight tracking-tight">
                            Public Relations</h3>
                        <p class="text-base md:text-xl font-light leading-relaxed text-gray-400 max-w-2xl">Coverage that
                            positions you as a credible voice in your field, not a company that only appears when it
                            pushes out a release. Includes: media relations and press outreach, launch PR, spokesperson
                            media training, award and speaking placements.</p>
                    </a>
                    <!-- Card 3 -->
                    <a href="/services/reputation-communications/thought-leadership-agency-in-thane"
                        class="block bg-white/5 border border-white/10 p-8 md:p-10 rounded-2xl opacity-0 translate-y-8 group hover:border-white/30 transition-[border-color] duration-300">
                        <div class="flex items-center gap-4 mb-4">
                            <div class="text-4xl text-white/30 font-extrabold">03</div>
                            <div class="w-8 h-[1px] bg-white/30"></div>
                        </div>
                        <h3 class="text-xl md:text-3xl font-extrabold text-white mb-3 leading-tight tracking-tight">
                            Thought Leadership</h3>
                        <p class="text-base md:text-xl font-light leading-relaxed text-gray-400 max-w-2xl">Your leaders
                            know things worth hearing. We get that thinking out of the boardroom and into the bylines,
                            panels and feeds your buyers and investors already follow. Includes: ghostwritten bylines
                            and op-eds, LinkedIn executive presence, speaking opportunities, industry commentary.</p>
                    </a>
                    <!-- Card 4 -->
                    <a href="/services/reputation-communications/employer-branding-agency-in-thane"
