---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Landing Page Project Portfolio | ChimpzLab"
    description="Explore ChimpzLab's landing page projects - high-converting, mobile-optimised pages built for lead generation across real estate, tech, and healthcare."
    canonical="/services/digital-experiences/landing-page-project"
    hideHeader={false}
    hideFooter={false}
>

    <header
        class="min-h-[50vh] flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Landing Page
                    Projects</span>
            </div>
            <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Our Featured Landing Page
                        Projects</span></div>
            </h1>
        </div>
    </header>

    <section class="px-4 sm:px-6 md:px-12 py-12 md:py-16 bg-brand-dark text-white border-t border-white/10">
        <div class="max-w-[1400px] mx-auto">
            <div id="filter-bar"
                class="flex flex-wrap gap-3 mb-12 py-2 backdrop-blur-md bg-brand-dark/80 -mx-2 px-2 rounded-xl sticky top-24 z-40">
            </div>
            <div id="project-grid"
                data-projects-json="/services/digital-experiences/landing-pages-case-studies.json"
                class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
            </div>
            <p id="cs-empty" class="hidden text-center text-white/40 py-20 text-lg">No projects in this category yet.
            </p>
        </div>
    </section>

<Fragment slot="scripts">
    <script is:inline src="/services/digital-experiences/website-design-projects.js" defer></script>
</Fragment>
</BaseLayout>
