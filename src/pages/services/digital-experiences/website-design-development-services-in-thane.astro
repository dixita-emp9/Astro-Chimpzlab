---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsLoader from '../../../components/InsightsLoader.astro';

import ContactForm from '../../../components/sections/ContactForm.astro';
import Testimonials from '../../../components/Testimonials.tsx';

---
<BaseLayout
    title="Website Design and Development Agency in Thane | ChimpzLab"
    description="ChimpzLab builds fast, responsive websites - from corporate sites to e-commerce and landing pages - designed for performance, conversions, and brand impact."
    canonical="/services/digital-experiences/website-design-development-services-in-thane"
    hideHeader={false}
    hideFooter={false}
>

    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Website Design and
                    Development</span>
            </div>
            <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Websites built around conversion, not
                        just appearance</span></div>
            </h1>
            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
                                Agenda</span>
                            <span class="text-sm font-medium text-gray-400 leading-tight">30 minutes. Aligning your
                                corporate narrative.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="px-0 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
                <div class="lg:col-span-6 order-2 lg:order-none gsap-reveal">
                    <div class="relative h-full overflow-hidden md:mr-12">
                        <img src="/services/image/digital-experiences/website-strategy.png" alt="Website Design Development"
                            class="w-full h-full object-contain object-bottom min-h-[300px] lg:min-h-full">
                    </div>
                </div>
                <div class="lg:col-span-6 order-1 lg:order-none py-16 md:py-24 lg:py-32 px-6 md:px-0 gsap-reveal">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-[1px] bg-gray-300"></div>
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our
                            Approach</span>
                    </div>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8 max-w-3xl">Website
                        design and development here means building a site around specific conversion goals, from UX
                        through to launch, rather than redesigning for the sake of a fresh look. A site that looks
                        better but converts the same is not a win. We design and build around what you actually need
                        visitors to do.</p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-10 max-w-3xl">Speed,
                        clarity and structure carry as much weight as the visuals. A fast, clear site earns trust and
                        gets found. A slow, pretty one loses both.</p>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-brand-dark hover:bg-gray-800 text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">What This Includes</span>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16">
                <div class="lg:col-span-5 gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl font-extrabold tracking-tighter uppercase leading-[0.9]">
                        Everything you get</h2>
                </div>
                <div class="lg:col-span-7 gsap-reveal">
                    <p class="text-lg md:text-xl text-gray-400 font-light max-w-xl leading-relaxed">Every message is
                        crafted to build trust and authority across all your stakeholder groups.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-5 gap-4 md:gap-5">

                <div class="md:col-span-3 group relative">
                    <div
                        class="h-full bg-white/[0.03] border border-white/10 rounded-2xl p-10 md:p-12 hover:bg-white/[0.06] hover:border-white/20 transition-all duration-500">
                        <div class="flex items-start gap-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-all duration-500">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <p
                                class="text-gray-300 font-medium text-base md:text-lg leading-relaxed group-hover:text-white transition-colors duration-500">
                                UX and UI design</p>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-2 group relative">
                    <div
                        class="h-full bg-white/[0.03] border border-white/10 rounded-2xl p-10 md:p-12 hover:bg-white/[0.06] hover:border-white/20 transition-all duration-500">
                        <div class="flex items-start gap-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-all duration-500">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <p
                                class="text-gray-300 font-medium text-base md:text-lg leading-relaxed group-hover:text-white transition-colors duration-500">
                                Custom development</p>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-2 group relative">
                    <div
                        class="h-full bg-white/[0.03] border border-white/10 rounded-2xl p-10 md:p-12 hover:bg-white/[0.06] hover:border-white/20 transition-all duration-500">
                        <div class="flex items-start gap-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-all duration-500">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <p
                                class="text-gray-300 font-medium text-base md:text-lg leading-relaxed group-hover:text-white transition-colors duration-500">
                                CMS builds on WordPress, Shopify or headless</p>
                        </div>
                    </div>
                </div>
                <div class="md:col-span-3 group relative">
                    <div
                        class="h-full bg-white/[0.03] border border-white/10 rounded-2xl p-10 md:p-12 hover:bg-white/[0.06] hover:border-white/20 transition-all duration-500">
                        <div class="flex items-start gap-5">
                            <div
                                class="w-10 h-10 rounded-xl bg-white/10 flex items-center justify-center shrink-0 group-hover:bg-white/20 transition-all duration-500">
                                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M5 13l4 4L19 7"></path>
                                </svg>
                            </div>
                            <p
                                class="text-gray-300 font-medium text-base md:text-lg leading-relaxed group-hover:text-white transition-colors duration-500">
                                Performance and speed optimisation</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-32 px-6 md:px-12 bg-white text-brand-dark border-t border-gray-200 overflow-hidden">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-gray-300"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our Process</span>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16">
                <div class="lg:col-span-5 gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl lg:text-5xl xl:text-6xl font-extrabold tracking-tighter uppercase leading-[0.9]">
                        How it works</h2>
                </div>
                <div class="lg:col-span-7 gsap-reveal">
                    <p class="text-lg md:text-xl text-gray-500 font-light max-w-xl leading-relaxed">A strategic approach
                        to unifying your corporate voice and messaging framework.</p>
                </div>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8 md:gap-6 relative process-grid">

                <div class="gsap-reveal relative process-step">
                    <div
                        class="bg-white rounded-2xl p-7 shadow-[0_4px_24px_rgba(0,0,0,0.06)] hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 text-center md:text-left">
                        <div
                            class="w-14 h-14 rounded-2xl bg-brand-dark text-white flex items-center justify-center mx-auto md:mx-0 mb-5 text-xl font-extrabold shadow-lg relative z-10">
                            01</div>
                        <div class="relative">
                            <div class="w-12 h-[2px] bg-gray-200 mx-auto md:mx-0 mb-5"></div>
                            <p class="text-gray-700 font-medium text-base md:text-lg leading-relaxed">UX and technical
                                audit</p>
                        </div>
                    </div>
                </div>
                <div class="gsap-reveal relative process-step">
                    <div
                        class="bg-white rounded-2xl p-7 shadow-[0_4px_24px_rgba(0,0,0,0.06)] hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 text-center md:text-left">
                        <div
                            class="w-14 h-14 rounded-2xl bg-brand-dark text-white flex items-center justify-center mx-auto md:mx-0 mb-5 text-xl font-extrabold shadow-lg relative z-10">
                            02</div>
                        <div class="relative">
                            <div class="w-12 h-[2px] bg-gray-200 mx-auto md:mx-0 mb-5"></div>
                            <p class="text-gray-700 font-medium text-base md:text-lg leading-relaxed">Design and
                                prototyping</p>
                        </div>
                    </div>
                </div>
                <div class="gsap-reveal relative process-step">
                    <div
                        class="bg-white rounded-2xl p-7 shadow-[0_4px_24px_rgba(0,0,0,0.06)] hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 text-center md:text-left">
                        <div
                            class="w-14 h-14 rounded-2xl bg-brand-dark text-white flex items-center justify-center mx-auto md:mx-0 mb-5 text-xl font-extrabold shadow-lg relative z-10">
                            03</div>
                        <div class="relative">
                            <div class="w-12 h-[2px] bg-gray-200 mx-auto md:mx-0 mb-5"></div>
                            <p class="text-gray-700 font-medium text-base md:text-lg leading-relaxed">Development and
                                build</p>
                        </div>
                    </div>
                </div>
                <div class="gsap-reveal relative process-step">
                    <div
                        class="bg-white rounded-2xl p-7 shadow-[0_4px_24px_rgba(0,0,0,0.06)] hover:shadow-[0_8px_32px_rgba(0,0,0,0.1)] hover:-translate-y-1 transition-all duration-300 text-center md:text-left">
                        <div
                            class="w-14 h-14 rounded-2xl bg-brand-dark text-white flex items-center justify-center mx-auto md:mx-0 mb-5 text-xl font-extrabold shadow-lg relative z-10">
                            04</div>
                        <div class="relative">
                            <div class="w-12 h-[2px] bg-gray-200 mx-auto md:mx-0 mb-5"></div>
                            <p class="text-gray-700 font-medium text-base md:text-lg leading-relaxed">Launch and
                                performance testing</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Featured Project Slider - JSON-driven -->
    <section
        class="py-16 md:py-32 px-4 sm:px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-4 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">Featured Project</span>
            </div>
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-16 gsap-reveal">
                <h2 class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0">
                    Featured Work
                </h2>
                <a href="/services/digital-experiences/website-design-project"
                    class="inline-flex items-center gap-2 text-white font-bold text-sm hover:gap-3 transition-all duration-300 pb-1 border-b border-white/30 hover:border-white shrink-0 uppercase tracking-wider">
                    View Featured Project
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                    </svg>
                </a>
            </div>

            <div class="case-study-carousel-outer relative">
                <div class="swiper case-study-carousel gsap-reveal">
                    <div class="swiper-wrapper"></div>
                    <div class="swiper-pagination !relative !bottom-auto mt-10 md:mt-12"></div>
                </div>
                <div class="swiper-button-next"></div>
                <div class="swiper-button-prev"></div>
            </div>
        </div>
    </section>

    <!-- Insights Section -->
    <section class="py-16 px-4 sm:px-6 md:px-12 bg-[#f5f5f5] text-brand-dark border-t border-gray-200">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-12 gsap-reveal">
                <h2 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tighter uppercase m-0">
                    Insights
                </h2>
                <a href="/insights"
                    class="interactive border-2 border-brand-dark text-brand-dark hover:bg-brand-dark hover:text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 inline-block shrink-0 whitespace-nowrap">Explore
                    more</a>
            </div>

            <InsightsLoader slugs={[]} />
    </div></section>

    <section class="py-32 px-6 md:px-12 bg-white text-brand-dark border-t border-gray-200">
        <div class="max-w-[1000px] mx-auto">
            <h2 class="text-4xl md:text-5xl font-extrabold tracking-tighter mb-16 uppercase gsap-reveal">FAQ's</h2>
            <div class="border-t border-gray-200">
                <div class="gsap-reveal border-b border-gray-200 faq-item group">
                    <button
                        class="w-full text-left py-6 font-bold text-base md:text-xl flex justify-between items-center interactive focus:outline-none tracking-tight pr-4">
                        Do you build on WordPress, Shopify or custom code?
                        <svg class="w-6 h-6 transform transition-transform duration-300 icon text-gray-400 group-hover:text-black shrink-0 ml-4"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7">
                            </path>
                        </svg>
                    </button>
                    <div class="pb-6 text-gray-600 font-medium text-base leading-relaxed hidden answer max-w-3xl">
                        Whichever fits your team. We build on WordPress, Shopify and custom stacks, and advise on the
                        right choice if you are starting fresh.
                    </div>
                </div>
                <div class="gsap-reveal border-b border-gray-200 faq-item group">
                    <button
                        class="w-full text-left py-6 font-bold text-base md:text-xl flex justify-between items-center interactive focus:outline-none tracking-tight pr-4">
                        Will the site be built with SEO in mind from the start?
                        <svg class="w-6 h-6 transform transition-transform duration-300 icon text-gray-400 group-hover:text-black shrink-0 ml-4"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7">
                            </path>
                        </svg>
                    </button>
                    <div class="pb-6 text-gray-600 font-medium text-base leading-relaxed hidden answer max-w-3xl">
                        Yes. Technical SEO foundations are part of every build and are coordinated with our search team,
                        not bolted on later.
                    </div>
                </div>
                <div class="gsap-reveal border-b border-gray-200 faq-item group">
                    <button
                        class="w-full text-left py-6 font-bold text-base md:text-xl flex justify-between items-center interactive focus:outline-none tracking-tight pr-4">
                        Do you handle content and copy, or only the build?
                        <svg class="w-6 h-6 transform transition-transform duration-300 icon text-gray-400 group-hover:text-black shrink-0 ml-4"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7">
                            </path>
                        </svg>
                    </button>
                    <div class="pb-6 text-gray-600 font-medium text-base leading-relaxed hidden answer max-w-3xl">
                        We can handle both. Our content and design teams work alongside development, so the site
                        launches with copy that fits, not placeholder text.
                    </div>
                </div>
                <div class="gsap-reveal border-b border-gray-200 faq-item group">
                    <button
                        class="w-full text-left py-6 font-bold text-base md:text-xl flex justify-between items-center interactive focus:outline-none tracking-tight pr-4">
                        Do you maintain the site after launch?
                        <svg class="w-6 h-6 transform transition-transform duration-300 icon text-gray-400 group-hover:text-black shrink-0 ml-4"
                            fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7">
                            </path>
                        </svg>
                    </button>
                    <div class="pb-6 text-gray-600 font-medium text-base leading-relaxed hidden answer max-w-3xl">
                        Yes. We can hand over a finished build, or stay on for updates, monitoring and ongoing
                        improvement.
                    </div>
                </div>
            </div>
        </div>
    </section>

        <Testimonials client:visible />

    <section class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10" id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
                <!-- Left Side: Copy -->
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-8 uppercase leading-[0.9]">
                        Build a digital presence that works.
                    </h2>
                    <p class="text-lg md:text-2xl text-gray-400 mb-12 max-w-lg font-light">Let us design and build a
                        website or app that turns visitors into users and users into buyers.</p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>

<Fragment slot="scripts">
    <script is:inline src="/services/digital-experiences/website-design-projects.js" defer></script>
</Fragment>
</BaseLayout>
