---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
    title="SEO and Social Media Marketing Agency in Thane | ChimpzLab"
    description="Boost brand discoverability with ChimpzLab's visibility services - SEO, AEO, influencer marketing, social media, and content writing that drives real traffic."
    canonical="/services/visibility-search"
    hideHeader={false}
    hideFooter={false}
>
<Fragment slot="head">
<!-- Fonts: Manrope -->
    
    
    

    <!-- Tailwind CSS -->
    

    <!-- GSAP for Animations -->
    
    

    <!-- Lenis for Smooth Scrolling -->
</Fragment>


    <!-- Hero Section -->
    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Visibility &
                    Search</span>
            </div>

            <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Be found exactly where</span></div>
                <div class="overflow-hidden"><span class="block gsap-reveal-text text-white/40">your audience is already
                        looking.</span></div>
            </h1>

            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
                                Agenda</span>
                            <span class="text-sm font-medium text-gray-400 whitespace-nowrap leading-tight">30 minutes.
                                No pitch deck. Just finding your reputation gaps.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <!-- Intro Section (Image + Content) -->
    <section class="px-0 md:px-12 bg-white text-brand-dark border-t border-gray-200">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
                <!-- Left: Image -->
                <div class="lg:col-span-6 order-2 lg:order-none gsap-reveal">
                    <div class="relative h-full overflow-hidden md:mr-12">
                        <img src="/services/image/visibility-and-search.png" alt="Visibility & Search Agency in India"
                            class="w-full h-full object-contain object-bottom min-h-[300px] lg:min-h-full">
                    </div>
                </div>

                <!-- Right: Content -->
                <div class="lg:col-span-6 order-1 lg:order-none py-16 md:py-24 px-6 md:px-0 gsap-reveal">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-[1px] bg-gray-300"></div>
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our
                            Approach</span>
                    </div>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8 max-w-3xl">
                        ChimpzLab is a search and social agency that combines SEO, answer engine optimisation, content
                        writing and influencer marketing into one discovery model, so your brand shows up whether
                        someone is searching Google or asking ChatGPT.
                    </p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8 max-w-3xl">
                        Search has quietly split into two lanes. There is the ranked list of links people have used for
                        twenty years, and there is the AI answer that increasingly sits above it. Treating those as
                        separate jobs is how brands end up winning one and losing the other. We build for both from the
                        same foundation.
                    </p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-10 max-w-3xl">
                        The point is simple. When the right person goes looking for what you do, your name should be the
                        one that comes up, and the one the answer is built from.
                    </p>

                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-brand-dark hover:bg-gray-800 text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section (Sticky Scroll Layout) -->
    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white relative border-t border-white/10">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 relative items-start">

                <!-- Left: Pinned Header -->
