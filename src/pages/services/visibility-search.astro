                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Services Section (Sticky Scroll Layout) -->
    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white relative border-t border-white/10">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-16 lg:gap-20 relative items-start">

