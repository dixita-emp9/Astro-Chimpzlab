---
import LandingScripts from '../../components/LandingScripts.astro';

import BaseLayout from '../../layouts/BaseLayout.astro';
import InsightsLoader from '../../components/InsightsLoader.astro';

import ContactForm from '../../components/sections/ContactForm.astro';
import Testimonials from '../../components/Testimonials.tsx';

---
<BaseLayout
    title="Performance Marketing and Lead Gen Agency in Thane | ChimpzLab"
    description="ChimpzLab's demand generation services include email marketing, lead generation, performance marketing, and automation to fill your pipeline and grow revenue."
    canonical="/services/demand-generation"
    hideHeader={false}
    hideFooter={false}
>
<Fragment slot="head">
<!-- Fonts: Manrope -->

    <!-- Tailwind CSS -->

    <!-- GSAP for Animations -->

    <!-- Lenis for Smooth Scrolling -->

    <style is:inline>
        /* Case Study Carousel */
        .case-study-carousel-outer {
            position: relative;
        }

        .case-study-carousel .swiper-slide {
            height: auto;
        }

        .case-study-carousel .swiper-slide>a {
            height: 100%;
        }

        .case-study-carousel .swiper-pagination-bullet {
            background: rgba(255, 255, 255, 0.25);
            width: 10px;
            height: 10px;
            opacity: 1;
            transition: all 0.3s ease;
        }

        .case-study-carousel .swiper-pagination-bullet-active {
            background: #fff;
            width: 32px;
            border-radius: 5px;
        }

        .case-study-carousel-outer .swiper-button-next,
        .case-study-carousel-outer .swiper-button-prev {
            color: #fff;
            background: rgba(255, 255, 255, 0.06);
            width: 52px;
            height: 52px;
            border-radius: 50%;
            backdrop-filter: blur(12px);
            border: 1px solid rgba(255, 255, 255, 0.12);
            transition: all 0.3s ease;
            position: absolute;
            top: 50%;
            transform: translateY(-50%);
            z-index: 10;
        }

        .case-study-carousel-outer .swiper-button-next:hover,
        .case-study-carousel-outer .swiper-button-prev:hover {
            background: rgba(255, 255, 255, 0.15);
        }

        .case-study-carousel-outer .swiper-button-next:hover {
            transform: translateY(-50%) scale(1.08);
        }

        .case-study-carousel-outer .swiper-button-prev:hover {
            transform: translateY(-50%) scale(1.08);
        }

        .case-study-carousel-outer .swiper-button-next::after,
        .case-study-carousel-outer .swiper-button-prev::after {
            font-size: 16px;
            font-weight: 700;
        }

        .case-study-carousel-outer .swiper-button-next {
            right: -8px;
        }

        @media (min-width: 768px) {
            .case-study-carousel-outer .swiper-button-next {
                right: -26px;
            }
        }

        .case-study-carousel-outer .swiper-button-prev {
            left: -8px;
        }

        @media (min-width: 768px) {
            .case-study-carousel-outer .swiper-button-prev {
                left: -26px;
            }
        }

        .featured-single-mode .swiper-button-next,
        .featured-single-mode .swiper-button-prev,
        .featured-single-mode .swiper-pagination {
            display: none;
        }

        .featured-single-mode .swiper-wrapper {
            display: flex;
            justify-content: center;
        }

        .featured-single-card {
            max-width: 900px;
            width: 100%;
        }
    </style>
</Fragment>

    <!-- Hero Section -->
    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
