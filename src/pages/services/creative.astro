        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Creative</span>
            </div>

            <h1 class="text-4xl sm:text-6xl md:text-8xl font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Turn complex strategy</span></div>
                <div class="overflow-hidden"><span class="block gsap-reveal-text text-white/40">into work people
                        remember.</span></div>
            </h1>

            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
