<Fragment slot="head">
<!-- Fonts: Manrope -->

    <!-- Tailwind CSS -->

    <!-- GSAP for Animations -->

    <!-- Lenis for Smooth Scrolling -->
</Fragment>

    <!-- Hero Section -->
