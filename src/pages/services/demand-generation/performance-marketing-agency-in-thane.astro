---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import InsightsLoader from '../../../components/InsightsLoader.astro';

import ContactForm from '../../../components/sections/ContactForm.astro';
import Testimonials from '../../../components/Testimonials.tsx';

---
<BaseLayout
    title="Performance Marketing and Paid Media Agency in Thane | ChimpzLab"
    description="ChimpzLab runs data-driven performance marketing on Google, Meta, and LinkedIn - optimised for leads, conversions, and maximum return on ad spend."
    canonical="/services/demand-generation/performance-marketing-agency-in-thane"
    hideHeader={false}
    hideFooter={false}
>

    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Performance
                    Marketing</span>
            </div>
            <h1
                class="text-4xl sm:text-6xl md:text-8xl max-w-[850px] font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Paid campaigns optimised for pipeline,
                        not cost-per-click</span></div>
            </h1>
            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
                                Agenda</span>
                            <span class="text-sm font-medium text-gray-400 leading-tight">30 minutes. Aligning your
                                corporate narrative.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="px-0 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
                <div class="lg:col-span-6 order-2 lg:order-none gsap-reveal">
                    <div class="relative h-full overflow-hidden md:mr-12">
                        <img src="/services/image/demand-and-automation/performance.png" alt="Performance Marketing"
                            class="w-full h-full object-contain object-bottom min-h-[300px] lg:min-h-full">
                    </div>
                </div>
                <div class="lg:col-span-6 order-1 lg:order-none py-16 md:py-24 lg:py-32 px-6 md:px-0 gsap-reveal">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-[1px] bg-gray-300"></div>
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our
                            Approach</span>
                    </div>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8 max-w-3xl">Performance
                        marketing is paid advertising built and optimised around what happens after the click, leads and
                        revenue, rather than around a low cost-per-click on its own. A cheap click that never becomes a
                        lead is not a saving. We run campaigns across Google, Meta and other channels and optimise them
                        against the pipeline they produce.</p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-10 max-w-3xl">The ad is
                        only half the job. What the click lands on, and what happens next, decides whether the spend
                        pays off.</p>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-brand-dark hover:bg-gray-800 text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden">
