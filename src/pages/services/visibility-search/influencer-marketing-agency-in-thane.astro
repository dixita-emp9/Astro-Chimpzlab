---
import BaseLayout from '../../../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Influencer Marketing Agency in Thane | ChimpzLab"
    description="ChimpzLab connects brands with the right creators to drive reach, trust, and conversions. From nano to macro influencers - end-to-end influencer campaigns."
    canonical="/services/visibility-search/influencer-marketing-agency-in-thane"
    hideHeader={false}
    hideFooter={false}
>



    <header
        class="min-h-screen flex flex-col justify-center px-6 md:px-12 pt-32 pb-20 relative bg-brand-dark overflow-hidden">
        <div class="w-full max-w-[1400px] mx-auto z-10">
            <div class="flex items-center gap-4 mb-8 gsap-reveal-text">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="block text-xs font-bold uppercase tracking-[0.2em] text-white/70">Influencer
                    Marketing</span>
            </div>
            <h1
                class="text-4xl sm:text-6xl md:text-8xl max-w-[1000px] font-extrabold text-white mb-12 tracking-tighter uppercase">
                <div class="overflow-hidden"><span class="block gsap-reveal-text">Influencer partnerships measured on
                        impact, not followers</span></div>
            </h1>
            <div class="gsap-reveal">
                <div>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-white hover:bg-gray-200 text-black px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                        <div class="flex flex-col">
                            <span class="text-xs font-bold uppercase tracking-widest text-white/50 mb-1">The
                                Agenda</span>
                            <span class="text-sm font-medium text-gray-400 leading-tight">30 minutes. Aligning your
                                corporate narrative.</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <section class="px-0 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-12 items-stretch">
                <div class="lg:col-span-6 order-2 lg:order-none gsap-reveal">
                    <div class="relative h-full overflow-hidden md:mr-12">
                        <img src="/services/image/visibility-and-search/influencer-marketing.png"
                            alt="Influencer Marketing Agency in India"
                            class="w-full h-full object-contain object-bottom min-h-[300px] lg:min-h-full">
                    </div>
                </div>
                <div class="lg:col-span-6 order-1 lg:order-none py-16 md:py-24 px-6 md:px-0 gsap-reveal">
                    <div class="flex items-center gap-4 mb-8">
                        <div class="w-12 h-[1px] bg-gray-300"></div>
                        <span class="block text-xs font-bold uppercase tracking-[0.2em] text-gray-500">Our
                            Approach</span>
                    </div>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-8 max-w-3xl">Influencer
                        marketing is about partnering with creators whose audience genuinely fits yours, then measuring
                        the work on real outcomes rather than reach. A big follower count does not promise the right
                        audience or any actual impact. We identify and manage partnerships built around fit and results
                        you can point to.</p>
                    <p class="text-lg md:text-2xl font-light leading-relaxed text-gray-600 mb-10 max-w-3xl">The wrong
                        creator with a huge following often does less than the right creator with a smaller, sharper
                        audience. We optimise for the second one.</p>
                    <div class="flex flex-col sm:flex-row items-start sm:items-center gap-8">
                        <a href="/booking-form"
                            class="interactive bg-brand-dark hover:bg-gray-800 text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-2">
                            Book a Strategy Call
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                            </svg>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">What This Includes</span>
            </div>
            <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-16 mb-16">
                <div class="lg:col-span-5 gsap-reveal">
