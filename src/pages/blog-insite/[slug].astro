                            id="blog-category">Loading...</span
                        >
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-gray-400"
                            id="blog-readtime">Loading...</span
                        >
                        <span
                            class="text-xs font-bold uppercase tracking-widest text-gray-400 hidden sm:inline"
                            id="blog-date">Loading...</span
