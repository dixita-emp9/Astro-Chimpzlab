                    class="interactive border border-black/20 text-black hover:bg-black hover:text-white px-8 py-4 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 whitespace-nowrap"
                    >View All Insights</a
                >
            </div>
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-8"
                id="related-articles"
            >
            </div>
        </div>
    </section>

    <script is:inline>
        const cursor = document.getElementById("cursor");
        const interactiveElements = document.querySelectorAll(
            ".interactive, a, button, input, textarea, select, label",
        );
        document.addEventListener("mousemove", (e) => {
            cursor.style.left = e.clientX + "px";
            cursor.style.top = e.clientY + "px";
        });
        interactiveElements.forEach((el) => {
            el.addEventListener("mouseenter", () =>
                cursor.classList.add("hovered"),
            );
            el.addEventListener("mouseleave", () =>
                cursor.classList.remove("hovered"),
            );
        });
        if (typeof Lenis !== "undefined" && !window.lenis) {
            window.lenis = new Lenis({
                wrapper: window,
                content: document.documentElement,
                duration: 1.2,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                direction: "vertical",
                gestureDirection: "vertical",
                smooth: true,
                mouseMultiplier: 1,
                smoothTouch: false,
                touchMultiplier: 2,
                infinite: false,
            });
            function raf(time) {
                lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);
        }
        if (typeof gsap !== "undefined") {
            gsap.registerPlugin(ScrollTrigger);
            if (window.lenis) lenis.on("scroll", ScrollTrigger.update);
            gsap.from(".gsap-reveal-text", {
                y: 120,
                opacity: 0,
                duration: 1.2,
                stagger: 0.1,
                ease: "power4.out",
                delay: 0.2,
            });
            // Reveals are created globally (GlobalScripts) and re-created after
            // the article loads; only refresh positions here to avoid double
            // triggers on the same elements.
            ScrollTrigger.refresh();
        }

        // Blog Audio Player (visual toggle; replaced by Speech Synthesis logic at bottom of file)
        window.toggleAudio = function () {
            // Function overridden below
        };

        function setShareLinks(url, title) {
            const linkedin = document.getElementById("linkedin-share");
            const twitter = document.getElementById("twitter-share");
            if (linkedin)
                linkedin.href =
                    "https://www.linkedin.com/sharing/share-offsite/?url=" +
                    encodeURIComponent(url);
            if (twitter)
                twitter.href =
                    "https://twitter.com/intent/tweet?url=" +
                    encodeURIComponent(url) +
                    "&text=" +
                    encodeURIComponent(title);
        }

        // Set share links on page load
        setShareLinks(window.location.href, document.title);

        function shareArticle() {
            const title = document.title;
            const url = window.location.href;
            setShareLinks(url, title);
            if (navigator.share) {
                navigator.share({ title, url }).catch(function (err) {
                    if (err.name !== "AbortError") copyPageLink();
                });
            } else {
                copyPageLink();
            }
        }

        function copyPageLink() {
            const url = window.location.href;
            navigator.clipboard
                .writeText(url)
                .then(function () {
                    showToast("Link copied!", "check");
                })
                .catch(function () {
                    const input = document.createElement("input");
                    input.value = url;
                    document.body.appendChild(input);
                    input.select();
                    document.execCommand("copy");
                    document.body.removeChild(input);
                    showToast("Link copied!", "check");
                });
        }

        function showToast(msg, type) {
            const el = document.getElementById("toast-notification");
            if (!el) return;
            let icon = "";
            if (type === "check") {
                icon =
                    '<svg class="w-5 h-5 mr-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>';
            } else if (type === "warning") {
                icon =
                    '<svg class="w-5 h-5 mr-2 inline-block" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>';
            }
            el.innerHTML = icon + msg;
            el.classList.remove("opacity-0", "translate-y-4");
            el.classList.add("opacity-100", "translate-y-0");
            clearTimeout(el._hide);
            el._hide = setTimeout(function () {
                el.classList.remove("opacity-100", "translate-y-0");
                el.classList.add("opacity-0", "translate-y-4");
            }, 2500);
        }
    </script>

    <script is:inline>
        // 5. Footer: highlight relationship between Services and Service Pages
        (function () {
            const serviceLinks = document.querySelectorAll(
                "footer a[data-service]",
            );
            const pageLinks = document.querySelectorAll(
                "footer a[data-parent]",
            );
            if (!serviceLinks.length || !pageLinks.length) return;

            function clearAll() {
                serviceLinks.forEach((s) => s.classList.remove("is-active"));
                pageLinks.forEach((p) =>
                    p.classList.remove("is-match", "is-dim", "is-hovered"),
                );
            }

            serviceLinks.forEach((link) => {
                const key = link.getAttribute("data-service");
                link.addEventListener("mouseenter", () => {
                    serviceLinks.forEach((s) =>
                        s.classList.remove("is-active"),
                    );
                    link.classList.add("is-active");
                    pageLinks.forEach((p) => {
                        if (p.getAttribute("data-parent") === key) {
                            p.classList.add("is-match");
                            p.classList.remove("is-dim");
                        } else {
                            p.classList.add("is-dim");
                            p.classList.remove("is-match");
                        }
                    });
                });
                link.addEventListener("mouseleave", clearAll);
            });

            pageLinks.forEach((link) => {
                const key = link.getAttribute("data-parent");
                link.addEventListener("mouseenter", () => {
                    serviceLinks.forEach((s) => {
                        if (s.getAttribute("data-service") === key)
                            s.classList.add("is-active");
                        else s.classList.remove("is-active");
                    });
                    pageLinks.forEach((p) => {
                        if (p.getAttribute("data-parent") === key) {
                            p.classList.add("is-match");
                            p.classList.remove("is-dim");
                        } else {
                            p.classList.add("is-dim");
                            p.classList.remove("is-match");
                        }
                    });
                    p.classList.remove("is-hovered");
                    link.classList.add("is-hovered");
                });
                link.addEventListener("mouseleave", clearAll);
            });
        })();
    </script>

    <!-- MOBILE_OFFCANVAS_MENU -->

    <script is:inline>
        /* Mobile Offcanvas Menu - built dynamically from each page's nav */
        (function () {
            var navEl = document.querySelector("nav");
            var hamburgerBtn = navEl ? navEl.querySelector("button") : null;
            if (!navEl || !hamburgerBtn) return;

            var megaLinks = Array.prototype.slice
                .call(document.querySelectorAll("nav .mega-menu-grid a"))
                .map(function (a) {
                    var t = a.querySelector(".card-title");
                    var label = t
                        ? t.innerHTML
                              .replace(/<br\s*\/?>/gi, " ")
                              .replace(/\s+/g, " ")
                              .trim()
                        : a.textContent.trim();
                    return { href: a.href, label: label };
                });
            var directLinks = Array.prototype.slice
                .call(document.querySelectorAll("nav .nav-pill > a"))
                .map(function (a) {
                    return { href: a.href, label: a.textContent.trim() };
                });
            var ctaLink = Array.prototype.slice
                .call(document.querySelectorAll("nav a"))
                .find(function (a) {
                    return /connect/i.test(a.textContent);
                });
            var homeLink = document.querySelector('nav a[aria-label="Home"]');

            var overlay = document.createElement("div");
            overlay.className = "mobile-menu-overlay";
            var panel = document.createElement("div");
            panel.className = "mobile-menu-panel";
            panel.setAttribute("data-lenis-prevent", ""); // let the panel scroll natively even when Lenis is stopped

            var html =
                '<div class="mobile-menu-head"><a href="/' +
                (homeLink ? homeLink.href : "index.html") +
                '" class="mobile-menu-logo">CHIMPZLAB</a>';
            html +=
                '<button type="button" class="mobile-menu-close" aria-label="Close menu">&times;</button></div>';
            html += '<nav class="mobile-menu-nav">';
            html +=
                '<div class="mobile-menu-group"><button type="button" class="mobile-menu-toggle">Services <span class="chev"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 9l6 6 6-6"/></svg></span></button><div class="mobile-submenu">';
            megaLinks.forEach(function (l) {
                html +=
                    '<a href="/' +
                    l.href +
                    '" class="mobile-submenu-link">' +
                    l.label +
                    "</a>";
            });
            html += "</div></div>";
            directLinks.forEach(function (l) {
                html +=
                    '<a href="/' +
                    l.href +
                    '" class="mobile-menu-link">' +
                    l.label +
                    "</a>";
            });
            html += "</nav>";
            html +=
                '<a href="/' +
                (ctaLink ? ctaLink.href : "#booking-form") +
                '" class="mobile-menu-cta">Let\'s Connect</a>';

            panel.innerHTML = html;
            overlay.appendChild(panel);
            document.body.appendChild(overlay);

            function lockScroll() {
                document.body.classList.add("menu-open");
                if (window.lenis && typeof window.lenis.stop === "function")
                    window.lenis.stop();
            }
            function unlockScroll() {
                document.body.classList.remove("menu-open");
                if (window.lenis && typeof window.lenis.start === "function")
                    window.lenis.start();
            }
            function openMenu() {
                overlay.classList.add("open");
                hamburgerBtn.classList.add("is-active");
                hamburgerBtn.setAttribute("aria-expanded", "true");
                lockScroll();
            }
            function closeMenu() {
                overlay.classList.remove("open");
                hamburgerBtn.classList.remove("is-active");
                hamburgerBtn.setAttribute("aria-expanded", "false");
                unlockScroll();
            }

            hamburgerBtn.addEventListener("click", function () {
                if (overlay.classList.contains("open")) {
                    closeMenu();
                } else {
                    openMenu();
                }
            });
            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) closeMenu();
                if (e.target.closest("a")) closeMenu();
            });
            var closeBtn = panel.querySelector(".mobile-menu-close");
            if (closeBtn) closeBtn.addEventListener("click", closeMenu);
            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") closeMenu();
            });

            var svcToggle = panel.querySelector(".mobile-menu-toggle");
            if (svcToggle) {
                svcToggle.addEventListener("click", function () {
                    svcToggle.parentElement.classList.toggle("open");
                });
            }
        })();
    </script>

    <script is:inline src="/js/wp-insights.v2.js"></script>
    <script
        is:inline
        define:vars={{
            blogSiteName: site.name,
            blogSiteUrl: site.url,
            blogLogoUrl: site.url + site.logo.ogImage,
        }}
    >
        // Article loader - reads slug from URL, loads metadata index + single article
        (async function () {
            function showNotFound() {
                document.getElementById("blog-loading").classList.add("hidden");
                document
                    .getElementById("blog-not-found")
                    .classList.remove("hidden");
            }

            function showContent(article) {
                // Update page title
                document.title = article.titleFull + " | " + blogSiteName;

                // Update canonical URL to the pretty per-article URL
                var canon = document.querySelector('link[rel="canonical"]');
                if (canon) canon.setAttribute("href", "/blog-insite/" + article.slug);

                // Update meta description
                var metaDesc = document.querySelector(
                    'meta[name="description"]',
                );
                if (metaDesc && article.intro)
                    metaDesc.setAttribute("content", article.intro);

                // Inject BlogPosting JSON-LD schema
                var blogSchema = {
                    "@context": "https://schema.org",
                    "@type": "BlogPosting",
                    headline: article.titleFull,
                    description: article.intro || "",
                    image: article.image ? article.image : "",
                    datePublished: article.date || "",
                    author: {
                        "@type": "Organization",
                        name: blogSiteName,
                    },
                    publisher: {
                        "@type": "Organization",
                        name: blogSiteName,
                        logo: {
                            "@type": "ImageObject",
                            url: blogLogoUrl,
                        },
                    },
                    mainEntityOfPage: {
                        "@type": "WebPage",
                        "@id": blogSiteUrl + "/blog-insite/" + article.slug,
                    },
                };
                var schemaScript = document.createElement("script");
                schemaScript.type = "application/ld+json";
                schemaScript.textContent = JSON.stringify(blogSchema);
                document.head.appendChild(schemaScript);

                // --- Hero Section ---
                const heroMeta = document.querySelector(
                    ".gap-4.mb-8.gsap-reveal",
                );
                if (heroMeta) {
                    const spans = heroMeta.querySelectorAll("span");
                    if (spans[0]) spans[0].textContent = article.category;
                    if (spans[1]) spans[1].textContent = article.readTime;
                    if (spans[2]) spans[2].innerHTML = "\u2022 " + article.date;
                }

                const titleH1 = document.querySelector("h1");
                if (titleH1) {
                    const block = titleH1.querySelector(".gsap-reveal-text");
                    if (block)
                        block.textContent =
                            (article.titleParts &&
                                article.titleParts.join(" ")) ||
                            article.titleFull;
                }

                const coverImg = document.querySelector(
                    ".rounded-2xl.relative img",
                );
                if (coverImg) {
                    coverImg.src = article.image;
                    coverImg.alt = article.alt;
                }

                // --- Hero Tags ---
                const heroTags = document.querySelector(".hero-tags");
                if (heroTags && article.tag) {
                    var tagItems = article.tag.split(",").map(function (t) {
                        return t.trim();
                    });
                    tagItems.forEach(function (t) {
                        var span = document.createElement("span");
                        span.className =
                            "text-[11px] font-medium text-white/70 px-3 py-1 border border-white/20 rounded-full";
                        span.textContent = t;
                        heroTags.appendChild(span);
                    });
                }

                // --- Article Body ---
                const articleContent =
                    document.querySelector(".article-content");
                if (articleContent) {
                    let html = "";

                    html +=
                        '<p class="gsap-reveal text-2xl md:text-3xl text-black font-medium mb-12 leading-tight">' +
                        article.intro +
                        "</p>";

                    function slugify(text) {
                        return text
                            .toLowerCase()
                            .replace(/[^a-z0-9]+/g, "-")
                            .replace(/(^-|-$)/g, "");
                    }

                    if (Array.isArray(article.body)) {
                        // Legacy structured blocks (static JSON fallback)
                        article.body.forEach(function (section) {
                            if (section.type === "p") {
                                html +=
                                    '<p class="gsap-reveal mb-6">' +
                                    section.text +
                                    "</p>";
                            } else if (section.type === "h2") {
                                var id = slugify(section.text);
                                html +=
                                    '<h2 id="' +
                                    id +
                                    '" class="gsap-reveal uppercase tracking-tight text-2xl md:text-3xl font-bold mt-14 mb-6 scroll-mt-24">' +
                                    section.text +
                                    "</h2>";
                            } else if (section.type === "blockquote") {
                                html +=
                                    '<blockquote class="gsap-reveal border-l-4 border-black pl-6 italic text-gray-700 my-8">' +
                                    section.text +
                                    "</blockquote>";
                            } else if (section.type === "h3") {
                                var id = slugify(section.text);
                                html +=
                                    '<h3 id="' +
                                    id +
                                    '" class="gsap-reveal uppercase tracking-tight text-xl md:text-2xl font-bold mt-10 mb-4 scroll-mt-24">' +
                                    section.text +
                                    "</h3>";
                            }
                        });
                    } else if (typeof article.body === "string" && article.body.trim()) {
                        // WordPress rendered HTML
                        html += article.body;
                    }

                    document.getElementById("article-body").innerHTML = html;

                    // Build Table of Contents from h2/h3
                    const tocContainer = document.querySelector("#desktop-toc");
                    const mobileToc = document.querySelector("#mobile-toc");
                    const headings = articleContent.querySelectorAll("h2, h3");
                    headings.forEach((h, i) => {
                        const id = h.id || "heading-" + i;
                        h.id = id;
                        const link = document.createElement("a");
                        link.href = "#" + id;
                        link.textContent = h.textContent;
                        link.className = "block text-sm text-gray-600 hover:text-black transition-colors " + (h.tagName === "H3" ? "ml-4" : "");
                        if (tocContainer) tocContainer.appendChild(link);
                        if (mobileToc) mobileToc.appendChild(link.cloneNode(true));
                    });

                    // ScrollSpy for TOC
                    if (typeof gsap !== "undefined" && headings.length) {
                        gsap.registerPlugin(ScrollTrigger);
                        const tocLinks = tocContainer ? tocContainer.querySelectorAll("a") : [];
                        headings.forEach((h, i) => {
                            ScrollTrigger.create({
                                trigger: h,
                                start: "top 100",
                                end: "bottom 100",
                                onToggle: (self) => {
                                    if (tocLinks[i]) {
                                        if (self.isActive) {
                                            tocLinks[i].classList.add("text-black", "font-semibold");
                                            tocLinks[i].classList.remove("text-gray-600");
                                        } else {
                                            tocLinks[i].classList.remove("text-black", "font-semibold");
                                            tocLinks[i].classList.add("text-gray-600");
                                        }
                                    }
                                },
                            });
                        });
                    }

                    // Re-init GSAP reveals for newly injected content
                    if (typeof gsap !== "undefined") {
                        gsap.from("#article-body .gsap-reveal", {
                            y: 40,
                            opacity: 0,
                            duration: 0.8,
                            stagger: 0.05,
                            ease: "power3.out",
                            scrollTrigger: {
                                trigger: "#article-body",
                                start: "top 80%",
                            },
                        });
                        ScrollTrigger.refresh();
                    }
                }

                // --- Key Takeaways ---
                const dt = document.getElementById("desktop-takeaways");
                const mt = document.getElementById("mobile-takeaways");
                if (article.takeaways && article.takeaways.length) {
                    article.takeaways.forEach(function (t) {
                        var li = document.createElement("li");
                        li.className = "flex items-start gap-3 text-gray-700";
                        li.innerHTML =
                            '<svg class="w-5 h-5 flex-shrink-0 text-black" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg><span>' + t + "</span>";
                        if (dt) dt.appendChild(li);
                        if (mt) mt.appendChild(li.cloneNode(true));
                    });
                } else {
                    if (dt) dt.parentElement.style.display = "none";
                    if (mt) mt.parentElement.style.display = "none";
                }

                // --- Audio Player Setup ---
                if (article.audioUrl) {
                    const audioEl = document.getElementById("blog-audio");
                    const stickyAudioEl = document.getElementById("sticky-blog-audio");
                    if (audioEl) audioEl.src = article.audioUrl;
                    if (stickyAudioEl) stickyAudioEl.src = article.audioUrl;
                    document.getElementById("audio-player-container").classList.remove("hidden");
                    document.getElementById("sticky-audio-player-container").classList.remove("hidden");
                }

                // --- Show Content ---
                document.getElementById("blog-loading").classList.add("hidden");
                document.getElementById("blog-content").classList.remove("hidden");

                // Update share links
                setShareLinks(window.location.href, article.titleFull);
            }

            // Extract slug from URL path: /blog-insite/<slug>
            var path = window.location.pathname;
            var match = path.match(/^\/blog-insite\/([^/]+)/);
            var slug = match ? match[1] : null;

            if (!slug) {
                showNotFound();
                return;
            }

            // Load article
            try {
                var article = await window.WPInsights.fetchArticle(slug);
                if (!article) {
                    showNotFound();
                    return;
                }
                showContent(article);
            } catch (err) {
                console.error("Failed to load article:", err);
                showNotFound();
            }
        })();
    </script>
