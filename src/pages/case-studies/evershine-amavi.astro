---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Discover how ChimpzLab helped Evershine Builders with SEO, LinkedIn content, and targeted campaigns for their residential and commercial property projects."
    canonical="/case-studies/evershine-amavi"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                        >DEMAND GENERATION · PERFORMANCE MARKETING · VETTED LEAD
                        GENERATION</span
                    >
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Turning Cold Clicks</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Into a</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Sales-Ready Pipeline</span
                        >
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Evershine Amavi
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/evershine-amavi/cover.jpg"
                    alt="Evershine Amavi Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">Evershine Group</strong> is a Mumbai-based
                        real estate developer founded in 1960, with a portfolio of
                        over 60,000 homes delivered across six decades. Amavi 303,
                        part of the group's Global City township in Virar West, offers
                        RERA-registered 1 and 2 BHK residences starting at ₹44 lakh.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        Chimpzlab was engaged to generate and vet
                        WhatsApp-qualified leads for Amavi 303, so the sales
                        team spends its time on buyers who are genuinely ready
                        to visit and buy, not on cold enquiries.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                Real estate sales teams are used to being handed raw, unfiltered
                data: names and numbers with no way to tell who is actually
                house-hunting and who clicked an ad by accident. <span
                    class="text-white/40"
                    >at scale that gap quietly erodes the return on every rupee
                    of ad spend.</span
                >
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        Every hour a sales associate spends chasing an
                        unqualified number is an hour not spent with a buyer who
                        is ready to book a site visit.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >The Vetting Engine in Action</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Filter Before You Handoff
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        Instead of handing raw data straight to the sales floor,
                        the campaign was built around a filtering layer that
                        sits between the click and the CRM.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        AI + Human Vetting Layer
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Every inbound enquiry is screened by a combined AI and
                        human process before it is marked sales-ready, filtering
                        out clicks with no real intent.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Hyper-Targeted WhatsApp Click Campaigns
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Ad spend directed at highly targeted WhatsApp
                        click-to-chat placements, optimized down to a lean cost
                        per conversion.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        CRM-Mapped Lead Records
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Every verified lead logged with call recording, city and
                        a sales-associate note, visit planned, callback
                        scheduled, loan sanction in progress, so the sales floor
                        knows exactly where each conversation stands.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Full-Funnel Tracking
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Outbound clicks tracked separately from completed
                        lead-form submissions, so raw traffic is never mistaken
                        for qualified demand.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                A vetting engine that separates traffic from intent. <span
                    class="text-white/40"
                    >Every click counted, every lead verified, every sales hour
                    protected.</span
                >
            </h2>

            <!-- Metrics Grid -->
            <div class="mb-16 grid grid-cols-3 gap-4 md:gap-6 gsap-reveal">
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        30.9K
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Total Clicks
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        5.85K
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Conversions
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        313
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Verified Lead-Form Submissions
                    </div>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 relative z-10 max-w-4xl mx-auto"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Sales-Ready
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Pipeline
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Every verified lead entered the CRM with context -
                            call notes, city, intent level - so the sales team
                            picked up conversations that were already warmed up.
                        </p>
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Ad Spend
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Efficiency
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            By filtering at the top of the funnel, unqualified
                            clicks never reached the CRM, protecting both the ad
                            budget and the sales team's time.
                        </p>
                    </div>
                </div>
            </div>

            <div class="mt-20 max-w-4xl mx-auto text-center gsap-reveal">
                <div class="w-16 h-[1px] bg-white/20 mx-auto mb-8"></div>
                <p
                    class="text-lg md:text-2xl text-gray-400 font-light leading-relaxed italic"
                >
                    "In real estate, the expensive mistake isn't a low click
                    count - it's a CRM full of leads nobody vetted. Filtering
                    before the handoff is what turns a marketing report into an
                    actual sales pipeline."
                </p>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-1.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi Project"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-2.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi Lead Vetting"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-3.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi WhatsApp Campaign"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-4.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi CRM Integration"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-5.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi Lead Form"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-6.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi Dashboard"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/evershine-amavi/gallery-7.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine Amavi Analytics"
                    />
                </div>
            </div>
        </div>
    </div>

    <Testimonials client:visible />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Ready to turn your ad spend into a real sales pipeline?
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us build a vetting engine that hands your sales team
                        only the leads that are ready to buy.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>
</BaseLayout>
