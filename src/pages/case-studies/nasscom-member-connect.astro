---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Explore how ChimpzLab managed NASSCOM Member Connect's social media and newsletter strategy, delivering engagement across LinkedIn, Instagram, and X."
    canonical="/case-studies/nasscom-member-connect"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>

        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                    >
                        CORPORATE COMMUNICATIONS &middot; THOUGHT LEADERSHIP
                        &middot; SOCIAL MEDIA MARKETING</span
                    >
                </div>

                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">Sustaining</span>
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Ecosystem</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">Engagement</span>
                    </div>
                </h1>

                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Nasscom Member Connect
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/nasscom-member-connect/cover.jpg"
                    alt="Nasscom Member Connect Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">NASSCOM Member Connect</strong
                        > is the membership and community engagement wing of NASSCOM,
                        responsible for onboarding, retaining, and mobilizing India's
                        technology companies, from early-stage SMEs to multi-billion-dollar
                        global enterprises.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        Designing and executing the year-round communication
                        engine that drives institutional memberships, expands
                        SME mentorship, and anchors regional technology
                        ecosystems.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>

            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                A trade body's true value lies in its <span
                    class="text-white/40">continuous relevance</span
                > to its members.
            </h2>

            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        NASSCOM Member Connect required an operational framework
                        that moved beyond static, ad-hoc announcements into a
                        structured, always-on communication environment that
                        actively engages diverse member cohorts.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Initiative Architectures -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >The Solution</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Core Initiative Architectures
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        ChimpzLab builds and runs the digital communications
                        pipelines for NASSCOM's primary engagement pillars.
                    </p>
                </div>
            </div>

            <!-- 2x2 Grid Layout -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <!-- Card 1 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        DISHA Mentorship Program
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Designing targeted enrollment and positioning campaigns
                        to onboard, connect, and guide tech SMEs with industry
                        veterans.
                    </p>
                </div>
                <!-- Card 2 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Executive & Keynote Strategy
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Conceptualizing, structuring, and designing high-stakes
                        presentations for the NASSCOM President's keynote
                        sessions across major international and domestic forums.
                    </p>
                </div>
                <!-- Card 3 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        GCC & BPM Ecosystem
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Running data-driven industry updates and research-backed
                        communications that establish India as the ultimate
                        global hub for business process management and captive
                        centers.
                    </p>
                </div>
                <!-- Card 4 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Membership Acquisition
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Executing year-round value-driven email ecosystems,
                        corporate explainers, and benefits messaging to
                        consistently grow the trade body's member base.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Flagship Event Integration -->
    <section class="py-32 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div
                class="flex items-center gap-4 mb-16 gsap-reveal justify-center"
            >
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Flagship Event Integration</span
                >
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
            </div>

            <h2
                class="text-3xl sm:text-4xl md:text-4xl font-extrabold tracking-tighter uppercase text-center max-w-4xl mx-auto mb-8 gsap-reveal"
            >
                As part of the year-round engagement, we anchor the digital
                footprints and demand paths for Member Connect's two core
                summits
            </h2>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 md:gap-8 gsap-reveal max-w-4xl mx-auto"
            >
                <!-- Summit 1 -->
                <div
                    class="border border-gray-200 rounded-2xl p-8 md:p-10 flex flex-col items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base mb-4"
                        >NASSCOM SME Summit</span
                    >
                    <p
                        class="text-gray-600 text-sm md:text-base font-light group-hover:text-gray-400 transition-colors"
                    >
                        Accelerating discovery, growth playbooks, and
                        connections for emerging tech organizations.
                    </p>
                </div>
                <!-- Summit 2 -->
                <div
                    class="border border-gray-200 rounded-2xl p-8 md:p-10 flex flex-col items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base mb-4"
                        >NASSCOM Technology Confluence</span
                    >
                    <p
                        class="text-gray-600 text-sm md:text-base font-light group-hover:text-gray-400 transition-colors"
                    >
                        Powering cross-industry alignment and engineering deep
                        peer-to-peer technical conversations.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                Real community building demands <span class="text-white/40"
                    >absolute consistency.</span
                >
            </h2>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 relative z-10"
            >
                <!-- Card 1 -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Always-On
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Communication Loop
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Established a structured, always-on communication
                            loop replacing ad-hoc, campaign-only outreach.
                        </p>
                    </div>
                </div>

                <!-- Card 2 -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Cross-Cohort
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Engagement
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Sustained continuous engagement across member
                            cohorts, from early-stage SMEs to global
                            enterprises.
                        </p>
                    </div>
                </div>

                <!-- Card 3 -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            President
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Keynote Presence
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Anchored the NASSCOM President's keynote presence at
                            major domestic and international forums.
                        </p>
                    </div>
                </div>
            </div>

            <!-- Final quote -->
            <div class="mt-20 max-w-4xl mx-auto text-center gsap-reveal">
                <div class="w-16 h-[1px] bg-white/20 mx-auto mb-8"></div>
                <p
                    class="text-lg md:text-2xl text-gray-400 font-light leading-relaxed italic"
                >
                    "ChimpzLab engineered a structured communications loop that
                    ensured NASSCOM members remain actively connected and
                    informed across every operational cycle."
                </p>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee (Swiper JS implementation for drag support) -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/nsc-2026-01.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Connect 2026"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/nsc-2026-02.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Connect 2026"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2024-01.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2024"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2024-02.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2024"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2024-03.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2024"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2024-04.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2024"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2025-01.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2025"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/ntc-2025-02.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Tech Confluence 2025"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/nsc-2026-01.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Connect 2026"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/nasscom-member-connect/nsc-2026-02.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="NASSCOM Connect 2026"
                    />
                </div>
            </div>
        </div>
    </div>

    <Testimonials client:load />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Move from reactive messaging to real market authority.
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us audit your current communication footprint and
                        build a reputation engine that works as one system.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>
</BaseLayout>
