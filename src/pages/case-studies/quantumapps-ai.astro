---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="SEO & AEO Agency for AI Analytics | ChimpzLab"
    description="ChimpzLab elevated QuantumApps AI's brand authority through SEO, content strategy, LinkedIn campaigns, and Wikipedia presence for a global AI firm."
    canonical="/case-studies/quantumapps-ai"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                        >CREATIVE &middot; BRANDING &middot; DESIGN</span
                    >
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Giving an AI-Native</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Platform a Visual</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Identity Built on Precision</span
                        >
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        QuantumApps.AI
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/quantumapps-ai/cover.jpg"
                    alt="QuantumApps.AI Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">QuantumApps.AI</strong> is an AI-native
                        software platform company building agent-based systems. Chimpzlab
                        designed its full brand identity, logo, brand guidelines document,
                        corporate stationery and branded merchandise.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        Chimpzlab was engaged to build QuantumApps.AI's brand
                        identity from the ground up - a logo grounded in a
                        stated philosophy, the guidelines to govern it, and the
                        collateral to carry it into everyday use.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                AI-native software companies default easily to the same visual
                shorthand: cold blues, circuit-board patterns, generic
                'intelligence' iconography that could belong to any platform in
                the category <span class="text-white/40"
                    >without collapsing into either the sterile enterprise look
                    or an overly soft one.</span
                >
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        QuantumApps.AI needed a mark that could hold two ideas
                        at once - technical precision and human craft.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Our Approach</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        A Philosophy-Driven Identity
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        The identity was built outward from a single logo
                        philosophy, so every downstream design choice could be
                        traced back to what the mark itself was meant to say.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Logo Built on Philosophy
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        'Agents with Acumen performing Artistry,' rendered as a
                        geometric diamond form in a coral-to-gold gradient,
                        holding technical authority and human warmth in the same
                        mark.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Full Brand Guidelines
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Color system, typography and usage rules defined and
                        documented, including a secondary palette (Amethyst,
                        Purple Heart, Blue Chalk, Gallery) and Archivo as the
                        primary typeface across regular, medium and bold
                        weights.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Photography Direction
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Imagery chosen to reinforce reliability, scalability and
                        sophisticated decision-making - built around hardware
                        and data environments rather than generic stock-tech
                        visuals.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Corporate Stationery
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Letterheads, envelopes and ID cards designed for
                        everyday business use, carrying the identity into every
                        client touchpoint.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        05
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Branded Merchandise
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Notebooks, mugs, hoodies, stickers and device mockups -
                        so the identity shows up consistently everywhere the
                        company touches employees and partners.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                A logo built on a stated philosophy holds up under expansion.
                QuantumApps.AI's identity had to work as convincingly on a
                hoodie and a mug as it does on a pitch deck <span
                    class="text-white/40"
                    >- and that only happens when the guidelines do the
                    disciplined work up front.</span
                >
            </h2>

            <!-- Outcome Cards Grid -->
            <div
                class="mb-16 grid grid-cols-1 md:grid-cols-2 gap-4 md:gap-6 gsap-reveal"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight"
                    >
                        Complete Brand System
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        A full systemized brand identity anchored in a logo
                        philosophy that ties directly back to the company's own
                        positioning as an AI-native platform.
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight"
                    >
                        Guidelines & Governance
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        A full brand guidelines document covering color,
                        typography and photography, giving the QuantumApps.AI
                        team one consistent reference for execution.
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight"
                    >
                        Stationery Suite
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        A tailored corporate stationery suite carrying the
                        identity into letterheads, envelopes and ID cards.
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-xl md:text-2xl font-extrabold text-white mb-2 leading-tight"
                    >
                        Branded Merchandise
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        A branded merchandise line extending the identity beyond
                        the office into apparel, drinkware and everyday
                        collateral.
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-1.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Logo"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-2.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Brand Guidelines"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-3.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Color System"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-4.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Typography"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-5.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Stationery"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-6.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Merchandise"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-7.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Mockups"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-8.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Applications"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-9.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Photography Direction"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-10.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Brand Touchpoints"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-11.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Digital Assets"
                    />
                </div>
                <div class="swiper-slide" style="width: auto;">
                    <img
                        src="/casestudy/quantumapps-ai/gallery-12.jpg"
                        class="h-56 sm:h-72 md:h-[440px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="QuantumApps.AI Full Identity"
                    />
                </div>
            </div>
        </div>
    </div>

    <Testimonials client:load />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Ready to build a brand identity that holds up under
                        expansion?
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us create a visual system anchored in your
                        philosophy - from logo to guidelines to every
                        touchpoint.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>
</BaseLayout>
