---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Read how ChimpzLab crafted the digital strategy for NASSCOM Konnect, executing content campaigns, social media, and community engagement at scale."
    canonical="/case-studies/nasscom-konnect"
    hideHeader={false}
    hideFooter={false}
>
    \n
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <!-- Abstract Background Elements -->
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>

        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                    >
                        CORPORATE COMMUNICATIONS &middot; SOCIAL MEDIA MARKETING</span
                    >
                </div>

                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Scaling India's</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Flagship Tech</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">Platforms</span>
                    </div>
                </h1>

                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Nasscom Konnect
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/nasscom-konnect/cover.jpg"
                    alt="Nasscom Konnect Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">NASSCOM Konnect</strong> is the
                        event and community arm of NASSCOM, India's apex technology
                        industry body, running the country's largest national summits
                        for the IT, GCC, BPM, AI, and HR ecosystems.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        For 6+ years, ChimpzLab has served as the integrated
                        communications and digital infrastructure partner for
                        NASSCOM Konnect, scaling their entire national event
                        portfolio.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>

            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                Managing multi-city, <span class="text-white/40"
                    >high-stakes</span
                > national summits requires transforming disjointed event marketing
                into a <span class="text-white/40"
                    >single, high-performance conversion engine.</span
                >
            </h2>

            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        NASSCOM needed an agile partner capable of building
                        secure digital flagships, maintaining strict brand
                        compliance, capturing thousands of C-suite
                        registrations, and managing intense, real-time event day
                        communications simultaneously.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Integrated Execution Ecosystem (Carousel) -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >The Solution</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        The Integrated Execution Ecosystem
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        Instead of deploying siloed services, ChimpzLab
                        activated a unified technical and creative framework
                        across every phase of the event lifecycle.
                    </p>
                </div>
            </div>

            <!-- 2x2 Grid Layout -->
            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <!-- Card 1 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Digital Infrastructure
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Custom-engineering high-speed, secure event portals
                        optimized for high-traffic registration surges and
                        seamless user experience.
                    </p>
                </div>
                <!-- Card 2 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Pre-Event Demand Gen
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Deploying multi-channel performance media, targeted
                        account marketing, and hyper-segmented email drip
                        workflows to capture delegate pipeline.
                    </p>
                </div>
                <!-- Card 3 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Real-Time Broadcast
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Managing active on-site and digital communications, live
                        social broadcasting, executive quotation graphics, and
                        keynote highlights.
                    </p>
                </div>
                <!-- Card 4 -->
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Post-Event Extensions
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Converting raw event recordings into long-term thought
                        leadership engines, YouTube distribution assets,
                        executive blogs, and reports.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Portfolio Scope -->
    <section class="py-32 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div
                class="flex items-center gap-4 mb-16 gsap-reveal justify-center"
            >
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Portfolio Scope</span
                >
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
            </div>

            <h2
                class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tighter uppercase text-center max-w-4xl mx-auto mb-16 gsap-reveal"
            >
                We have consistently scaled NASSCOM's complete national flagship
                calendar
            </h2>

            <div
                class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 md:gap-8 gsap-reveal"
            >
                <!-- Summit 1 -->
                <div
                    class="border border-gray-200 rounded-2xl p-6 md:p-8 flex items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base"
                        >NTLF</span
                    >
                </div>
                <!-- Summit 2 -->
                <div
                    class="border border-gray-200 rounded-2xl p-6 md:p-8 flex items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base"
                        >GCC Summit</span
                    >
                </div>
                <!-- Summit 3 -->
                <div
                    class="border border-gray-200 rounded-2xl p-6 md:p-8 flex items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base"
                        >People Summit</span
                    >
                </div>
                <!-- Summit 4 -->
                <div
                    class="border border-gray-200 rounded-2xl p-6 md:p-8 flex items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base"
                        >BPM Summit</span
                    >
                </div>
                <!-- Summit 5 -->
                <div
                    class="border border-gray-200 rounded-2xl p-6 md:p-8 flex items-center justify-center text-center hover:bg-brand-dark hover:text-white transition-colors duration-300 group lg:col-span-1 md:col-span-3 col-span-2"
                >
                    <span
                        class="font-extrabold uppercase tracking-widest text-sm md:text-base"
                        >AI Summit</span
                    >
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome Metric Cards -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                By integrating technical web architecture with aggressive demand
                generation, <span class="text-white/40"
                    >we delivered an unshakable, year-round industry narrative
                    engine.</span
                >
            </h2>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 relative z-10"
            >
                <!-- NTLF Card -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <h3
                        class="text-xl md:text-2xl font-extrabold uppercase tracking-wider mb-8 text-white/70"
                    >
                        NTLF
                    </h3>

                    <div class="mb-10 space-y-6 flex-grow">
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                1600+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Registrations
                            </div>
                        </div>
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                577K+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Impressions
                            </div>
                        </div>
                    </div>

                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Secured baseline CXO registrations, optimized
                            digital conversion paths, and dominated organic
                            industry voice across channels.
                        </p>
                    </div>
                </div>

                <!-- GCC Summit Card -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <h3
                        class="text-xl md:text-2xl font-extrabold uppercase tracking-wider mb-8 text-white/70"
                    >
                        GCC Summit
                    </h3>

                    <div class="mb-10 space-y-6 flex-grow">
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                1300+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Registrations
                            </div>
                        </div>
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                779K+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Impressions
                            </div>
                        </div>
                    </div>

                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Managed high-intent enterprise acquisition funnels,
                            placing GCC ecosystem leaders at the center of the
                            regional narrative.
                        </p>
                    </div>
                </div>

                <!-- HR Summit Card -->
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <h3
                        class="text-xl md:text-2xl font-extrabold uppercase tracking-wider mb-8 text-white/70"
                    >
                        HR Summit
                    </h3>

                    <div class="mb-10 space-y-6 flex-grow">
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                470+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Registrations
                            </div>
                        </div>
                        <div>
                            <div
                                class="text-4xl md:text-6xl font-extrabold text-white mb-2"
                            >
                                489K+
                            </div>
                            <div
                                class="text-sm tracking-widest uppercase font-bold text-white/50"
                            >
                                Impressions
                            </div>
                        </div>
                    </div>

                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Positioned NASSCOM at the forefront of the
                            artificial intelligence conversation through deep
                            content syndication.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee (Swiper JS implementation for drag support) -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/nasscom-konnect/gallery-1.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="DES 2022-01.png"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/nasscom-konnect/gallery-2.png"
