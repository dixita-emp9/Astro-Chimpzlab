---
import BaseLayout from '../../layouts/BaseLayout.astro';
---
<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Discover how ChimpzLab helped Evershine Builders with SEO, LinkedIn content, and targeted campaigns for their residential and commercial property projects."
    canonical="/case-studies/evershine-house"
    hideHeader={false}
    hideFooter={false}
>



    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center">
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl">
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl">
            </div>
            <div class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay">
            </div>
        </div>
        <div class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/70">DEMAND GENERATION &middot;
                        VETTED LEAD GENERATION &middot; PERFORMANCE MARKETING</span>
                </div>
                <h1
                    class="text-4xl sm:text-6xl md:text-7xl lg:text-6xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12">
                    <div class="overflow-hidden"><span class="block gsap-reveal-text">Turning Every Website</span></div>
                    <div class="overflow-hidden"><span class="block text-white/40 gsap-reveal-text">Visitor Into
                            a</span>
                    </div>
                    <div class="overflow-hidden"><span class="block gsap-reveal-text">Qualified Sales
                            Conversation</span></div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">Evershine House</p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative">
                <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"></div>
                <img src="/casestudy/evershine-house/cover.png" alt="Evershine House Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700">
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50">About Brand</span>
                    </div>
                    <p class="text-xl md:text-2xl font-light leading-relaxed text-gray-800">
                        <strong class="font-bold">Evershine House</strong> is a premium commercial office destination in
                        Mumbai by the Evershine Group, designed for businesses looking for modern office spaces in a
                        well-connected business district. While the website attracted a steady flow of prospective
                        buyers and leasing enquiries, visitors often left before speaking with a sales representative or
                        finding the information they were looking for.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50">The Mandate</span>
                    </div>
                    <p class="text-xl md:text-2xl font-light leading-relaxed text-gray-800">
                        Chimpzlab was engaged to build Aura, an AI-powered Property Concierge that could become the
                        first point of interaction for every website visitor. The objective was to answer
                        property-related questions instantly, qualify prospects, guide users to relevant information,
                        and seamlessly connect high-intent visitors with the sales team; all without requiring constant
                        manual intervention.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative">
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">The Challenge</span>
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl">
                Commercial real estate enquiries rarely follow a predictable path.
                <span class="text-white/40">converting anonymous visitors into qualified conversations.</span>
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p class="text-lg md:text-xl text-gray-400 font-light leading-relaxed">
                        Some visitors want project specifications, others compare floor plans, ask about leasing
                        options, enquire about amenities, location connectivity, or simply want to schedule a site
                        visit. Relying solely on enquiry forms meant the sales team only engaged after a visitor had
                        already decided to reach out. Many potential buyers left the website before taking that step,
                        while repetitive questions consumed valuable time that could have been spent nurturing serious
                        prospects.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50">Our
                    Approach</span>
            </div>
            <div class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal">
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl">
                        Intelligent Conversations at Scale</h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">Rather than building a conventional chatbot,
                        Chimpzlab developed Aura, an AI Property Concierge trained specifically on Evershine House's
                        commercial offering, enabling visitors to have natural conversations instead of navigating
                        static menus.</p>
                </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal">
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]">
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">01</div>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4">AI-Powered Property
                        Discovery</h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">Visitors can ask questions naturally
                        about office spaces, project specifications, amenities, leasing information, pricing, and
                        availability, receiving contextual responses instead of being redirected through multiple pages.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]">
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">02</div>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4">Intelligent Lead
                        Qualification</h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">Aura understands visitor intent and
                        progressively captures key qualification details such as business requirements, office size,
                        investment interest, preferred location, and contact information before routing qualified
                        enquiries to the sales team.</p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]">
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">03</div>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4">Knowledge-Driven
                        Assistance</h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">The concierge provides instant answers
                        around project highlights, location advantages, floor plans, amenities, commercial
                        specifications, and frequently asked questions, helping visitors make informed decisions without
                        waiting for a sales executive.</p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]">
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">04</div>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4">Seamless Sales
                        Handover</h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">When a visitor expresses buying or
                        leasing intent, Aura transitions the conversation into a consultation request or site visit
                        booking, ensuring qualified leads reach the sales team with complete context.</p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]">
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">05</div>
                    <h3 class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4">24×7 Engagement</h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">Whether enquiries arrive during office
                        hours or late at night, every visitor receives immediate assistance, ensuring no opportunity is
                        lost because a representative wasn't available.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10">
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-white/50">The Impact</span>
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl">
                Every website visitor is a potential buyer, tenant, or investor-<span class="text-white/40">but only if
                    someone is available to engage them at the right moment.</span>
            </h2>

            <!-- Metrics Grid -->
            <div class="mb-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 gsap-reveal">
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500">
                    <div class="text-3xl md:text-5xl font-extrabold text-white mb-2">&lt;30 sec</div>
                    <div class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50">AVERAGE FIRST
                        RESPONSE TIME</div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500">
                    <div class="text-3xl md:text-5xl font-extrabold text-white mb-2">70%</div>
                    <div class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50">VISITOR QUERIES
                        HANDLED INSTANTLY</div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500">
                    <div class="text-3xl md:text-5xl font-extrabold text-white mb-2">35%</div>
                    <div class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50">MORE QUALIFIED
                        SALES CONVERSATIONS</div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500">
                    <div class="text-3xl md:text-5xl font-extrabold text-white mb-2">24 x 7</div>
                    <div class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50">AI PROPERTY
                        CONCIERGE AVAILABLE</div>
                </div>
            </div>


        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag">
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto"><img src="/casestudy/evershine-house/gallery-1.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Aura Chatbot"></div>
                <div class="swiper-slide w-auto"><img src="/casestudy/evershine-house/gallery-2.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Lead Qualification"></div>
                <div class="swiper-slide w-auto"><img src="/casestudy/evershine-house/gallery-3.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Property Discovery"></div>
                <div class="swiper-slide w-auto"><img src="/casestudy/evershine-house/gallery-4.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Sales Handover"></div>
            </div>
        </div>
    </div>

    <!-- Testimonial Carousel Section -->
    <section class="py-16 md:py-32 px-4 md:px-12 bg-[#f5f5f5] text-brand-dark border-t border-gray-200 overflow-hidden">
        <div class="max-w-[950px] mx-auto">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-gray-300"></div>
                <span class="text-xs font-bold uppercase tracking-[0.2em] text-gray-500">What Our Clients Say</span>
            </div>

            <div class="relative">
                <button
                    class="testimonial-prev absolute left-0 md:-left-16 bottom-[-40px] md:bottom-auto md:top-1/2 md:-translate-y-1/2 w-12 h-12 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center hover:bg-gray-50 hover:border-gray-300 transition-all duration-300 group z-20"
                    aria-label="Previous testimonial">
                    <svg class="w-5 h-5 text-gray-600 group-hover:text-black transition-colors" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7">
                        </path>
                    </svg>
                </button>

                <button
                    class="testimonial-next absolute right-0 md:-right-16 bottom-[-40px] md:bottom-auto md:top-1/2 md:-translate-y-1/2 w-12 h-12 rounded-full bg-white border border-gray-200 shadow-md flex items-center justify-center hover:bg-gray-50 hover:border-gray-300 transition-all duration-300 group z-20"
                    aria-label="Next testimonial">
                    <svg class="w-5 h-5 text-gray-600 group-hover:text-black transition-colors" fill="none"
                        stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                    </svg>
                </button>

                <div class="testimonial-carousel overflow-hidden">
                    <div class="testimonial-track flex transition-transform duration-500 ease-in-out"></div>
                </div>

                <div class="flex items-center justify-center gap-2 mt-4 md:mt-6" id="testimonial-dots"></div>
            </div>
        </div>
    </section>

    <section class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10" id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center">
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]">
                        Ready to turn your website into an intelligent sales assistant?</h2>
                    <p class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light">Let us build an AI
                        concierge that qualifies and converts your visitors around the clock.</p>
                </div>
                <div class="bg-[#111] border border-white/10 rounded-2xl p-6 md:p-8 gsap-reveal">
                    <form id="contactForm" class="space-y-6" method="POST" action="/lead-capture.php">
                        <!-- Top Row Fields -->
                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <div>
                                <input type="text" name="name" placeholder="Your Name *" minlength="2" maxlength="100"
                                    pattern="[A-Za-zÀ-ÿ\s\.\-']+"
                                    title="Please enter a valid name (letters, spaces, hyphens only)"
                                    class="w-full bg-transparent border border-white/20 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:outline-none focus:border-white transition-colors"
                                    required>
                                <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter your full name.</p>
                            </div>
                            <div>
                                <input type="email" name="email" placeholder="Email *" maxlength="254"
                                    pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
                                    title="Please enter a valid email address"
                                    class="w-full bg-transparent border border-white/20 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:outline-none focus:border-white transition-colors"
                                    required>
                                <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid email
                                    address.</p>
                            </div>
                        </div>
                        <!-- Phone -->
                        <div>
                            <input type="tel" name="phone" placeholder="Phone *" minlength="10" maxlength="15"
                                pattern="[0-9]{10,15}" inputmode="numeric" title="Please enter a valid phone number (10-15 digits)"
                                class="w-full bg-transparent border border-white/20 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:outline-none focus:border-white transition-colors"
                                required>
                            <p class="error-msg text-red-500 text-xs mt-1 hidden">Please enter a valid phone number (min
                                10 digits).</p>
                        </div>
                        <!-- Textarea -->
                        <div>
                            <textarea name="message" placeholder="Tell us about your project *" rows="4" minlength="10"
                                maxlength="2000"
                                class="w-full bg-transparent border border-white/20 rounded-xl px-5 py-4 text-white placeholder-gray-500 focus:outline-none focus:border-white transition-colors resize-none"
                                required></textarea>
                            <p class="error-msg text-red-500 text-xs mt-1 hidden">Message must be at least 10
                                characters.</p>
                        </div>

                        <!-- Honeypot: invisible to humans, bots love it -->
                        <div style="position:absolute;left:-9999px;top:-9999px" aria-hidden="true">
                            <label>Leave this blank</label>
                            <input type="text" name="_hp" tabindex="-1" autocomplete="off">
                        </div>


                        <!-- Google reCAPTCHA -->
                        <div class="pt-2">
                            <div class="g-recaptcha" data-sitekey="6Ld5s24tAAAAABcGfuai8DbOmn6JAS9kARQonH1h"></div>
                            <p id="recaptchaError" class="error-msg text-red-500 text-xs mt-1 hidden">Please complete
                                the CAPTCHA.</p>
                        </div>

                        <!-- Hidden fields -->
                        <input type="hidden" name="api_key" value="3afc0840e1193e58397159d4af15cf4a15b5b35c">
                        <input type="hidden" name="_redirect" value="thanks.html">

                        <!-- Submit Button -->
                        <div class="pt-6">
                            <button type="submit" id="submitBtn"
                                class="interactive w-fit bg-white hover:bg-gray-200 text-black px-10 py-5 rounded-full text-sm font-bold uppercase tracking-wider transition-all duration-300 flex items-center gap-3">
                                Send Message
                                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                        d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                                </svg>
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    
<Fragment slot="scripts">


    <script is:inline>
        (function () {
            function initTestimonials() {
                const testimonialTrack = document.querySelector('.testimonial-track');
                const prevBtn = document.querySelector('.testimonial-prev');
                const nextBtn = document.querySelector('.testimonial-next');
                const dotsContainer = document.getElementById('testimonial-dots');
                if (!testimonialTrack) return;

                let currentSlide = 0;
                let totalSlides = 0;
                let autoplayInterval;

                const fallbackData = [
                    {
                        "quote": "ChimpzLab team has delivered an exceptional UI/UX upgrade for CIRL. Your ability to blend sophisticated design with functional simplicity is remarkable. The intuitive interface they crafted has significantly enhanced the experience for our customers. I would highly recommended any organization looking to elevate their digital presence to try Chimpzlab.",
                        "author": "Latesh A Shetty",
                        "title": "MD & CEO, Centrico Insurance Repository Limited",
                        "image": "",
                        "letter": "LS"
                    },
                    {
                        "quote": "Partnering with Chimpzlab has been an excellent experience. Their strategic thinking, creative excellence, and commitment to quality have consistently elevated our brand communication. A dependable team that truly understands premium real estate marketing.",
                        "author": "Lachman Ludhani",
                        "title": "Chairman & Managing Director, Evershine Group",
                        "image": "",
                        "letter": "LL"
                    },
                    {
                        "quote": "Chimpzlab has been a commendable partner for us. Their creative approach and timely delivery of services make our collaboration seamless and highly effective. We truly appreciate their professionalism and the value they bring to our initiatives.",
                        "author": "Dr Sriram Birudavolu",
                        "title": "CEO, Cybersecurity Centre of Excellence, Hyderabad",
                        "image": "",
                        "letter": "SB"
                    },
                    {
                        "quote": "Working with the Chimpzlab team has been a seamless experience. They have consistently delivered high-quality work with professionalism and responsiveness. The team is proactive, easy to work with, and quick to understand our requirements, ensuring that updates are implemented efficiently. We value their commitment, reliability, and continued support, and would be happy to recommend them to any organization looking for a dependable digital partner.",
                        "author": "Palak Nanjani",
                        "title": "Director, Paradigm ARQ",
                        "image": "",
                        "letter": "PN"
                    },
                    {
                        "quote": "Our experience working with the Chimpzlab team has been nothing short of outstanding. They possess a unique ability to bridge the gap between complex financial communication and highly effective digital strategy, a truly dependable team.",
                        "author": "Ananya Deshmukh",
                        "title": "VP of Corporate Strategy, FinVantage Capital",
                        "image": "",
                        "letter": "AD"
                    }
                ];

                function renderTestimonials(data) {
                    if (!data || !data.length) data = fallbackData;
                    totalSlides = data.length;

                    testimonialTrack.innerHTML = data.map((t, i) => `
                <div class="testimonial-slide min-w-full px-2">
                    <div class="bg-white rounded-3xl p-6 md:p-14 relative shadow-sm h-full flex flex-col justify-center">
                        <div class="absolute top-8 right-10 text-[120px] leading-none font-serif text-gray-100 select-none pointer-events-none">"</div>
                        <p class="text-sm sm:text-lg md:text-xl lg:text-2xl font-medium leading-relaxed text-gray-800 mb-10 relative z-10 italic max-w-[800px]">"${t.quote}"</p>
                        <div class="flex items-center gap-4 relative z-10 shrink-0">
                            ${t.image
                            ? `<img src="/casestudy/${t.image}" alt="${t.author}" class="w-14 h-14 rounded-full object-cover">`
                            : `<div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-lg shrink-0">${t.letter}</div>`
                        }
                            <div>
                                <p class="font-bold text-base text-brand-dark">${t.author}</p>
                                <p class="text-sm text-gray-500">${t.title}</p>
                            </div>
                        </div>
                    </div>
                </div>
            `).join('');

                    if (dotsContainer) {
                        dotsContainer.innerHTML = data.map((_, i) => `
                    <button class="testimonial-dot w-2.5 h-2.5 rounded-full ${i === 0 ? 'bg-black' : 'bg-gray-300'} transition-all duration-300"
                        data-index="${i}" aria-label="Go to slide ${i + 1}"></button>
                `).join('');
                    }

                    initCarousel();
                }

                function initCarousel() {
                    const testimonialSlides = document.querySelectorAll('.testimonial-slide');
                    const dots = document.querySelectorAll('.testimonial-dot');

                    function goToSlide(index) {
                        if (index < 0) index = totalSlides - 1;
                        if (index >= totalSlides) index = 0;
                        currentSlide = index;
                        testimonialTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
                        dots.forEach((dot, i) => {
                            dot.classList.toggle('bg-black', i === currentSlide);
                            dot.classList.toggle('bg-gray-300', i !== currentSlide);
                        });
                    }

                    function startAutoplay() {
                        autoplayInterval = setInterval(() => goToSlide(currentSlide + 1), 5000);
                    }

                    function stopAutoplay() {
                        clearInterval(autoplayInterval);
                    }

                    if (prevBtn) {
                        prevBtn.addEventListener('click', () => {
                            stopAutoplay();
                            goToSlide(currentSlide - 1);
                            startAutoplay();
                        });
                    }

                    if (nextBtn) {
                        nextBtn.addEventListener('click', () => {
                            stopAutoplay();
                            goToSlide(currentSlide + 1);
                            startAutoplay();
                        });
                    }

                    dots.forEach(dot => {
                        dot.addEventListener('click', () => {
                            stopAutoplay();
                            goToSlide(parseInt(dot.dataset.index));
                            startAutoplay();
                        });
                    });

                    const carouselEl = document.querySelector('.testimonial-carousel');
                    if (carouselEl) {
                        let dragStartX = 0;
                        let dragDeltaX = 0;
                        let isDragging = false;

                        function setTransition(v) {
                            testimonialTrack.style.transition = v ? 'transform 0.5s ease' : 'none';
                        }

                        function onDragStart(e) {
                            if (e.type === 'mousedown' && e.button !== 0) return;
                            isDragging = true;
                            dragStartX = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                            dragDeltaX = 0;
                            setTransition(false);
                            stopAutoplay();
                        }

                        function onDragMove(e) {
                            if (!isDragging) return;
                            const x = e.type.includes('mouse') ? e.clientX : e.touches[0].clientX;
                            dragDeltaX = x - dragStartX;
                            const offset = -(currentSlide * 100) + (dragDeltaX / carouselEl.offsetWidth * 100);
                            testimonialTrack.style.transform = `translateX(${offset}%)`;
                        }

                        function onDragEnd() {
                            if (!isDragging) return;
                            isDragging = false;
                            setTransition(true);
                            if (dragDeltaX < -50) {
                                goToSlide(currentSlide + 1);
                            } else if (dragDeltaX > 50) {
                                goToSlide(currentSlide - 1);
                            } else {
                                goToSlide(currentSlide);
                            }
                            startAutoplay();
                        }

                        carouselEl.addEventListener('touchstart', onDragStart, { passive: true });
                        carouselEl.addEventListener('touchmove', onDragMove, { passive: true });
                        carouselEl.addEventListener('touchend', onDragEnd);
                        carouselEl.addEventListener('mousedown', onDragStart);
                        carouselEl.addEventListener('mousemove', onDragMove);
                        carouselEl.addEventListener('mouseup', onDragEnd);
                        carouselEl.addEventListener('mouseleave', onDragEnd);
                    }

                    startAutoplay();
                }

                const fetchPath = '../data/testimonials.json';
                fetch(fetchPath)
                    .then(res => res.json())
                    .then(renderTestimonials)
                    .catch(err => {
                        console.warn('Failed to fetch testimonials JSON, using fallback data:', err);
                        renderTestimonials(fallbackData);
                    });
            }

            if (document.readyState === 'loading') {
                document.addEventListener('DOMContentLoaded', initTestimonials);
            } else {
                initTestimonials();
            }
        })();
    </script>

    <script is:inline>
        // Location Map Modal Functionality
        (function () {
            const locationLink = document.getElementById('location-link');
            const mapModal = document.getElementById('map-modal');
            const mapModalContent = document.getElementById('map-modal-content');
            const closeMapModal = document.getElementById('close-map-modal');

            if (locationLink && mapModal) {
                locationLink.addEventListener('click', (e) => {
                    e.preventDefault();
                    mapModal.classList.remove('opacity-0', 'pointer-events-none');
                    if (mapModalContent) {
                        mapModalContent.classList.remove('scale-95');
                        mapModalContent.classList.add('scale-100');
                    }
                });

                const closeModal = () => {
                    mapModal.classList.add('opacity-0', 'pointer-events-none');
                    if (mapModalContent) {
                        mapModalContent.classList.remove('scale-100');
                        mapModalContent.classList.add('scale-95');
                    }
                };

                if (closeMapModal) {
                    closeMapModal.addEventListener('click', closeModal);
                }

                mapModal.addEventListener('click', (e) => {
                    if (e.target === mapModal) {
                        closeModal();
                    }
                });

                document.addEventListener('keydown', (e) => {
                    if (e.key === 'Escape' && !mapModal.classList.contains('pointer-events-none')) {
                        closeModal();
                    }
                });
            }
        })();
    </script>

    <script is:inline src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
    <script is:inline>
        document.addEventListener('DOMContentLoaded', function () {
            if (typeof Swiper !== 'undefined') { new Swiper('.auto-scroll-swiper', { slidesPerView: 'auto', spaceBetween: 32, loop: true, speed: 4000, autoplay: { delay: 0, disableOnInteraction: false, pauseOnMouseEnter: true }, grabCursor: false, allowTouchMove: true, on: { click: function (swiper, event) { const clickedImg = event.target.closest('img'); if (clickedImg) { openLightbox(clickedImg.src); } } } }); }
        });
    </script>
