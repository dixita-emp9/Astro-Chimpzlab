---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Discover how ChimpzLab helped Evershine Builders with SEO, LinkedIn content, and targeted campaigns for their residential and commercial property projects."
    canonical="/case-studies/evershine-house"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                        >DEMAND GENERATION &middot; VETTED LEAD GENERATION
                        &middot; PERFORMANCE MARKETING</span
                    >
                </div>
                <h1
                    class="text-4xl sm:text-6xl md:text-7xl lg:text-6xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Turning Every Website</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Visitor Into a</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Qualified Sales Conversation</span
                        >
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Evershine House
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/evershine-house/cover.png"
                    alt="Evershine House Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">Evershine House</strong> is a premium
                        commercial office destination in Mumbai by the Evershine Group,
                        designed for businesses looking for modern office spaces in
                        a well-connected business district. While the website attracted
                        a steady flow of prospective buyers and leasing enquiries,
                        visitors often left before speaking with a sales representative
                        or finding the information they were looking for.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        Chimpzlab was engaged to build Aura, an AI-powered
                        Property Concierge that could become the first point of
                        interaction for every website visitor. The objective was
                        to answer property-related questions instantly, qualify
                        prospects, guide users to relevant information, and
                        seamlessly connect high-intent visitors with the sales
                        team; all without requiring constant manual
                        intervention.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                Commercial real estate enquiries rarely follow a predictable
                path.
                <span class="text-white/40"
                    >converting anonymous visitors into qualified conversations.</span
                >
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        Some visitors want project specifications, others
                        compare floor plans, ask about leasing options, enquire
                        about amenities, location connectivity, or simply want
                        to schedule a site visit. Relying solely on enquiry
                        forms meant the sales team only engaged after a visitor
                        had already decided to reach out. Many potential buyers
                        left the website before taking that step, while
                        repetitive questions consumed valuable time that could
                        have been spent nurturing serious prospects.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Our Approach</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Intelligent Conversations at Scale
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        Rather than building a conventional chatbot, Chimpzlab
                        developed Aura, an AI Property Concierge trained
                        specifically on Evershine House's commercial offering,
                        enabling visitors to have natural conversations instead
                        of navigating static menus.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        AI-Powered Property Discovery
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Visitors can ask questions naturally about office
                        spaces, project specifications, amenities, leasing
                        information, pricing, and availability, receiving
                        contextual responses instead of being redirected through
                        multiple pages.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Intelligent Lead Qualification
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Aura understands visitor intent and progressively
                        captures key qualification details such as business
                        requirements, office size, investment interest,
                        preferred location, and contact information before
                        routing qualified enquiries to the sales team.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Knowledge-Driven Assistance
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        The concierge provides instant answers around project
                        highlights, location advantages, floor plans, amenities,
                        commercial specifications, and frequently asked
                        questions, helping visitors make informed decisions
                        without waiting for a sales executive.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Seamless Sales Handover
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        When a visitor expresses buying or leasing intent, Aura
                        transitions the conversation into a consultation request
                        or site visit booking, ensuring qualified leads reach
                        the sales team with complete context.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        05
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        24×7 Engagement
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Whether enquiries arrive during office hours or late at
                        night, every visitor receives immediate assistance,
                        ensuring no opportunity is lost because a representative
                        wasn't available.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                Every website visitor is a potential buyer, tenant, or investor-<span
                    class="text-white/40"
                    >but only if someone is available to engage them at the
                    right moment.</span
                >
            </h2>

            <!-- Metrics Grid -->
            <div
                class="mb-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 gsap-reveal"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        &lt;30 sec
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        AVERAGE FIRST RESPONSE TIME
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        70%
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        VISITOR QUERIES HANDLED INSTANTLY
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        35%
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        MORE QUALIFIED SALES CONVERSATIONS
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        24 x 7
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        AI PROPERTY CONCIERGE AVAILABLE
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/evershine-house/gallery-1.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Aura Chatbot"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/evershine-house/gallery-2.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Lead Qualification"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/evershine-house/gallery-3.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Property Discovery"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/evershine-house/gallery-4.png"
                        class="h-56 sm:h-72 lg:h-[550px] w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Evershine House Sales Handover"
                    />
                </div>
            </div>
        </div>
    </div>

    <Testimonials client:load />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Ready to turn your website into an intelligent sales
                        assistant?
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us build an AI concierge that qualifies and converts
                        your visitors around the clock.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>
</BaseLayout>
