---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="GHCI 2024 Case Study - Event Marketing | ChimpzLab"
    description="Explore how ChimpzLab executed the digital marketing strategy for GHCI 2024, driving registrations and engagement for one of India's largest tech conferences."
    canonical="/case-studies/ghci-2024"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                    >
                        SOCIAL MEDIA MARKETING &middot; DESIGN</span
                    >
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Turning an Event</span>
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Into a</span>
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">Movement</span>
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Grace Hopper Celebration India 2024
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/ghci-2024/cover.jpg"
                    alt="GHCI 2024 Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">AnitaB.org India</strong> is the
                        India chapter of the global nonprofit AnitaB.org, dedicated
                        to advancing women in technology. <strong
                            class="font-bold"
                            >Grace Hopper Celebration India (GHCI)</strong
                        > is its flagship annual event, bringing together women technologists
                        through keynotes, workshops, mentoring, and networking.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        ChimpzLab partnered with AnitaB.org India to design and
                        run the integrated content and digital marketing
                        campaign for GHCI 2024, a hybrid-format edition of the
                        flagship event.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                Scale visibility, engagement, and participation for a <span
                    class="text-white/40">flagship hybrid event</span
                > empowering women in tech, cutting through digital noise with an
                <span class="text-white/40"
                    >integrated content marketing campaign.</span
                >
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        With GHCI 2024 returning in a hybrid format, the focus
                        was on designing an integrated content marketing
                        campaign that could cut through digital noise, inspire
                        action, and elevate reach across touchpoints.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Our Approach</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Multi-Layered Communication Plan
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        ChimpzLab collaborated closely with the AnitaB.org India
                        team to craft a multi-layered communication plan.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Narrative-Led Content Strategy
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Showcased leadership voices, women-in-tech stories, and
                        session spotlights through a blend of static, video, and
                        carousel content.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Always-On Social Media Engine
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Aligned content cadence with event momentum, from
                        pre-buzz and registrations to live updates and
                        post-event reflections.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Email & Web Integration
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Crafted conversion-focused emailers and optimized
                        landing experiences to drive clicks, sign-ups, and
                        information flow.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Community & Hashtag Amplification
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Encouraged speaker and attendee-driven storytelling via
                        branded hashtags and shoutouts to expand organic reach.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                An event campaign earns the word "movement" when the community
                keeps telling the story <span class="text-white/40"
                    >after the event ends.</span
                >
            </h2>

            <!-- Metrics Grid -->
            <div
                class="mb-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 gsap-reveal"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        7,000+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Registrations
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        720K+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Impressions
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        49K+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Website Visits
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        7.3%
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Emailer CTR
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        6.5Mn+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Hashtag Reach
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        42K+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Engagements
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        2,215
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        New Followers
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        17K+
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Social Page Visits
                    </div>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 relative z-10 max-w-4xl mx-auto"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Community
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Movement
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            By blending content with community and strategy with
                            storytelling, we turned GHCI 2024 into more than
                            just an event; it became a movement.
                        </p>
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Ecosystem
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Resonance
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            The campaign resonated across the tech ecosystem,
                            driving measurable growth in registrations,
                            engagement, and brand visibility.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="GHCI 2024"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-2.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Women In Tech"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-3.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Grace Hopper"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-4.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Keynote Sessions"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-5.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Networking"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-6.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Mentoring"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-7.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Hybrid Event"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-8.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="AnitaB.org"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Tech Community"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/ghci-2024/gallery-2.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Women Leaders"
                    />
                </div>
            </div>
        </div>
    </div>

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof Swiper !== "undefined") {
                new Swiper(".auto-scroll-swiper", {
                    slidesPerView: "auto",
                    spaceBetween: 32,
                    loop: true,
                    speed: 4000,
                    autoplay: {
                        delay: 0,
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true,
                    },
                    grabCursor: false,
                    allowTouchMove: true,
                    on: {
                        click: function (swiper, event) {
                            const clickedImg = event.target.closest("img");
                            if (clickedImg) {
                                openLightbox(clickedImg.src);
                            }
                        },
                    },
                });
            }
        });
        document.addEventListener("DOMContentLoaded", function () {
            const imageModal = document.getElementById("image-modal");
            const modalImage = document.getElementById("modal-image");
            const closeModalBtn = document.getElementById("close-modal");
            window.openLightbox = function (src) {
                if (!imageModal || !modalImage) return;
                modalImage.src = src;
                imageModal.classList.remove("hidden");
                imageModal.classList.add("flex");
                void imageModal.offsetWidth;
                imageModal.classList.remove("opacity-0");
                modalImage.classList.remove("scale-95");
                document.body.style.overflow = "hidden";
            };
            function closeLightbox() {
                imageModal.classList.add("opacity-0");
                modalImage.classList.add("scale-95");
                document.body.style.overflow = "";
                setTimeout(() => {
                    imageModal.classList.add("hidden");
                    imageModal.classList.remove("flex");
                    modalImage.src = "";
                }, 300);
            }
            if (closeModalBtn && imageModal) {
                closeModalBtn.addEventListener("click", closeLightbox);
                imageModal.addEventListener("click", function (e) {
                    if (e.target === imageModal) {
                        closeLightbox();
                    }
                });
            }
        });
    </script>

    <Testimonials client:load />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Move from reactive messaging to real market authority.
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us audit your current communication footprint and
                        build a reputation engine that works as one system.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>

</BaseLayout>
