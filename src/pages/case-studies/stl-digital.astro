---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
import Testimonials from "../../components/Testimonials.tsx";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="Explore ChimpzLab's work with STL Digital - social strategy, content calendars, reel scripts, and brand positioning for a future-skills K-12 ecosystem."
    canonical="/case-studies/stl-digital"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                    >
                        CORPORATE COMMUNICATIONS &middot; SOCIAL MEDIA MARKETING
                        &middot; DESIGN</span
                    >
                </div>
                <h1
                    class="text-3xl sm:text-4xl md:text-6xl xl:text-7xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Giving a Global</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Tech Brand a</span
                        >
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text"
                            >Consistent Voice</span
                        >
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        STL Digital
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/stl-digital/cover.jpg"
                    alt="STL Digital Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">STL Digital</strong> is a global
                        IT services and digital transformation company offering software
                        engineering, cloud, data, and enterprise consulting services
                        to clients worldwide.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        ChimpzLab serves as STL Digital's ongoing corporate
                        communications partner, aligning internal and external
                        messaging with the company's innovation-first
                        positioning.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                Effectively communicate <span class="text-white/40"
                    >evolving vision, values, and strategy</span
                > to internal employees and external stakeholders, reinforcing identity
                as an <span class="text-white/40"
                    >innovation-first global tech brand.</span
                >
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        STL Digital needed to build a strong digital
                        communication framework that reinforced its identity as
                        an innovation-first, global tech brand across every
                        touchpoint.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Approach -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Our Approach</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Multi-Channel Corporate Communication Strategy
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        ChimpzLab developed a multi-channel corporate
                        communication strategy that blended clarity, creativity,
                        and consistency.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Internal Engagement
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Designed impactful newsletters and leadership messaging
                        templates to boost employee connection and clarity on
                        organizational goals.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Strategic Content Development
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Delivered comprehensive annual reports, leadership
                        decks, and investor communication tools aligned with
                        STL's tone and future vision.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Digital Communication Hub
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Managed updates and messaging strategy on STL Digital's
                        corporate website, ensuring alignment between brand
                        positioning and user experience.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        04
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Multimedia Storytelling
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Produced high-engagement corporate videos, digital
                        publications, and branded campaigns to bring STL's
                        message to life across platforms.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px] md:col-span-2"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        05
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Sentiment Mapping & Feedback Loops
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Introduced periodic stakeholder sentiment tracking using
                        AI-assisted listening tools to adapt communication
                        touchpoints based on real feedback.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-6xl"
            >
                Consistency compounds. STL Digital's LinkedIn growth came from <span
                    class="text-white/40"
                    >disciplined, always-on storytelling,</span
                > not a single viral moment.
            </h2>

            <div
                class="mb-16 grid grid-cols-1 md:grid-cols-2 gap-6 gsap-reveal"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-10 md:p-12 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-5xl md:text-7xl font-extrabold text-white mb-3"
                    >
                        562K+
                    </div>
                    <div
                        class="text-sm md:text-base tracking-widest uppercase font-bold text-white/50"
                    >
                        Organic LinkedIn impressions, no ad spend
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-10 md:p-12 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-5xl md:text-7xl font-extrabold text-white mb-3"
                    >
                        40,000+
                    </div>
                    <div
                        class="text-sm md:text-base tracking-widest uppercase font-bold text-white/50"
                    >
                        Followers gained in 6 months
                    </div>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 relative z-10"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Internal
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Alignment
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Increased internal alignment and employee engagement
                            within 6 months.
                        </p>
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Stakeholder
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Perception
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Improved external stakeholder perception with
                            measurable feedback highlighting clarity and
                            consistency.
                        </p>
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-3xl p-8 md:p-10 flex flex-col gsap-reveal backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div class="mb-10 flex-grow">
                        <div
                            class="text-4xl md:text-5xl font-extrabold text-white mb-4 leading-tight"
                        >
                            Digital
                        </div>
                        <div
                            class="text-sm tracking-widest uppercase font-bold text-white/50"
                        >
                            Sentiment
                        </div>
                    </div>
                    <div class="pt-8 border-t border-white/10">
                        <p
                            class="text-gray-400 font-light text-sm md:text-base leading-relaxed"
                        >
                            Positive shifts in digital sentiment around STL
                            Digital's narrative, tracked through internal and
                            public channels.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="STL Digital Brand"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-2.webp"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Corporate Voice"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-4.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Leadership Deck"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-5.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Digital Hub"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-6.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Multimedia Content"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-7.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Sentiment Tracking"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-8.png"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Employee Engage"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Global Tech Brand"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/stl-digital/gallery-2.webp"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Innovation First"
                    />
                </div>
            </div>
        </div>
    </div>

    <Testimonials client:load />

    <section
        class="py-16 md:py-20 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
        id="booking-form"
        style="min-height: 100dvh; align-items: center; display: flex; flex-wrap: wrap;"
    >
        <div class="max-w-[1400px] mx-auto">
            <div
                class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center"
            >
                <div class="gsap-reveal">
                    <h2
                        class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter mb-4 md:mb-6 uppercase leading-[0.9]"
                    >
                        Move from reactive messaging to real market authority.
                    </h2>
                    <p
                        class="text-lg md:text-2xl text-gray-400 mb-6 md:mb-8 max-w-lg font-light"
                    >
                        Let us audit your current communication footprint and
                        build a reputation engine that works as one system.
                    </p>
                </div>
                <ContactForm theme="dark" />
            </div>
        </div>
    </section>
</BaseLayout>
