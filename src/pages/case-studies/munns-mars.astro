---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ContactForm from "../../components/sections/ContactForm.astro";
---

<BaseLayout
    title="Corporate Communications Agency in Thane | ChimpzLab"
    description="See how ChimpzLab built Munns & Mars' social presence with branded reels, influencer strategy, and AI-powered content to grow a D2C innerwear brand."
    canonical="/case-studies/munns-mars"
    hideHeader={false}
    hideFooter={false}
>
    <!-- Hero Section -->
    <section
        class="pt-40 md:pt-56 pb-20 px-6 md:px-12 relative overflow-hidden bg-brand-dark min-h-[80vh] flex flex-col justify-center"
    >
        <div class="absolute inset-0 z-0 opacity-20 pointer-events-none">
            <div
                class="absolute top-[-10%] right-[-5%] w-[60vw] h-[60vw] rounded-full bg-gradient-to-br from-white/10 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute bottom-[-20%] left-[-10%] w-[50vw] h-[50vw] rounded-full bg-gradient-to-tr from-white/5 to-transparent blur-3xl"
            >
            </div>
            <div
                class="absolute inset-0 bg-[url('../asset/grid-pattern.svg')] bg-repeat opacity-10 mix-blend-overlay"
            >
            </div>
        </div>
        <div
            class="max-w-[1400px] mx-auto w-full relative z-10 grid grid-cols-1 lg:grid-cols-2 gap-12 items-center"
        >
            <div>
                <div class="flex items-center gap-4 mb-8 gsap-reveal">
                    <div class="w-12 h-[1px] bg-white/30"></div>
                    <span
                        class="text-xs font-bold uppercase tracking-[0.2em] text-white/70"
                    >
                        SOCIAL MEDIA MARKETING &middot; INFLUENCER MARKETING</span
                    >
                </div>
                <h1
                    class="text-3xl sm:text-6xl lg:text-5xl xl:text-6xl font-extrabold text-white tracking-tighter uppercase leading-[0.9] mb-12"
                >
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">Driving</span>
                    </div>
                    <div class="overflow-hidden">
                        <span class="block text-white/40 gsap-reveal-text"
                            >Communications</span>
                    </div>
                    <div class="overflow-hidden">
                        <span class="block gsap-reveal-text">& Storyline</span>
                    </div>
                </h1>
                <div class="flex items-center gap-4 gsap-reveal">
                    <div class="w-2 h-2 bg-white rounded-full"></div>
                    <p class="text-xl font-bold tracking-widest uppercase">
                        Munns & Mars
                    </p>
                </div>
            </div>
            <div
                class="gsap-reveal rounded-3xl overflow-hidden shadow-[0_20px_50px_rgba(0,0,0,0.5)] border border-white/10 relative"
            >
                <div
                    class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent z-10"
                >
                </div>
                <img
                    src="/casestudy/munns-mars/cover.jpg"
                    alt="Munns & Mars Cover"
                    class="w-full h-auto object-cover transform hover:scale-105 transition-transform duration-700"
                />
            </div>
        </div>
    </section>

    <!-- About & Mandate -->
    <section class="py-24 px-6 md:px-12 bg-white text-brand-dark">
        <div class="max-w-[1400px] mx-auto">
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >About Brand</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        <strong class="font-bold">Munns & Mars</strong> is a comfort-first
                        innerwear, shapewear, and activewear brand for modern women.
                        Built around the belief that support starts from within, the
                        brand combines comfort, confidence, and style to empower women
                        through their everyday lives.
                    </p>
                </div>
                <div class="gsap-reveal">
                    <div class="flex items-center gap-4 mb-6">
                        <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                        <span
                            class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                            >The Mandate</span
                        >
                    </div>
                    <p
                        class="text-xl md:text-2xl font-light leading-relaxed text-gray-800"
                    >
                        As the digital partners of Munns & Mars, ChimpzLab owns
                        the brand's social media storytelling and influencer
                        strategy, shaping how the brand shows up in a crowded,
                        low-differentiation category.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- The Challenge -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10 overflow-hidden relative"
    >
        <div class="max-w-[1400px] mx-auto relative z-10">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Challenge</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold tracking-tighter uppercase leading-[0.95] gsap-reveal max-w-5xl"
            >
                A crowded, low-differentiation category where shapewear brands
                compete on <span class="text-white/40"
                    >price and product claims</span
                > - needing to break through without relying on generic content.
            </h2>
            <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 lg:gap-16">
                <div class="gsap-reveal"></div>
                <div class="gsap-reveal border-l border-white/20 pl-8 md:pl-12">
                    <p
                        class="text-lg md:text-xl text-gray-400 font-light leading-relaxed"
                    >
                        Conversations around body shaping can easily feel
                        clinical or aspirational in an exclusionary way. The
                        brand needed to convert relatable pain points into
                        content and grow a founder-story-driven, comfort-first
                        brand voice organically.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Our Solution -->
    <section
        class="py-32 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark overflow-hidden"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-6">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Our Solution</span
                >
            </div>
            <div
                class="flex flex-col md:flex-row items-start justify-between gap-8 mb-16 gsap-reveal"
            >
                <div>
                    <h2
                        class="text-3xl sm:text-4xl md:text-6xl font-extrabold tracking-tighter uppercase m-0 max-w-3xl"
                    >
                        Content & Influencer Strategy
                    </h2>
                </div>
                <div class="max-w-sm">
                    <p class="text-base text-gray-600 font-medium">
                        We built a strategy around three pillars - storytelling,
                        signature content, and influencer collaborations.
                    </p>
                </div>
            </div>

            <div
                class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8 mt-16 gsap-reveal"
            >
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        01
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Pain-Point-Led Storytelling
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Anchored our content strategy in everyday challenges and
                        discomforts, positioning the brand as an empathetic
                        partner rather than a seller.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px]"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        02
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Signature Content Property
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Introduced INNA-Circle, a recurring series featuring
                        Inna, a relatable character who voices the everyday
                        experiences and struggles of modern women.
                    </p>
                </div>
                <div
                    class="bg-white rounded-3xl p-8 md:p-10 shadow-[0_8px_32px_rgba(0,0,0,0.05)] border border-gray-100 transition-transform duration-500 hover:-translate-y-2 flex flex-col justify-center min-h-[300px] md:col-span-2"
                >
                    <div class="text-5xl font-extrabold text-gray-200 mb-6">
                        03
                    </div>
                    <h3
                        class="text-2xl md:text-3xl font-extrabold tracking-tighter uppercase mb-4"
                    >
                        Influencer Collaborations
                    </h3>
                    <p class="text-gray-600 leading-relaxed font-light text-lg">
                        Partnered with relevant influencers and creators whose
                        audiences aligned with our target consumer, amplifying
                        reach beyond owned channels through authentic, trusted
                        recommendations.
                    </p>
                </div>
            </div>
        </div>
    </section>

    <!-- Outcome -->
    <section
        class="py-32 px-6 md:px-12 bg-brand-dark text-white border-t border-white/10"
    >
        <div class="max-w-[1400px] mx-auto">
            <div class="flex items-center gap-4 mb-8 gsap-reveal">
                <div class="w-12 h-[1px] bg-white/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-white/50"
                    >The Impact</span
                >
            </div>
            <h2
                class="text-3xl sm:text-5xl md:text-6xl font-extrabold tracking-tighter uppercase mb-16 gsap-reveal max-w-4xl"
            >
                When a category is saturated with product claims, the brand that
                wins the conversation is the one that
                <span class="text-white/40"
                    >understands the customer first.</span
                >
            </h2>

            <div
                class="mb-16 grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6 gsap-reveal"
            >
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        20x
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Increase in Impressions
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        44x
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Increase in Interactions
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        22x
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Increase in Accounts Reached
                    </div>
                </div>
                <div
                    class="bg-white/5 border border-white/10 rounded-2xl p-6 md:p-8 text-center backdrop-blur-md hover:bg-white/10 transition-colors duration-500"
                >
                    <div
                        class="text-3xl md:text-5xl font-extrabold text-white mb-2"
                    >
                        10.6%
                    </div>
                    <div
                        class="text-xs md:text-sm tracking-widest uppercase font-bold text-white/50"
                    >
                        Growth in Followers
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Video Showcase -->
    <section
        class="py-20 px-6 md:px-12 bg-[#f5f5f5] text-brand-dark border-t border-gray-200"
    >
        <div class="max-w-[1200px] mx-auto">
            <div class="flex items-center gap-4 mb-12 gsap-reveal">
                <div class="w-12 h-[1px] bg-brand-dark/30"></div>
                <span
                    class="text-xs font-bold uppercase tracking-[0.2em] text-brand-dark/50"
                    >Watch the Work</span
                >
            </div>
            <div class="flex flex-wrap justify-center gap-6 md:gap-10">
                <div
                    class="gsap-reveal w-full max-w-[400px] max-h-[600px] aspect-[9/16] rounded-2xl overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.2)] bg-black ring-1 ring-black/10"
                >
                    <video
                        class="w-full h-full object-cover"
                        autoplay
                        muted
                        loop
                        controls
                        playsinline
                        preload="metadata"
                    >
                        <source
                            src="/casestudy/munns-mars/video1.mp4"
                            type="video/mp4"
                        />
                    </video>
                </div>
                <div
                    class="gsap-reveal w-full max-w-[400px] max-h-[600px] aspect-[9/16] rounded-2xl overflow-hidden shadow-[0_12px_40px_rgba(0,0,0,0.2)] bg-black ring-1 ring-black/10"
                >
                    <video
                        class="w-full h-full object-cover"
                        autoplay
                        muted
                        loop
                        controls
                        playsinline
                        preload="metadata"
                    >
                        <source
                            src="/casestudy/munns-mars/video2.mp4"
                            type="video/mp4"
                        />
                    </video>
                </div>
            </div>
        </div>
    </section>

    <!-- Auto Scroll Marquee -->
    <div
        class="relative overflow-hidden py-12 md:py-20 bg-brand-dark border-t border-white/10 interactive-drag"
    >
        <div class="swiper auto-scroll-swiper w-full">
            <div class="swiper-wrapper">
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Munns & Mars"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/3.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="INNA-Circle"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/4.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Shapewear Brand"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/5.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Influencer Strategy"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/7.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Comfort First"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/1.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Women Empowerment"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/3.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Pain Point Content"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/4.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Brand Voice"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/5.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Social Storytelling"
                    />
                </div>
                <div class="swiper-slide w-auto">
                    <img
                        src="/casestudy/munns-mars/7.jpg"
                        class="h-48 md:h-80 w-auto object-cover rounded-xl shadow-2xl cursor-pointer"
                        alt="Digital Partner"
                    />
                </div>
            </div>
        </div>
    </div>

    <script
        is:inline
        src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"
    ></script>
    <script is:inline>
        document.addEventListener("DOMContentLoaded", function () {
            if (typeof Swiper !== "undefined") {
                new Swiper(".auto-scroll-swiper", {
                    slidesPerView: "auto",
                    spaceBetween: 32,
                    loop: true,
                    speed: 4000,
                    autoplay: {
                        delay: 0,
                        disableOnInteraction: false,
                        pauseOnMouseEnter: true,
                    },
                    grabCursor: false,
                    allowTouchMove: true,
                    on: {
                        click: function (swiper, event) {
                            const clickedImg = event.target.closest("img");
                            if (clickedImg) {
                                openLightbox(clickedImg.src);
                            }
                        },
                    },
                });
            }
        });
        document.addEventListener("DOMContentLoaded", function () {
            const imageModal = document.getElementById("image-modal");
            const modalImage = document.getElementById("modal-image");
            const closeModalBtn = document.getElementById("close-modal");
            window.openLightbox = function (src) {
                if (!imageModal || !modalImage) return;
                modalImage.src = src;
                imageModal.classList.remove("hidden");
                imageModal.classList.add("flex");
                void imageModal.offsetWidth;
                imageModal.classList.remove("opacity-0");
                modalImage.classList.remove("scale-95");
                document.body.style.overflow = "hidden";
            };
            function closeLightbox() {
                imageModal.classList.add("opacity-0");
                modalImage.classList.add("scale-95");
                document.body.style.overflow = "";
                setTimeout(() => {
                    imageModal.classList.add("hidden");
                    imageModal.classList.remove("flex");
                    modalImage.src = "";
                }, 300);
            }
            if (closeModalBtn && imageModal) {
                closeModalBtn.addEventListener("click", closeLightbox);
                imageModal.addEventListener("click", function (e) {
                    if (e.target === imageModal) {
                        closeLightbox();
                    }
                });
            }
        });

        // Testimonial Carousel Logic - Data Driven
        const testimonialTrack = document.querySelector(".testimonial-track");
        const prevBtn = document.querySelector(".testimonial-prev");
        const nextBtn = document.querySelector(".testimonial-next");
        const dotsContainer = document.getElementById("testimonial-dots");
        let currentSlide = 0;
        let totalSlides = 0;
        let autoplayInterval;

        function renderTestimonials(data) {
            totalSlides = data.length;

            testimonialTrack.innerHTML = data
                .map(
                    (t, i) => `
                        <div class="testimonial-slide min-w-full px-2">
                            <div class="bg-white rounded-3xl p-6 md:p-14 relative shadow-sm h-full flex flex-col justify-center">
                                <div class="absolute top-8 right-10 text-[120px] leading-none font-serif text-gray-100 select-none pointer-events-none">"</div>
                                <p class="text-sm sm:text-lg md:text-xl lg:text-2xl font-medium leading-relaxed text-gray-800 mb-10 relative z-10 italic max-w-[800px]">"${t.quote}"</p>
                                <div class="flex items-center gap-4 relative z-10 shrink-0">
                                    ${
                                        t.image
                                            ? `<img src="/casestudy/${t.image}" alt="${t.author}" class="w-14 h-14 rounded-full object-cover">`
                                            : `<div class="w-14 h-14 rounded-full bg-gray-200 flex items-center justify-center text-gray-600 font-bold text-lg shrink-0">${t.letter}</div>`
                                    }
                                    <div>
                                        <p class="font-bold text-base text-brand-dark">${t.author}</p>
                                        <p class="text-sm text-gray-500">${t.title}</p>
                                    </div>
                                </div>
                            </div>
                        </div>
            `,
                )
                .join("");

            dotsContainer.innerHTML = data
                .map(
                    (_, i) => `
                <button class="testimonial-dot w-2.5 h-2.5 rounded-full ${i === 0 ? "bg-black" : "bg-gray-300"} transition-all duration-300"
                    data-index="${i}" aria-label="Go to slide ${i + 1}"></button>
            `,
                )
                .join("");

            initCarousel();
        }

        function initCarousel() {
            const testimonialSlides =
                document.querySelectorAll(".testimonial-slide");
            const dots = document.querySelectorAll(".testimonial-dot");

            function goToSlide(index) {
                if (index < 0) index = totalSlides - 1;
                if (index >= totalSlides) index = 0;
                currentSlide = index;
                testimonialTrack.style.transform = `translateX(-${currentSlide * 100}%)`;
                dots.forEach((dot, i) => {
                    dot.classList.toggle("bg-black", i === currentSlide);
                    dot.classList.toggle("bg-gray-300", i !== currentSlide);
                });
            }

            function startAutoplay() {
                autoplayInterval = setInterval(
                    () => goToSlide(currentSlide + 1),
                    5000,
                );
            }

            function stopAutoplay() {
                clearInterval(autoplayInterval);
            }

            prevBtn.addEventListener("click", () => {
                stopAutoplay();
                goToSlide(currentSlide - 1);
                startAutoplay();
            });

            nextBtn.addEventListener("click", () => {
                stopAutoplay();
                goToSlide(currentSlide + 1);
                startAutoplay();
            });

            dots.forEach((dot) => {
                dot.addEventListener("click", () => {
                    stopAutoplay();
                    goToSlide(parseInt(dot.dataset.index));
                    startAutoplay();
                });
            });

            const carouselEl = document.querySelector(".testimonial-carousel");
            let dragStartX = 0;
            let dragDeltaX = 0;
            let isDragging = false;

            function setTransition(v) {
                testimonialTrack.style.transition = v
                    ? "transform 0.5s ease"
                    : "none";
            }

            function onDragStart(e) {
                if (e.type === "mousedown" && e.button !== 0) return;
                isDragging = true;
                dragStartX = e.type.includes("mouse")
                    ? e.clientX
                    : e.touches[0].clientX;
                dragDeltaX = 0;
                setTransition(false);
                stopAutoplay();
            }

            function onDragMove(e) {
                if (!isDragging) return;
                const x = e.type.includes("mouse")
                    ? e.clientX
                    : e.touches[0].clientX;
                dragDeltaX = x - dragStartX;
                const offset =
                    -(currentSlide * 100) +
                    (dragDeltaX / carouselEl.offsetWidth) * 100;
                testimonialTrack.style.transform = `translateX(${offset}%)`;
            }

            function onDragEnd() {
                if (!isDragging) return;
                isDragging = false;
                setTransition(true);
                if (dragDeltaX < -50) {
                    goToSlide(currentSlide + 1);
                } else if (dragDeltaX > 50) {
                    goToSlide(currentSlide - 1);
                } else {
                    goToSlide(currentSlide);
                }
                startAutoplay();
            }

            carouselEl.addEventListener("touchstart", onDragStart, {
                passive: true,
            });
            carouselEl.addEventListener("touchmove", onDragMove, {
                passive: true,
            });
            carouselEl.addEventListener("touchend", onDragEnd);
            carouselEl.addEventListener("mousedown", onDragStart);
            carouselEl.addEventListener("mousemove", onDragMove);
            carouselEl.addEventListener("mouseup", onDragEnd);
            carouselEl.addEventListener("mouseleave", onDragEnd);

            startAutoplay();
        }

        fetch("../data/testimonials.json")
            .then((res) => res.json())
            .then(renderTestimonials)
            .catch((err) => console.error("Failed to load testimonials:", err));
    </script>

