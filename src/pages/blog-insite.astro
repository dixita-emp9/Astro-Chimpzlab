        <div
            id="toast-notification"
            class="fixed bottom-8 left-1/2 -translate-x-1/2 z-50 w-max px-6 py-3 rounded-full bg-black text-white text-sm font-medium shadow-2xl transition-all duration-400 opacity-0 translate-y-4 pointer-events-none"
        >
        </div>

        <!-- Speech Synthesis Logic -->
        <script is:inline>
            document.addEventListener("DOMContentLoaded", () => {
                let synth = window.speechSynthesis;
                let utterances = [];
                let currentUtteranceIndex = -1;
                let isPlaying = false;
                let stickyHidden = false;
                let blocks = [];
                let currentSpeed = 1;
                let baseOffset = 0;
                let resumeOffset = 0;

                // Sticky Audio Player (separate element, shown after 600px scroll)
                const stickyPlayer = document.getElementById(
                    "sticky-audio-player-container",
                );

                function showStickyPlayer() {
                    stickyHidden = false;
                    if (stickyPlayer && window.scrollY > 450) {
                        stickyPlayer.classList.remove(
                            "opacity-0",
                            "invisible",
                            "translate-y-4",
                            "pointer-events-none",
                        );
                    }
                }

                function hideStickyPlayer() {
                    if (!stickyPlayer) return;
                    stickyPlayer.classList.add(
                        "opacity-0",
                        "invisible",
                        "translate-y-4",
                        "pointer-events-none",
                    );
                }

                if (stickyPlayer) {
                    window.addEventListener("scroll", () => {
                        if (window.scrollY > 450) {
                            if (!stickyHidden) showStickyPlayer();
                        } else if (window.scrollY < 500) {
                            hideStickyPlayer();
                            stickyHidden = false;
                        }
                    });
                }

                function updateIcon() {
                    document
                        .querySelectorAll(".play-pause-btn")
                        .forEach((btn) => {
                            const iconPlay = btn.querySelector(".icon-play");
                            const iconPause = btn.querySelector(".icon-pause");
                            if (isPlaying) {
                                if (iconPlay) iconPlay.classList.add("hidden");
                                if (iconPause)
                                    iconPause.classList.remove("hidden");
                            } else {
                                if (iconPlay)
                                    iconPlay.classList.remove("hidden");
                                if (iconPause)
                                    iconPause.classList.add("hidden");
                            }
                        });
                    document
                        .querySelectorAll(".close-audio-btn")
                        .forEach((btn) => {
                            if (isPlaying) btn.classList.remove("hidden");
                            else btn.classList.add("hidden");
                        });
                }

                function clearHighlight() {
                    blocks.forEach((b) => {
                        b.style.backgroundColor = "";
                        if (b.dataset.originalText) {
                            b.innerHTML = b.dataset.originalText;
                        }
                    });
                }

                function playNextUtterance() {
                    currentUtteranceIndex++;
                    if (currentUtteranceIndex < utterances.length) {
                        const u = utterances[currentUtteranceIndex];
                        u.text =
                            blocks[currentUtteranceIndex].dataset.originalText;
                        baseOffset = 0;
                        resumeOffset = 0;
                        u.rate = currentSpeed;
                        synth.speak(u);
                    } else {
                        isPlaying = false;
                        currentUtteranceIndex = -1;
                        resumeOffset = 0;
                        updateIcon();
                    }
                }

                function speakFromOffset(index, offset) {
                    if (index < 0 || index >= utterances.length) return;
                    const u = utterances[index];
                    const fullText = blocks[index].dataset.originalText;
                    const remaining = fullText.substring(offset);
                    if (!remaining.trim()) {
                        playNextUtterance();
                        return;
                    }
                    baseOffset = offset;
                    resumeOffset = offset;
                    u.text = remaining;
                    u.rate = currentSpeed;
                    synth.speak(u);
                }

                function initSpeechIfNeeded() {
                    if (utterances.length > 0) return true;

                    blocks = Array.from(
                        document.querySelectorAll(
                            "h1, .article-content > p, .article-content > h2, .article-content > h3, .article-content > blockquote",
                        ),
                    );
                    if (blocks.length === 0) return false;

                    blocks.forEach((block) => {
                        const text = block.innerText.trim();
                        if (!text) return;

                        block.dataset.originalText = text;

                        const u = new SpeechSynthesisUtterance(text);
                        u.onstart = () => {
                            clearHighlight();
                            block.style.backgroundColor =
                                "rgba(255, 235, 59, 0.3)"; // Highlight yellow
                            block.scrollIntoView({
                                behavior: "smooth",
                                block: "center",
                            }); // Auto-scroll
                        };
                        u.onboundary = (e) => {
                            if (e.name === "word") {
                                const charIndex = baseOffset + e.charIndex;
                                let end = charIndex + (e.charLength || 0);
                                if (end === charIndex) {
                                    while (
                                        end < text.length &&
                                        /\\S/.test(text[end])
                                    )
                                        end++;
                                }
                                if (charIndex >= text.length) return;
                                resumeOffset = charIndex;
                                const before = text.substring(0, charIndex);
                                const currentWord = text.substring(
                                    charIndex,
                                    end,
                                );
                                const after = text.substring(end);
                                block.innerHTML = `${before}<span style="background-color:rgba(0,0,0,0.8); color:white; border-radius:4px; padding:0 2px; transition: background-color 0.1s ease;">${currentWord}</span>${after}`;
                            }
                        };
                        u.onend = () => {
                            clearHighlight();
                            if (isPlaying) {
                                playNextUtterance();
                            }
                        };
                        u.onerror = (err) => {
                            if (err && err.error === "interrupted") return;
                            clearHighlight();
                            isPlaying = false;
                            updateIcon();
                        };
                        utterances.push(u);
                    });
                    return utterances.length > 0;
                }

                window.setSpeed = function (value, e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (e && e.preventDefault) e.preventDefault();

                    currentSpeed = parseFloat(value) || 1;

                    const speedText = currentSpeed + "x";
                    const category =
                        currentSpeed <= 0.75
                            ? "Slow"
                            : currentSpeed <= 1
                              ? "Normal"
                              : "Fast";
                    document.querySelectorAll(".speed-label").forEach((el) => {
                        el.textContent = speedText;
                        el.title = category;
                    });
                    document.querySelectorAll(".speed-range").forEach((el) => {
                        el.value = currentSpeed;
                        el.title = category;
                    });
                };

                window.applySpeed = function (e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (e && e.preventDefault) e.preventDefault();
                    if (isPlaying && currentUtteranceIndex >= 0) {
                        synth.cancel();
                        speakFromOffset(currentUtteranceIndex, resumeOffset);
                    }
                };

                window.toggleAudio = function (e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (e && e.preventDefault) e.preventDefault();

                    if (!initSpeechIfNeeded()) {
                        if (typeof showToast === "function")
                            showToast(
                                "No content available to read.",
                                "warning",
                            );
                        return;
                    }

                    // If already playing or paused and we have active utterances, just toggle state
                    if (
                        currentUtteranceIndex >= 0 &&
                        currentUtteranceIndex < utterances.length
                    ) {
                        if (isPlaying) {
                            if (synth.speaking && !synth.paused) synth.pause();
                            isPlaying = false;
                        } else {
                            if (synth.paused) synth.resume();
                            if (!synth.speaking) {
                                const u = utterances[currentUtteranceIndex];
                                u.text =
                                    blocks[
                                        currentUtteranceIndex
                                    ].dataset.originalText;
                                baseOffset = 0;
                                resumeOffset = 0;
                                u.rate = currentSpeed;
                                synth.speak(u);
                            }
                            isPlaying = true;
                        }
                        updateIcon();
                        return;
                    }

                    // Start fresh
                    synth.cancel();
                    clearHighlight();
                    currentUtteranceIndex = -1;
                    isPlaying = true;
                    showStickyPlayer();
                    updateIcon();
                    playNextUtterance();
                };

                window.skipAudio = function (direction, e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (e && e.preventDefault) e.preventDefault();

                    if (!initSpeechIfNeeded()) return;

                    let targetIndex = currentUtteranceIndex + direction;
                    if (targetIndex < 0) targetIndex = 0;
                    if (targetIndex >= utterances.length)
                        targetIndex = utterances.length - 1;

                    synth.cancel();
                    clearHighlight();
                    currentUtteranceIndex = targetIndex - 1;
                    isPlaying = true;
                    showStickyPlayer();
                    updateIcon();
                    playNextUtterance();
                };

                window.closeAudio = function (e) {
                    if (e && e.stopPropagation) e.stopPropagation();
                    if (e && e.preventDefault) e.preventDefault();
                    synth.cancel();
                    clearHighlight();
                    isPlaying = false;
                    currentUtteranceIndex = -1;
                    updateIcon();
                    const btn = e && e.currentTarget;
                    if (btn && stickyPlayer && stickyPlayer.contains(btn)) {
                        stickyHidden = true;
                        hideStickyPlayer();
                    }
                };

                // Initialize class on blocks when content changes (simulate mutation observer or simple timeout for now)
                setTimeout(() => {
                    initSpeechIfNeeded();
                }, 1500);

                // Cancel speech on page unload
                window.addEventListener("beforeunload", () => {
                    synth.cancel();
                    clearHighlight();
                });
            });
        </script>
    </Fragment>
</BaseLayout>
