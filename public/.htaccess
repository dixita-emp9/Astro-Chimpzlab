# Generated by scripts/convert.mjs — old .html URLs -> clean URLs
<IfModule mod_rewrite.c>
  RewriteEngine On
  # Pretty blog URLs: /blog-insite/<slug> -> the client-rendered blog page.
  RewriteRule ^blog-insite/([^/]+)/?$ /blog-insite/ [L]
  RewriteRule ^about\.html/?$ /about [R=301,L]
  RewriteRule ^blog-insite\.html/?$ /blog-insite [R=301,L]
