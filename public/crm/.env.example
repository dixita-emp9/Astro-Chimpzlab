# MicroCRM configuration
# Copy this file to .env and fill in your values. .env is NOT committed to git.
# On a live server, .env holds the SMTP + DB config that keeps your live data safe.

APP_KEY=change-me-32-hex-chars

# SQLite database path.
#
# IMPORTANT (manual uploads): keep the live database OUTSIDE the web root so that
# uploading the project never overwrites it. Use an absolute path, e.g.:
#   DB_PATH=/home/USERNAME/private/chimpzlab/database.sqlite
# (create that folder, move the current live database.sqlite into it once, then set
#  this path in the LIVE .env). Never upload crm-1/.env or crm-1/storage/.
#
# Local dev can keep the default inside the project:
DB_PATH=storage/database.sqlite

RATE_LIMIT_MAX=5
RATE_LIMIT_WINDOW=600
RATE_LIMIT_DAILY_MAX=20
CHECK_EMAIL_DNS=1
MIN_SUBMIT_SECONDS=3
MAX_TOKEN_AGE_SECONDS=3600
BLOCKED_COUNTRIES=
TRUST_PROXY=0

# Admin login brute-force protection (per IP).
ADMIN_LOGIN_MAX_ATTEMPTS=10
ADMIN_LOGIN_WINDOW=900

# Google reCAPTCHA — SERVER-SIDE secret keys.
#
# RECAPTCHA_SECRET_KEY is read by the standalone PHP endpoints
# (/lead-capture.php, /real-estate-lead.php) on every non-localhost host.
# NEVER hardcode this in Astro source or in web-served PHP code.
#
# RECAPTCHA_SECRET_KEY_TEST is Google's always-pass test secret, used
# automatically on localhost for local development.
RECAPTCHA_SECRET_KEY=
RECAPTCHA_SECRET_KEY_TEST=6LeIxAcTAAAAAGG-vFI1TnRWxMZNFuojJ4WifJWe

SMTP_HOST=smtp.zoho.in
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USERNAME=your-smtp-username
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=hello@chimpzlab.com
SMTP_FROM_NAME=ChimpzLab
SMTP_TO=hello@chimpzlab.com
